<ab n="Zeph 1:4"><w>וְנָטִ֤יתִי</w><w>יָדִי֙</w><w>עַל</w><w>יְהוּדָ֔ה</w><w>וְעַ֖ל</w><w>כׇּל</w><w>יוֹשְׁבֵ֣י</w><w>יְרוּשָׁלָ֑͏ִם</w><w>וְהִכְרַתִּ֞י</w><w>מִן</w><w>הַמָּק֤וֹם</w><w>הַזֶּה֙</w><w>אֶת</w><w>שְׁאָ֣ר</w><w>הַבַּ֔עַל</w><w>אֶת</w><w>שֵׁ֥ם</w><w>הַכְּמָרִ֖ים</w><w>עִם</w><w>הַכֹּהֲנִֽים</w></ab>
<ab n="Zeph 1:5"><w>וְאֶת</w><w>הַמִּשְׁתַּחֲוִ֥ים</w><w>עַל</w><w>הַגַּגּ֖וֹת</w><w>לִצְבָ֣א</w><w>הַשָּׁמָ֑יִם</w><w>וְאֶת</w><w>הַמִּֽשְׁתַּחֲוִים֙</w><w>הַנִּשְׁבָּעִ֣ים</w><w>לַֽיהֹוָ֔ה</w><w>וְהַנִּשְׁבָּעִ֖ים</w><w>בְּמַלְכָּֽם</w></ab>
<ab n="Zeph 1:6"><w>וְאֶת</w><w>הַנְּסוֹגִ֖ים</w><w>מֵאַחֲרֵ֣י</w><w>יְהֹוָ֑ה</w><w>וַאֲשֶׁ֛ר</w><w>לֹא</w><w>בִקְשׁ֥וּ</w><w>אֶת</w><w>יְהֹוָ֖ה</w><w>וְלֹ֥א</w><w>דְרָשֻֽׁהוּ</w></ab>
