<ab n="Zeph 1:17"><w>וַהֲצֵרֹ֣תִי</w><w>לָאָדָ֗ם</w><w>וְהָֽלְכוּ֙</w><w>כַּֽעִוְרִ֔ים</w><w>כִּ֥י</w><w>לַֽיהֹוָ֖ה</w><w>חָטָ֑אוּ</w><w>וְשֻׁפַּ֤ךְ</w><w>דָּמָם֙</w><w>כֶּעָפָ֔ר</w><w>וּלְחֻמָ֖ם</w><w>כַּגְּלָלִֽים</w></ab>
<ab n="Zeph 1:18"><w>גַּם</w><w>כַּסְפָּ֨ם</w><w>גַּם</w><w>זְהָבָ֜ם</w><w>לֹא</w><w>יוּכַ֣ל</w><w>לְהַצִּילָ֗ם</w><w>בְּיוֹם֙</w><w>עֶבְרַ֣ת</w><w>יְהֹוָ֔ה</w><w>וּבְאֵשׁ֙</w><w>קִנְאָת֔וֹ</w><w>תֵּאָכֵ֖ל</w><w>כׇּל</w><w>הָאָ֑רֶץ</w><w>כִּֽי</w><w>כָלָ֤ה</w><w>אַךְ</w><w>נִבְהָלָה֙</w><w>יַעֲשֶׂ֔ה</w><w>אֵ֥ת</w><w>כׇּל</w><w>יֹשְׁבֵ֖י</w><w>הָאָֽרֶץ</w></ab>
<ab n="Zeph 2:1"><w>הִֽתְקוֹשְׁﬞשׁ֖וּ</w><w>וָק֑וֹשּׁוּ</w><w>הַגּ֖וֹי</w><w>לֹ֥א</w><w>נִכְסָֽף</w></ab>
<ab n="Zeph 2:2"><w>בְּטֶ֙רֶם֙</w><w>לֶ֣דֶת</w><w>חֹ֔ק</w><w>כְּמֹ֖ץ</w><w>עָ֣בַר</w><w>י֑וֹם</w><w>בְּטֶ֣רֶם</w><w>לֹא</w><w>יָב֣וֹא</w><w>עֲלֵיכֶ֗ם</w><w>חֲרוֹן֙</w><w>אַף</w><w>יְהֹוָ֔ה</w><w>בְּטֶ֙רֶם֙</w><w>לֹא</w><w>יָב֣וֹא</w><w>עֲלֵיכֶ֔ם</w><w>י֖וֹם</w><w>אַף</w><w>יְהֹוָֽה</w></ab>
<ab n="Zeph 2:3"><w>בַּקְּשׁ֤וּ</w><w>אֶת</w><w>יְהֹוָה֙</w><w>כׇּל</w><w>עַנְוֵ֣י</w><w>הָאָ֔רֶץ</w><w>אֲשֶׁ֥ר</w><w>מִשְׁפָּט֖וֹ</w><w>פָּעָ֑לוּ</w><w>בַּקְּשׁוּ</w><w>צֶ֙דֶק֙</w><w>בַּקְּשׁ֣וּ</w><w>עֲנָוָ֔ה</w><w>אוּלַי֙</w><w>תִּסָּ֣תְר֔וּ</w><w>בְּי֖וֹם</w><w>אַף</w><w>יְהֹוָֽה</w></ab>
<ab n="Zeph 2:4"><w>כִּ֤י</w><w>עַזָּה֙</w><w>עֲזוּבָ֣ה</w><w>תִֽהְיֶ֔ה</w><w>וְאַשְׁקְל֖וֹן</w><w>לִשְׁמָמָ֑ה</w><w>אַשְׁדּ֗וֹד</w><w>בַּֽצׇּהֳרַ֙יִם֙</w><w>יְגָ֣רְשׁ֔וּהָ</w><w>וְעֶקְר֖וֹן</w><w>תֵּעָקֵֽר</w></ab>
<ab n="Zeph 2:5"><w>ה֗וֹי</w><w>יֹ֥שְׁבֵ֛י</w><w>חֶ֥בֶל</w><w>הַיָּ֖ם</w><w>גּ֣וֹי</w><w>כְּרֵתִ֑ים</w><w>דְּבַר</w><w>יְהֹוָ֣ה</w><w>עֲלֵיכֶ֗ם</w><w>כְּנַ֙עַן֙</w><w>אֶ֣רֶץ</w><w>פְּלִשְׁתִּ֔ים</w><w>וְהַאֲבַדְתִּ֖יךְ</w><w>מֵאֵ֥ין</w><w>יוֹשֵֽׁב</w></ab>
<ab n="Zeph 2:6"><w>וְֽהָיְתָ֞ה</w><w>חֶ֣בֶל</w><w>הַיָּ֗ם</w><w>נְוֺ֛ת</w><w>כְּרֹ֥ת</w><w>רֹעִ֖ים</w><w>וְגִדְר֥וֹת</w><w>צֹֽאן</w></ab>
<ab n="Zeph 2:7"><w>וְהָ֣יָה</w><w>חֶ֗בֶל</w><w>לִשְׁאֵרִ֛ית</w><w>בֵּ֥ית</w><w>יְהוּדָ֖ה</w><w>עֲלֵיהֶ֣ם</w><w>יִרְע֑וּן</w><w>בְּבָתֵּ֣י</w><w>אַשְׁקְל֗וֹן</w><w>בָּעֶ֙רֶב֙</w><w>יִרְבָּצ֔וּן</w><w>כִּ֧י</w><w>יִפְקְדֵ֛ם</w><w>יְהֹוָ֥ה</w><w>אֱלֹהֵיהֶ֖ם</w><w>וְשָׁ֥ב</w><w>שבותם</w></ab>
<ab n="Zeph 2:8"><w>שָׁמַ֙עְתִּי֙</w><w>חֶרְפַּ֣ת</w><w>מוֹאָ֔ב</w><w>וְגִדֻּפֵ֖י</w><w>בְּנֵ֣י</w><w>עַמּ֑וֹן</w><w>אֲשֶׁ֤ר</w><w>חֵֽרְפוּ֙</w><w>אֶת</w><w>עַמִּ֔י</w><w>וַיַּגְדִּ֖ילוּ</w><w>עַל</w><w>גְּבוּלָֽם</w></ab>
