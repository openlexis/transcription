<ab n="Mal 1:1"><w>מַשָּׂ֥א</w><w>דְבַר</w><w>יְהֹוָ֖ה</w><w>אֶל</w><w>יִשְׂרָאֵ֑ל</w><w>בְּיַ֖ד</w><w>מַלְאָכִֽי</w></ab>
<ab n="Mal 1:2"><w>אָהַ֤בְתִּי</w><w>אֶתְכֶם֙</w><w>אָמַ֣ר</w><w>יְהֹוָ֔ה</w><w>וַאֲמַרְתֶּ֖ם</w><w>בַּמָּ֣ה</w><w>אֲהַבְתָּ֑נוּ</w><w>הֲלוֹא</w><w>אָ֨ח</w><w>עֵשָׂ֤ו</w><w>לְיַֽעֲקֹב֙</w><w>נְאֻם</w><w>יְהֹוָ֔ה</w><w>וָאֹהַ֖ב</w><w>אֶֽת</w><w>יַעֲקֹֽב</w></ab>
<ab n="Mal 1:3"><w>וְאֶת</w><w>עֵשָׂ֖ו</w><w>שָׂנֵ֑אתִי</w><w>וָאָשִׂ֤ים</w><w>אֶת</w><w>הָרָיו֙</w><w>שְׁמָמָ֔ה</w><w>וְאֶת</w><w>נַחֲלָת֖וֹ</w><w>לְתַנּ֥וֹת</w><w>מִדְבָּֽר</w></ab>
<ab n="Mal 1:4"><w>כִּי</w><w>תֹאמַ֨ר</w><w>אֱד֜וֹם</w><w>רֻשַּׁ֗שְׁנוּ</w><w>וְנָשׁוּב֙</w><w>וְנִבְנֶ֣ה</w><w>חֳרָב֔וֹת</w><w>כֹּ֤ה</w><w>אָמַר֙</w><w>יְהֹוָ֣ה</w><w>צְבָא֔וֹת</w><w>הֵ֥מָּה</w><w>יִבְנ֖וּ</w><w>וַאֲנִ֣י</w><w>אֶהֱר֑וֹס</w><w>וְקָרְא֤וּ</w><w>לָהֶם֙</w><w>גְּב֣וּל</w><w>רִשְׁעָ֔ה</w><w>וְהָעָ֛ם</w><w>אֲשֶׁר</w><w>זָעַ֥ם</w><w>יְהֹוָ֖ה</w><w>עַד</w><w>עוֹלָֽם</w></ab>
<ab n="Mal 1:5"><w>וְעֵינֵיכֶ֖ם</w><w>תִּרְאֶ֑ינָה</w><w>וְאַתֶּ֤ם</w><w>תֹּֽאמְרוּ֙</w><w>יִגְדַּ֣ל</w><w>יְהֹוָ֔ה</w><w>מֵעַ֖ל</w><w>לִגְב֥וּל</w><w>יִשְׂרָאֵֽל</w></ab>
<ab n="Mal 1:6"><w>בֵּ֛ן</w><w>יְכַבֵּ֥ד</w><w>אָ֖ב</w><w>וְעֶ֣בֶד</w><w>אֲדֹנָ֑יו</w><w>וְאִם</w><w>אָ֣ב</w><w>אָ֣נִי</w><w>אַיֵּ֣ה</w><w>כְבוֹדִ֡י</w><w>וְאִם</w><w>אֲדוֹנִ֣ים</w><w>אָ֩נִי֩</w><w>אַיֵּ֨ה</w><w>מוֹרָאִ֜י</w><w>אָמַ֣ר</w><w>יְהֹוָ֣ה</w><w>צְבָא֗וֹת</w><w>לָכֶם֙</w><w>הַכֹּֽהֲנִים֙</w><w>בּוֹזֵ֣י</w><w>שְׁמִ֔י</w><w>וַאֲמַרְתֶּ֕ם</w><w>בַּמֶּ֥ה</w><w>בָזִ֖ינוּ</w><w>אֶת</w><w>שְׁמֶֽךָ</w></ab>
<ab n="Mal 1:7"><w>מַגִּישִׁ֤ים</w><w>עַֽל</w><w>מִזְבְּחִי֙</w><w>לֶ֣חֶם</w><w>מְגֹאָ֔ל</w><w>וַאֲמַרְתֶּ֖ם</w><w>בַּמֶּ֣ה</w><w>גֵאַלְנ֑וּךָ</w><w>בֶּאֱמׇרְכֶ֕ם</w><w>שֻׁלְחַ֥ן</w><w>יְהֹוָ֖ה</w><w>נִבְזֶ֥ה</w><w>הֽוּא</w></ab>
<ab n="Mal 1:8"><w>וְכִי</w><w>תַגִּישׁ֨וּן</w><w>עִוֵּ֤ר</w><w>לִזְבֹּ֙חַ֙</w><w>אֵ֣ין</w><w>רָ֔ע</w><w>וְכִ֥י</w><w>תַגִּ֛ישׁוּ</w><w>פִּסֵּ֥חַ</w><w>וְחֹלֶ֖ה</w><w>אֵ֣ין</w><w>רָ֑ע</w><w>הַקְרִיבֵ֨הוּ</w><w>נָ֜א</w><w>לְפֶחָתֶ֗ךָ</w><w>הֲיִרְצְךָ֙</w><w>א֚וֹ</w><w>הֲיִשָּׂ֣א</w><w>פָנֶ֔יךָ</w><w>אָמַ֖ר</w><w>יְהֹוָ֥ה</w><w>צְבָאֽוֹת</w></ab>
<ab n="Mal 1:9"><w>וְעַתָּ֛ה</w><w>חַלּוּ</w><w>נָ֥א</w><w>פְנֵי</w><w>אֵ֖ל</w><w>וִֽיחׇנֵּ֑נוּ</w><w>מִיֶּדְכֶם֙</w><w>הָ֣יְתָה</w><w>זֹּ֔את</w><w>הֲיִשָּׂ֤א</w><w>מִכֶּם֙</w><w>פָּנִ֔ים</w><w>אָמַ֖ר</w><w>יְהֹוָ֥ה</w><w>צְבָאֽוֹת</w></ab>
<ab n="Mal 1:10"><w>מִ֤י</w><w>גַם</w><w>בָּכֶם֙</w><w>וְיִסְגֹּ֣ר</w><w>דְּלָתַ֔יִם</w><w>וְלֹא</w><w>תָאִ֥ירוּ</w><w>מִזְבְּחִ֖י</w><w>חִנָּ֑ם</w><w>אֵֽין</w><w>לִ֨י</w><w>חֵ֜פֶץ</w><w>בָּכֶ֗ם</w><w>אָמַר֙</w><w>יְהֹוָ֣ה</w><w>צְבָא֔וֹת</w><w>וּמִנְחָ֖ה</w><w>לֹא</w><w>אֶרְצֶ֥ה</w><w>מִיֶּדְכֶֽם</w></ab>
<ab n="Mal 1:11"><w>כִּ֣י</w><w>מִמִּזְרַח</w><w>שֶׁ֜מֶשׁ</w><w>וְעַד</w><w>מְבוֹא֗וֹ</w><w>גָּד֤וֹל</w><w>שְׁמִי֙</w><w>בַּגּוֹיִ֔ם</w><w>וּבְכׇל</w><w>מָק֗וֹם</w><w>מֻקְטָ֥ר</w><w>מֻגָּ֛שׁ</w><w>לִשְׁמִ֖י</w><w>וּמִנְחָ֣ה</w><w>טְהוֹרָ֑ה</w><w>כִּֽי</w><w>גָד֤וֹל</w><w>שְׁמִי֙</w><w>בַּגּוֹיִ֔ם</w><w>אָמַ֖ר</w><w>יְהֹוָ֥ה</w><w>צְבָאֽוֹת</w></ab>
<pb n="204:a"/>
<ab n="Mal 1:12"><w>וְאַתֶּ֖ם</w><w>מְחַלְּלִ֣ים</w><w>אוֹת֑וֹ</w><w>בֶּאֱמׇרְכֶ֗ם</w><w>שֻׁלְחַ֤ן</w><w>אֲדֹנָי֙</w><w>מְגֹאָ֣ל</w><w>ה֔וּא</w><w>וְנִיב֖וֹ</w><w>נִבְזֶ֥ה</w><w>אׇכְלֽוֹ</w></ab>
<ab n="Mal 1:13"><w>וַאֲמַרְתֶּם֩</w><w>הִנֵּ֨ה</w><w>מַתְּלָאָ֜ה</w><w>וְהִפַּחְתֶּ֣ם</w><w>אוֹת֗וֹ</w><w>אָמַר֙</w><w>יְהֹוָ֣ה</w><w>צְבָא֔וֹת</w><w>וַהֲבֵאתֶ֣ם</w><w>גָּז֗וּל</w><w>וְאֶת</w><w>הַפִּסֵּ֙חַ֙</w><w>וְאֶת</w><w>הַ֣חוֹלֶ֔ה</w><w>וַהֲבֵאתֶ֖ם</w><w>אֶת</w><w>הַמִּנְחָ֑ה</w><w>הַאֶרְצֶ֥ה</w><w>אוֹתָ֛הּ</w><w>מִיֶּדְכֶ֖ם</w><w>אָמַ֥ר</w><w>יְהֹוָֽה</w></ab>
<ab n="Mal 1:14"><w>וְאָר֣וּר</w><w>נוֹכֵ֗ל</w><w>וְיֵ֤שׁ</w><w>בְּעֶדְרוֹ֙</w><w>זָכָ֔ר</w><w>וְנֹדֵ֛ר</w><w>וְזֹבֵ֥חַ</w><w>מׇשְׁחָ֖ת</w><w>לַאדֹנָ֑י</w><w>כִּי֩</w><w>מֶ֨לֶךְ</w><w>גָּד֜וֹל</w><w>אָ֗נִי</w><w>אָמַר֙</w><w>יְהֹוָ֣ה</w><w>צְבָא֔וֹת</w><w>וּשְׁמִ֖י</w><w>נוֹרָ֥א</w><w>בַגּוֹיִֽם</w></ab>
<ab n="Mal 2:1"><w>וְעַתָּ֗ה</w><w>אֲלֵיכֶ֛ם</w><w>הַמִּצְוָ֥ה</w><w>הַזֹּ֖את</w><w>הַכֹּהֲנִֽים</w></ab>
<ab n="Mal 2:2"><w>אִם</w><w>לֹ֣א</w><w>תִשְׁמְע֡וּ</w><w>וְאִם</w><w>לֹא֩</w><w>תָשִׂ֨ימוּ</w><w>עַל</w><w>לֵ֜ב</w><w>לָתֵ֧ת</w><w>כָּב֣וֹד</w><w>לִשְׁמִ֗י</w><w>אָמַר֙</w><w>יְהֹוָ֣ה</w><w>צְבָא֔וֹת</w><w>וְשִׁלַּחְתִּ֤י</w><w>בָכֶם֙</w><w>אֶת</w><w>הַמְּאֵרָ֔ה</w><w>וְאָרוֹתִ֖י</w><w>אֶת</w><w>בִּרְכוֹתֵיכֶ֑ם</w><w>וְגַם֙</w><w>אָרוֹתִ֔יהָ</w><w>כִּ֥י</w><w>אֵינְכֶ֖ם</w><w>שָׂמִ֥ים</w><w>עַל</w><w>לֵֽב</w></ab>
<ab n="Mal 2:3"><w>הִנְנִ֨י</w><w>גֹעֵ֤ר</w><w>לָכֶם֙</w><w>אֶת</w><w>הַזֶּ֔רַע</w><w>וְזֵרִ֤יתִֽי</w><w>פֶ֙רֶשׁ֙</w><w>עַל</w><w>פְּנֵיכֶ֔ם</w><w>פֶּ֖רֶשׁ</w><w>חַגֵּיכֶ֑ם</w><w>וְנָשָׂ֥א</w><w>אֶתְכֶ֖ם</w><w>אֵלָֽיו</w></ab>
<ab n="Mal 2:4"><w>וִידַעְתֶּ֕ם</w><w>כִּ֚י</w><w>שִׁלַּ֣חְתִּי</w><w>אֲלֵיכֶ֔ם</w><w>אֵ֖ת</w><w>הַמִּצְוָ֣ה</w><w>הַזֹּ֑את</w><w>לִהְי֤וֹת</w><w>בְּרִיתִי֙</w><w>אֶת</w><w>לֵוִ֔י</w><w>אָמַ֖ר</w><w>יְהֹוָ֥ה</w><w>צְבָאֽוֹת</w></ab>
<ab n="Mal 2:5"><w>בְּרִיתִ֣י</w><w>הָיְתָ֣ה</w><w>אִתּ֗וֹ</w><w>הַֽחַיִּים֙</w><w>וְהַשָּׁל֔וֹם</w><w>וָאֶתְּנֵֽם</w><w>ל֥וֹ</w><w>מוֹרָ֖א</w><w>וַיִּֽירָאֵ֑נִי</w><w>וּמִפְּנֵ֥י</w><w>שְׁמִ֖י</w><w>נִחַ֥ת</w><w>הֽוּא</w></ab>
<ab n="Mal 2:6"><w>תּוֹרַ֤ת</w><w>אֱמֶת֙</w><w>הָיְתָ֣ה</w><w>בְּפִ֔יהוּ</w><w>וְעַוְלָ֖ה</w><w>לֹא</w><w>נִמְצָ֣א</w><w>בִשְׂפָתָ֑יו</w><w>בְּשָׁל֤וֹם</w><w>וּבְמִישׁוֹר֙</w><w>הָלַ֣ךְ</w><w>אִתִּ֔י</w><w>וְרַבִּ֖ים</w><w>הֵשִׁ֥יב</w><w>מֵעָוֺֽן</w></ab>
<ab n="Mal 2:7"><w>כִּֽי</w><w>שִׂפְתֵ֤י</w><w>כֹהֵן֙</w><w>יִשְׁמְרוּ</w><w>דַ֔עַת</w><w>וְתוֹרָ֖ה</w><w>יְבַקְשׁ֣וּ</w><w>מִפִּ֑יהוּ</w><w>כִּ֛י</w><w>מַלְאַ֥ךְ</w><w>יְהֹוָֽה</w><w>צְבָא֖וֹת</w><w>הֽוּא</w></ab>
<ab n="Mal 2:8"><w>וְאַתֶּם֙</w><w>סַרְתֶּ֣ם</w><w>מִן</w><w>הַדֶּ֔רֶךְ</w><w>הִכְשַׁלְתֶּ֥ם</w><w>רַבִּ֖ים</w><w>בַּתּוֹרָ֑ה</w><w>שִֽׁחַתֶּם֙</w><w>בְּרִ֣ית</w><w>הַלֵּוִ֔י</w><w>אָמַ֖ר</w><w>יְהֹוָ֥ה</w><w>צְבָאֽוֹת</w></ab>
<ab n="Mal 2:9"><w>וְגַם</w><w>אֲנִ֞י</w><w>נָתַ֧תִּי</w><w>אֶתְכֶ֛ם</w><w>נִבְזִ֥ים</w><w>וּשְׁפָלִ֖ים</w><w>לְכׇל</w><w>הָעָ֑ם</w><w>כְּפִ֗י</w><w>אֲשֶׁ֤ר</w><w>אֵֽינְכֶם֙</w><w>שֹׁמְרִ֣ים</w><w>אֶת</w><w>דְּרָכַ֔י</w><w>וְנֹשְׂאִ֥ים</w><w>פָּנִ֖ים</w><w>בַּתּוֹרָֽה</w></ab>
<ab n="Mal 2:10"><w>הֲל֨וֹא</w><w>אָ֤ב</w><w>אֶחָד֙</w><w>לְכֻלָּ֔נוּ</w><w>הֲל֛וֹא</w><w>אֵ֥ל</w><w>אֶחָ֖ד</w><w>בְּרָאָ֑נוּ</w><w>מַדּ֗וּעַ</w><w>נִבְגַּד֙</w><w>אִ֣ישׁ</w><w>בְּאָחִ֔יו</w><w>לְחַלֵּ֖ל</w><w>בְּרִ֥ית</w><w>אֲבֹתֵֽינוּ</w></ab>
