<ab n="Mal 3:21"><w>וְעַסּוֹתֶ֣ם</w><w>רְשָׁעִ֔ים</w><w>כִּֽי</w><w>יִהְי֣וּ</w><w>אֵ֔פֶר</w><w>תַּ֖חַת</w><w>כַּפּ֣וֹת</w><w>רַגְלֵיכֶ֑ם</w><w>בַּיּוֹם֙</w><w>אֲשֶׁ֣ר</w><w>אֲנִ֣י</w><w>עֹשֶׂ֔ה</w><w>אָמַ֖ר</w><w>יְהֹוָ֥ה</w><w>צְבָאֽוֹת</w></ab>
<ab n="Mal 3:22"><w>זִכְר֕וּ</w><w>תּוֹרַ֖ת</w><w>מֹשֶׁ֣ה</w><w>עַבְדִּ֑י</w><w>אֲשֶׁר֩</w><w>צִוִּ֨יתִי</w><w>אוֹת֤וֹ</w><w>בְחֹרֵב֙</w><w>עַל</w><w>כׇּל</w><w>יִשְׂרָאֵ֔ל</w><w>חֻקִּ֖ים</w><w>וּמִשְׁפָּטִֽים</w></ab>
<ab n="Mal 3:23"><w>הִנֵּ֤ה</w><w>אָנֹכִי֙</w><w>שֹׁלֵ֣חַ</w><w>לָכֶ֔ם</w><w>אֵ֖ת</w><w>אֵלִיָּ֣ה</w><w>הַנָּבִ֑יא</w><w>לִפְנֵ֗י</w><w>בּ֚וֹא</w><w>י֣וֹם</w><w>יְהֹוָ֔ה</w><w>הַגָּד֖וֹל</w><w>וְהַנּוֹרָֽא</w></ab>
<pb n="205:a"/>
<ab n="Mal 3:24"><w>וְהֵשִׁ֤יב</w><w>לֵב</w><w>אָבוֹת֙</w><w>עַל</w><w>בָּנִ֔ים</w><w>וְלֵ֥ב</w><w>בָּנִ֖ים</w><w>עַל</w><w>אֲבוֹתָ֑ם</w><w>פֶּן</w><w>אָב֕וֹא</w><w>וְהִכֵּיתִ֥י</w><w>אֶת</w><w>הָאָ֖רֶץ</w><w>חֵֽרֶם</w></ab>
