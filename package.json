{
  "name": "openlexis-transcription",
  "private": true,
  "type": "module",
  "scripts": {
    "sets": "bun scripts/sets.ts",
    "sources": "bun scripts/sources.ts",
    "spec:freeze": "bun scripts/freeze.ts",
    "spec:contract": "bun scripts/spec-contract.ts",
    "contract": "bun scripts/contract.ts",
    "import": "bun scripts/import.ts",
    "archive:coverage": "bun scripts/archive-coverage.ts",
    "archive:records": "bun scripts/records.ts",
    "compile": "bun --smol scripts/compile.ts",
    "check": "bun scripts/check.ts",
    "site": "cd site && bun run build",
    "site:install": "cd site && bun install",
    "site:dev": "cd site && bun run dev",
    "site:build": "cd site && bun run build",
    "site:preview": "cd site && bun run preview"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "xmllint-wasm": "^5.3.0"
  }
}
