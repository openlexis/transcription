---
import BylineItem from "./BylineItem.astro";
import type { IconName } from "../lib/icons";

export interface BylineItemData {
  icon: IconName;
  text: string;
  title?: string;
  href?: string;
}

interface Props {
  items: (BylineItemData | false | null | undefined | "")[];
}

const items = Astro.props.items.filter(Boolean) as BylineItemData[];
const hasSlot = Astro.slots.has("default");
---
{(items.length > 0 || hasSlot) && (
  <div class="byline">
    {items.map((it) => (
      <BylineItem icon={it.icon} text={it.text} title={it.title} href={it.href} />
    ))}
    <slot />
  </div>
)}
