---
import type { IconName } from "../lib/icons";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 12 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "author" && (
    <>
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </>
  )}
  {name === "date" && (
    <>
      <rect width="18" height="18" x="3" y="4" rx="2"></rect>
      <line x1="16" x2="16" y1="2" y2="6"></line>
      <line x1="8" x2="8" y1="2" y2="6"></line>
      <line x1="3" x2="21" y1="10" y2="10"></line>
    </>
  )}
  {name === "license" && (
    <>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <path d="M14 2v6h6"></path>
      <path d="m9 15 2 2 4-4"></path>
    </>
  )}
  {name === "manuscripts" && (
    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
  )}
  {name === "books" && (
    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
  )}
  {name === "transcriptions" && (
    <>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <path d="M14 2v6h6"></path>
      <path d="M16 13H8"></path>
      <path d="M16 17H8"></path>
      <path d="M10 9H8"></path>
    </>
  )}
  {name === "model" && (
    <>
      <rect width="16" height="16" x="4" y="4" rx="2"></rect>
      <rect width="6" height="6" x="9" y="9"></rect>
      <path d="M9 2v2"></path>
      <path d="M15 2v2"></path>
      <path d="M9 20v2"></path>
      <path d="M15 20v2"></path>
      <path d="M2 9h2"></path>
      <path d="M2 15h2"></path>
      <path d="M20 9h2"></path>
      <path d="M20 15h2"></path>
    </>
  )}
  {name === "provider" && (
    <>
      <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
      <path d="M6 12H4a2 2 0 0 0-2 2v8h4"></path>
      <path d="M18 9h2a2 2 0 0 1 2 2v11h-4"></path>
      <path d="M10 6h4"></path>
      <path d="M10 10h4"></path>
      <path d="M10 14h4"></path>
      <path d="M10 18h4"></path>
    </>
  )}
  {name === "words" && (
    <>
      <polyline points="4 7 4 4 20 4 20 7"></polyline>
      <line x1="9" x2="15" y1="20" y2="20"></line>
      <line x1="12" x2="12" y1="4" y2="20"></line>
    </>
  )}
  {name === "disagreements" && (
    <>
      <circle cx="18" cy="18" r="3"></circle>
      <circle cx="6" cy="6" r="3"></circle>
      <path d="M13 6h3a2 2 0 0 1 2 2v7"></path>
      <path d="M11 18H8a2 2 0 0 1-2-2V9"></path>
    </>
  )}
  {name === "arrow-up" && (
    <>
      <path d="m5 12 7-7 7 7"></path>
      <path d="M12 19V5"></path>
    </>
  )}
  {name === "arrow-left" && (
    <>
      <path d="m12 19-7-7 7-7"></path>
      <path d="M19 12H5"></path>
    </>
  )}
  {name === "arrow-right" && (
    <>
      <path d="m12 5 7 7-7 7"></path>
      <path d="M5 12h14"></path>
    </>
  )}
  {name === "effort" && (
    <>
      <path d="m12 14 4-4"></path>
      <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
    </>
  )}
  {name === "harness" && (
    <>
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
    </>
  )}
  {name === "language" && (
    <>
      <path d="m5 8 6 6"></path>
      <path d="m4 14 6-6 2-3"></path>
      <path d="M2 5h12"></path>
      <path d="M7 2h1"></path>
      <path d="m22 22-5-10-5 10"></path>
      <path d="M14 18h6"></path>
    </>
  )}
  {name === "section" && (
    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
  )}
  {name === "lines" && (
    <>
      <path d="M8 6h13"></path>
      <path d="M8 12h13"></path>
      <path d="M8 18h13"></path>
      <path d="M3 6h.01"></path>
      <path d="M3 12h.01"></path>
      <path d="M3 18h.01"></path>
    </>
  )}
</svg>
