---
import { compilations } from "../lib/data";
interface Props { fixed?: string }
const { fixed } = Astro.props;
const list = compilations();
---
<form class="filters" id="filters" data-fixed={fixed ?? ""} onsubmit="return false">
  {!fixed && (
    <fieldset><legend>Book</legend>
      <select name="book" aria-label="Book">
        <option value="">All books</option>
        {list.map((c) => <option value={c.id}>{c.stats.name}</option>)}
      </select>
    </fieldset>
  )}
  <fieldset><legend>Severity</legend>
    {["high", "medium", "low", "settled"].map((s) => <label><input type="checkbox" name="severity" value={s} checked={s !== "settled"} /> <span class={`pill ${s}`}>{s}</span></label>)}
  </fieldset>
  <fieldset><legend>Type</legend>
    {["substitution", "omission", "addition", "word order", "mixed", "lost text"].map((s) => <label><input type="checkbox" name="type" value={s} checked /> {s}</label>)}
  </fieldset>
  <fieldset><legend>Weight of the strongest other reading</legend>
    <label><input type="range" name="weight" min="0" max="50" step="1" value="0" /> <span id="wv">any</span></label>
  </fieldset>
  <fieldset><legend>Sort and search</legend>
    <select name="sort" aria-label="Sort">
      <option value="pos">In text order</option>
      <option value="weight">Strongest other reading first</option>
      <option value="conf">Least confident first</option>
      <option value="size">Most readings first</option>
    </select>
    <input type="search" name="q" placeholder="Greek word or 3:16" aria-label="Search" />
  </fieldset>
</form>
<p class="count" id="count">Loading…</p>
<div id="list"></div>
<button class="more-btn" id="more" hidden>Show more</button>
<script src="../scripts/places.ts"></script>
