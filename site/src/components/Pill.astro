---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Props {
  icon?: IconName;
  title?: string;
  ariaLabel?: string;
  href?: string;
  tone?: "default" | "accent" | "sky" | "subdued";
  target?: string;
  rel?: string;
  download?: boolean | string;
}

const { icon, title, ariaLabel, href, tone = "default", target, rel, download } = Astro.props;
const classes = ["pill", tone !== "default" ? `pill-${tone}` : ""].filter(Boolean).join(" ");
---
{href ? (
  <a class={classes} href={href} title={title} aria-label={ariaLabel} target={target} rel={rel} download={download === true ? true : download || undefined}>
    {icon && <Icon name={icon} />}
    <slot />
  </a>
) : (
  <span class={classes} title={title} aria-label={ariaLabel}>
    {icon && <Icon name={icon} />}
    <slot />
  </span>
)}
