---
import Pill from "./Pill.astro";
import { languageCodesFor, languageHoverLabel } from "../lib/languages";

interface Props {
  /** A language name or internal ISO 639-3 code such as "Greek" or "grc". */
  language: string;
}

const { language } = Astro.props;
const codes = languageCodesFor(language);
---
{codes.length > 1 ? (
  <span class="pill-row">
    {codes.map((code) => (
      <Pill icon="language" title={languageHoverLabel(code)} ariaLabel={languageHoverLabel(code)}>{code}</Pill>
    ))}
  </span>
) : (
  codes.map((code) => (
    <Pill icon="language" title={languageHoverLabel(code)} ariaLabel={languageHoverLabel(code)}>{code}</Pill>
  ))
)}
