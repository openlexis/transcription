---
import "../styles/lang-code-badge.css";
import { languageCodeBadgeHtml } from "../lib/languages";

interface Props {
  /** A compact language code such as grc, or a source/display language name such as "Greek". */
  language: string;
}

const { language } = Astro.props;
---
<Fragment set:html={languageCodeBadgeHtml(language)} />
