---
// A readable heading for a specification or transcription, built from real details in the data (no invented title).
import {
  compilationDetails,
  specificationDetails,
  type CompilationRecord,
  type SpecFile,
} from "../lib/corpus";

interface Props {
  as?: "h1" | "h2" | "h3" | "span" | "p";
  class?: string;
  compilation?: CompilationRecord;
  spec?: SpecFile;
  transcriptionCount?: number;
  /** Already-built details, when the caller has a ready string. */
  text?: string;
}

const { as: Tag = "h2", class: cls, compilation, spec, transcriptionCount, text } = Astro.props;
const shown =
  text ??
  (compilation ? compilationDetails(compilation) : spec ? specificationDetails(spec, transcriptionCount) : "");
---
<Tag class={cls}>{shown}</Tag>
