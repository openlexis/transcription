---
// Shows the record an output artifact keeps of how it was made: the specification's hash, and whatever the compiler reported
// about itself when it ran. Nothing here is assumed; every value comes from the artifact's compilation.json.
import { base, shortHash, type Artifact } from "../lib/data";
interface Props { art: Artifact; compact?: boolean }
const { art, compact } = Astro.props;
const under = art.manifest.specification, by = art.manifest.compiler;
const repo = typeof by.repository === "string" ? by.repository.replace(/\.git$/, "") : undefined;
const LABEL: Record<string, string> = { id: "Output name", program: "Program", model: "Model", version: "Version", repository: "Repository", commit: "Commit", codeMatchesCommit: "Code unchanged since that commit", codeSha256: "Hash of its code (SHA-256)", runtime: "Runtime" };
const val = (v: string | boolean | undefined) => (v === undefined ? "not reported" : typeof v === "boolean" ? (v ? "yes" : "no") : v);
const who = typeof by.model === "string" ? by.model : typeof by.program === "string" ? by.program : "not reported";
---
{compact ? (
  <span>Produced under <a href="/specification/">the specification</a> (SHA-256 {shortHash(under.sha256)}…{art.current ? "" : ", an earlier version"}), by {who}{typeof by.commit === "string" && <> at commit {repo ? <a href={`${repo}/commit/${by.commit}`}>{shortHash(by.commit)}</a> : shortHash(by.commit)}</>}, which documents <a href={`${base(art)}/method/`}>its own method</a>.</span>
) : (
  <dl class="front">
    <dt>Produced under</dt><dd><a href="/specification/">{under.file}</a>, SHA-256 <code>{shortHash(under.sha256)}…</code>{art.current ? " (the current file)" : " (an earlier version of the file)"}</dd>
    {Object.entries(by).map(([k, v]) => (
      <><dt>{LABEL[k] ?? k}</dt><dd>{k === "commit" && repo && typeof v === "string" ? <a href={`${repo}/commit/${v}`}><code>{shortHash(v)}</code></a> : k === "repository" && repo ? <a href={repo}>{repo.replace(/^https:\/\//, "")}</a> : k.endsWith("Sha256") && typeof v === "string" ? <code>{shortHash(v)}…</code> : val(v)}</dd></>
    ))}
    <dt>Method</dt><dd><a href={`${base(art)}/method/`}>{art.manifest.method.file}</a>, as written by the compiler and kept in the output</dd>
  </dl>
)}
