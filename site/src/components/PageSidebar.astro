---
interface Props {
  label: string;
  toggleLabel: string;
  title?: string;
}

const { label, toggleLabel, title } = Astro.props;
---
<aside class="page-sidebar" aria-label={label} data-page-sidebar>
  <div class="page-sidebar-panel">
    <button type="button" class="page-sidebar-toggle" aria-expanded="false">
      <span class="page-sidebar-toggle-label">{toggleLabel}</span>
      <span class="page-sidebar-current" data-sidebar-current hidden></span>
    </button>
    <div class="page-sidebar-body">
      {title && <div class="page-sidebar-title page-sidebar-title-desktop">{title}</div>}
      <slot />
    </div>
  </div>
</aside>

<script>
  import { initSidebarSpy } from "../lib/sidebar-spy";
  initSidebarSpy();
</script>
