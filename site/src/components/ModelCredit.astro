---
import Icon from "./Icon.astro";
import { facetUrl } from "../lib/corpus";

interface Props {
  modelName: string;
  effort?: string;
  lab?: string;
  harness?: string;
}

const { modelName, effort, lab, harness } = Astro.props;
---
<div class="model-credit" aria-label="Model">
  <span class="model-credit-main">
    <a class="model-credit-part" href={facetUrl("model", modelName)} title="All transcriptions using this model">
      <Icon name="model" size={14} />
      {modelName}
    </a>
    {effort && (
      <span class="model-credit-part" title="Effort">
        <Icon name="effort" size={14} />
        {effort}
      </span>
    )}
  </span>
  {(lab || harness) && (
    <span class="model-credit-by">
      {lab && (
        <>
          <span class="model-credit-label">by</span>
          <a class="model-credit-part" href={facetUrl("lab", lab)} title="All transcriptions from this lab">
            <Icon name="provider" size={14} />
            {lab}
          </a>
        </>
      )}
      {lab && harness && <span class="model-credit-dot" aria-hidden="true"> · </span>}
      {harness && (
        <>
          <span class="model-credit-label">via</span>
          <a class="model-credit-part" href={facetUrl("harness", harness)} title="All transcriptions using this harness">
            <Icon name="harness" size={14} />
            {harness}
          </a>
        </>
      )}
    </span>
  )}
</div>
