---
import Base from "../layouts/Base.astro";
import ProducedBy from "../components/ProducedBy.astro";
import { base, book, bookUrl, chapters, script, type Artifact } from "../lib/data";
interface Props { art: Artifact; id: string; chapter: string }
const { art, id, chapter } = Astro.props;
const e = art.manifest.books.find((b) => b.id === id)!, B = book(art, id), S = script(e.language);
const lines = B.lines.filter((l) => l.ref.split(":")[0] === chapter);
const chs = chapters(art, id), i = chs.indexOf(chapter), prev = chs[i - 1], next = chs[i + 1];
const hasAr = lines.some((l) => l.aramaic);
// how a word is marked: underlined where the manuscripts differ, more strongly the less certain it is
const band = (w: { p?: number; c?: number }) => (w.p === undefined ? "" : (w.c ?? 1) < 0.6 ? " v-high" : (w.c ?? 1) < 0.95 ? " v-medium" : " v-low");
---
<Base title={`${e.name} ${chapter}`} art={art} current={id} tab="read" description={`${e.name} chapter ${chapter}, compiled from the ancient ${e.language} manuscripts, with the evidence for every word.`}>
  <h1>{e.name} <span style="color:var(--faint)">{chapter}</span></h1>
  <div class="chapters">{chs.map((ch) => <a href={bookUrl(art, id, `${ch}/`)} class={ch === chapter ? "on" : ""}>{ch}</a>)}</div>
  <div class="toolbar">
    <div class="legend">
      <span><i style="border-color:var(--high)"></i>manuscripts differ, less than 60% certain</span>
      <span><i style="border-color:var(--medium)"></i>differ, 60 to 95%</span>
      <span><i style="border-color:var(--settled)"></i>differ, over 95%</span>
      {hasAr && <span><b class="tag ar">Aramaic</b> words in Aramaic</span>}
    </div>
    <label><input type="checkbox" id="marks" checked /> show marks</label>
    {S.cls === "hebrew" && <label><input type="checkbox" id="points" /> consonants only</label>}
  </div>
  <p class="meta" style="margin-top:0">Tap a word for its evidence, or a line number for every manuscript's text of the line. <ProducedBy compact art={art} /></p>
  <article id="text" class={`text ${S.cls}-text`} lang={S.lang} dir={S.dir} data-src={`/data/${art.slug}/${id}/${chapter}.json`} data-wit={`/data/${art.slug}/${id}/w.json`} data-method={`${base(art)}/method/`} data-script={S.cls}>
    {lines.map((l, li) => (
      <div class="ln" id={`l${l.ref.replace(":", "-")}`} data-l={li}>
        <button class="no" data-l={li} aria-label={`Line ${l.ref}: every manuscript`}>{l.ref.split(":")[1]}{l.aramaic && <b class="tag ar" title={l.aramaic === "all" ? "This line is in Aramaic" : "Part of this line is in Aramaic"}>Aram.</b>}</button>
        {l.uncovered ? <div class="uncovered">No manuscript we hold has this line.</div> : (
          <div class={`${S.cls}${l.aramaic === "part" ? " ar-part" : ""}`}>{(l.words ?? []).map((w, wi) => <><button class={`w${band(w)}${w.a ? " ar" : ""}`} lang={w.a ? "arc" : undefined} data-l={li} data-w={wi}>{w.t}</button>{" "}</>)}</div>
        )}
      </div>
    ))}
  </article>
  <nav class="pager">
    {prev ? <a href={bookUrl(art, id, `${prev}/`)}>← Chapter {prev}</a> : <span></span>}
    {next ? <a href={bookUrl(art, id, `${next}/`)}>Chapter {next} →</a> : <span></span>}
  </nav>
  <script src="../scripts/reader.ts"></script>
</Base>
