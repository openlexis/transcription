---
import Base from "../layouts/Base.astro";
import ProducedBy from "../components/ProducedBy.astro";
import { base, book, bookUrl, chapters, era, num, pct, script, type Artifact } from "../lib/data";
interface Props { art: Artifact; id: string }
const { art, id } = Astro.props;
const e = art.manifest.books.find((b) => b.id === id)!, s = e.stats, B = book(art, id), S = script(e.language);
const chs = chapters(art, id);
const known = B.witnesses.filter((w) => w.date.estimate !== null).length;
const top = [...B.places].filter((p) => !p.lost && p.readings.length > 1).sort((a, b) => b.weight - a.weight).slice(0, 8);
---
<Base title={e.name} art={art} current={id} tab="overview">
  <h1>{e.name}</h1>
  <p class="lede">Compiled from {num(s.manuscripts)} manuscripts in {e.language}, oldest first. {num(s.words)} words in {num(s.lines - s.uncoveredLines)} lines; {num(s.places)} places where the manuscripts differ.</p>
  <ProducedBy art={art} />
  <div class="kpis">
    <div class="kpi"><b>{num(s.manuscripts)}</b><span>manuscripts ({num(s.early)} copied within {B.settings.lateAfter} years of the original)</span></div>
    <div class="kpi"><b>{pct(s.meanWordConfidence)}</b><span>average chance a printed word is original</span></div>
    <div class="kpi"><b>{num(s.places)}</b><span>places where they differ</span></div>
    <div class="kpi"><b>{s.meanManuscriptsPerLine}</b><span>manuscripts per line, on average</span></div>
  </div>
  <p>Dates: {num(known)} of {num(B.witnesses.length)} manuscripts have a date range from their holder; {B.witnesses.length - known ? `${num(B.witnesses.length - known)} have none, so their date is treated as unknown.` : "none lacks one."} The original is taken as written about {era(B.settings.origin)} (<a href={`${base(art)}/method/#3-how-likely-each-reading-is-the-model`}>why</a>).{s.uncoveredLines ? ` ${num(s.uncoveredLines)} lines are in no manuscript we hold.` : ""}{s.aramaicLines ? ` ${num(s.aramaicWords!)} words in ${num(s.aramaicLines)} lines are in Aramaic and are marked.` : ""}</p>
  <h2>Chapters</h2>
  <div class="chapters">{chs.map((ch) => <a href={bookUrl(art, id, `${ch}/`)}>{ch}</a>)}</div>
  {top.length > 0 && <>
    <h2>Where the other reading is strongest</h2>
    <div class="scroll"><table>
      <thead><tr><th>Line</th><th>Printed</th><th class="num">Chance</th><th>Strongest other reading</th><th class="num">Chance</th></tr></thead>
      <tbody>{top.map((p) => (
        <tr><td><a href={bookUrl(art, id, `${p.ref.split(":")[0]}/?p=${p.id}#l${p.ref.replace(":", "-")}`)}>{p.ref}</a></td><td class={S.cls} dir={S.dir}>{p.readings[0].text}</td><td class="num">{pct(p.readings[0].p)}</td><td class={S.cls} dir={S.dir}>{p.readings[1].text}</td><td class="num">{pct(p.readings[1].p)}</td></tr>
      ))}</tbody>
    </table></div>
  </>}
</Base>
