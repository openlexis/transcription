---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found">
  <section class="hero" style="border-bottom: 0;">
    <div class="container">
      <div class="eyebrow">404</div>
      <h1>Page not found</h1>
      <p class="lead">The requested page does not exist on this site.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Return to overview</a>
        <a href="/transcriptions/" class="btn btn-secondary">Browse transcriptions</a>
        <a href="/archive/" class="btn btn-secondary">Browse archive</a>
      </div>
    </div>
  </section>
</Layout>
