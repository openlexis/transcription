---
import Layout from "../../layouts/Layout.astro";
import Pill from "../../components/Pill.astro";
import {
  formatAuthor,
  formatNum,
  formatUlidDate,
  getCompilationsForSpec,
  getSpecifications,
  shortUlid,
  specUrl,
  ulidTimestamp,
  withTrademark,
} from "../../lib/corpus";

const specs = [...getSpecifications()].sort(
  (a, b) => (ulidTimestamp(b.id) ?? 0) - (ulidTimestamp(a.id) ?? 0) || (a.id < b.id ? 1 : -1),
);
---
<Layout
  title="Specifications"
  active="specs"
  description="Self-contained YAML specifications for assembling transcriptions from primary ancient manuscripts."
>
  <section class="page-header">
    <div class="container">
      <h1>Specifications</h1>
      <p class="lead">
        Immutable specifications defining permitted ancient manuscripts, statistical modeling principles, and packaging requirements. Select any specification to read it in full.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="spec-cards">
        {specs.map((s, idx) => {
          const comps = getCompilationsForSpec(s.id);
          const dateStr = formatUlidDate(s.id);
          const authorStr = formatAuthor(s.author);
          return (
            <a href={specUrl(s.id)} class="spec-card">
              <div class="spec-card-top">
                <div class="spec-card-title-row">
                  <h2 class="spec-card-title">{withTrademark(s.title)}</h2>
                  {idx === 0 && specs.length > 1 && (
                    <Pill tone="accent">Latest</Pill>
                  )}
                </div>
                <span class="spec-card-cta">Read specification →</span>
              </div>
              <p class="spec-card-summary">{s.summary}</p>
              <div class="spec-card-meta">
                {authorStr && (
                  <Pill icon="author" title="Author">{authorStr}</Pill>
                )}
                {s.license && (
                  <Pill icon="license" title={`${withTrademark(s.license.copyright)}. ${s.license.name}`}>
                    {s.license.name}
                  </Pill>
                )}
                {dateStr && (
                  <Pill icon="date" title="Date created">{dateStr}</Pill>
                )}
                <Pill icon="manuscripts">{formatNum(s.sources.length)} manuscripts</Pill>
                <Pill icon="transcriptions" tone={comps.length > 0 ? "sky" : "default"}>
                  {comps.length === 0
                    ? "No transcriptions yet"
                    : `${comps.length} ${comps.length === 1 ? "transcription" : "transcriptions"}`}
                </Pill>
                <span class="spec-card-id" title={`Specification ID: ${s.id}`}>
                  <code>{shortUlid(s.id)}</code>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
