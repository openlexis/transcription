---
import Layout from "../../../layouts/Layout.astro";
import ConfidenceBadge from "../../../components/ConfidenceBadge.astro";
import Icon from "../../../components/Icon.astro";
import Pill from "../../../components/Pill.astro";
import Byline from "../../../components/Byline.astro";
import ModelCredit from "../../../components/ModelCredit.astro";
import {
  bookUrl,
  formatAuthor,
  formatBytes,
  formatNum,
  getBookAttributes,
  getCompilations,
  getSpecifications,
  githubBlob,
  githubTree,
  normalizeSeverityBucket,
  shortUlid,
  specUrl,
  withTrademark,
  type CompilationRecord,
} from "../../../lib/corpus";

export function getStaticPaths() {
  const seen = new Set<string>();
  return getCompilations().map((c) => {
    const slug = shortUlid(c.compilationId);
    if (seen.has(slug)) throw new Error(`Duplicate short compilation slug: ${slug}`);
    seen.add(slug);
    return {
      params: { compilationId: slug },
      props: { compilation: c },
    };
  });
}

interface Props {
  compilation: CompilationRecord;
}

const { compilation: c } = Astro.props;
const m = c.manifest;
const attr = m.modelAttribution;
const report = c.report;
const reportCats = report?.frontmatter?.disagreement_categories ?? [];
const totalCategorized = reportCats.reduce((sum, cat) => sum + (cat.count ?? 0), 0);
const reportScale = report?.frontmatter?.disagreement_scale;
const reportSevs =
  report?.frontmatter?.disagreement_subcategories ??
  report?.frontmatter?.disagreement_severities ??
  [];
const totalSevReadings = reportSevs.reduce((sum, s) => sum + (s.count ?? s.variant_readings_count ?? 0), 0);
const authenticitySignal = report?.frontmatter?.authenticity_signal;
const evidenceUsage = report?.frontmatter?.evidence_usage
  ? Object.entries(report.frontmatter.evidence_usage)
  : [];

const facetCounts = new Map<string, Map<string, number>>();
const bookEntries = m.books.map((b) => {
  const attrs = getBookAttributes(b);
  for (const [k, vals] of Object.entries(attrs)) {
    let valMap = facetCounts.get(k);
    if (!valMap) {
      valMap = new Map<string, number>();
      facetCounts.set(k, valMap);
    }
    for (const v of vals) valMap.set(v, (valMap.get(v) ?? 0) + 1);
  }
  return { book: b, attrs };
});

const facets = [...facetCounts.entries()]
  .map(([key, valMap]) => ({
    key,
    label: key.replace(/[_-]+/g, " ").replace(/\b\w/g, (ch) => ch.toUpperCase()),
    values: [...valMap.entries()]
      .map(([value, count]) => ({ value, count }))
      .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value)),
  }))
  .filter((f) => f.values.length > 0);

const createdDate = m.compilation.createdAt
  ? new Date(m.compilation.createdAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";
const compTitle = m.compilation.title || (createdDate ? `${attr.modelName} · ${createdDate}` : attr.modelName);
const compSubtitle = m.compilation.subtitle || `${attr.modelName} (${attr.provider})`;
const compSummary = m.compilation.summary || m.method.summary;
const compAuthor = formatAuthor(m.compilation.author);
const license = getSpecifications().find((s) => s.id === c.specId)?.license;
---
<Layout
  title={compTitle}
  active="transcriptions"
  description={compSummary}
>
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Transcription</div>
      <h1>{compTitle}</h1>
      <p style="margin: 6px 0 0; font-size: 1.02rem; font-weight: 500; color: var(--ink-secondary);">
        {compSubtitle}
      </p>
      <Byline
        items={[
          compAuthor && { icon: "author", text: compAuthor, title: "Author" },
          createdDate && { icon: "date", text: createdDate, title: "Date compiled" },
          license && { icon: "license", text: license.name, title: withTrademark(license.copyright), href: license.url },
        ]}
      />
      <ModelCredit
        modelName={attr.modelName}
        effort={attr.effortLevel}
        lab={attr.provider}
        harness={attr.harness}
      />
      <div class="pill-row" style="margin-top: 14px;">
        <Pill icon="books">{formatNum(m.books.length)} books</Pill>
        <Pill icon="words">{formatNum(m.totals.words)} words</Pill>
        <Pill icon="disagreements">{formatNum(m.totals.variantPlaces)} disagreements</Pill>
      </div>
      <p class="lead" style="margin-top: 12px;">
        {compSummary}
      </p>
      <div class="ulid-bar">
        <a href="/transcriptions/" class="btn btn-secondary">← All transcriptions</a>
        <a href={specUrl(c.specId)} class="btn btn-secondary" title={`Specification ID: ${c.specId}`}>
          Specification <Icon name="arrow-up" size={14} />
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="books" style="padding-top: 32px;">
    <div class="container">
      {m.books.length > 1 && (
        <div class="filter-bar" id="book-filter-bar">
          <div class="filter-top">
            <input
              type="search"
              id="book-search"
              class="search-input"
              placeholder="Filter books by name, ID, or attribute…"
              aria-label="Filter compiled books"
            />
          </div>

          {facets.length > 0 && (
            <div style="display: flex; flex-direction: column; gap: 10px;">
              {facets.map((f) => (
                <div class="pill-group" role="group" aria-label={`Filter by ${f.label}`} data-facet-key={f.key}>
                  <span class="pill-label">{f.label}</span>
                  <button type="button" class="filter-pill active" data-attr-key={f.key} data-attr-val="">
                    All
                  </button>
                  {f.values.map((v) => (
                    <button type="button" class="filter-pill" data-attr-key={f.key} data-attr-val={v.value}>
                      {v.value}
                    </button>
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      <div class="results-meta" style="margin-bottom: 14px;">
        <span id="book-filter-count">
          Showing {formatNum(m.books.length)} of {formatNum(m.books.length)} {m.books.length === 1 ? "book" : "books"}
        </span>
        <button type="button" id="book-filter-reset" class="copy-btn" hidden>Clear filters</button>
      </div>

      <div class="books-grid" id="compiled-books-grid">
        {bookEntries.map(({ book: b, attrs }) => {
          const flatAttrs = Object.entries(attrs).flatMap(([k, vals]) => vals.map((v) => ({ k, v })));
          const searchHay = `${b.name} ${b.id} ${flatAttrs.map((x) => `${x.k} ${x.v}`).join(" ")}`.toLowerCase();
          return (
            <div
              class="book-tile book-tile-card"
              data-book-attrs={JSON.stringify(attrs)}
              data-book-search={searchHay}
            >
              <a href={bookUrl(c.compilationId, b.id)} class="book-tile-main">
                <div class="book-top">
                  <span class="book-name">{b.name}</span>
                  <span class="book-code">{b.id}</span>
                </div>
                <div class="book-meta">
                  <span class="book-sources">{formatNum(b.stats.words)} words</span>
                  <ConfidenceBadge
                    value={b.stats.meanWordConfidence}
                    kind="book-mean"
                    context={b.name}
                    focusable={false}
                  />
                </div>
              </a>
              {flatAttrs.length > 0 && (
                <div class="book-attr-row">
                  {flatAttrs.map((x) => (
                    <button
                      type="button"
                      class="book-attr-pill"
                      data-attr-key={x.k}
                      data-attr-val={x.v}
                      title={`Filter by ${x.k}: ${x.v}`}
                    >
                      {x.v}
                    </button>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section" id="details">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Methodology &amp; Model Details</h2>
          <p class="section-sub">Expand any section below to inspect the model details, statistical method, scenarios, and disagreement categories.</p>
        </div>
      </div>

      <details class="embed-accordion" id="summary">
        <summary>
          <div class="embed-summary-left">
            <span class="embed-summary-title">Transcription Summary &amp; Model Provenance</span>
            <span class="embed-summary-sub">{attr.provider} · {attr.modelName} · {formatNum(m.totals.lines)} lines · {formatNum(m.totals.words)} words · {formatBytes(m.totals.totalBytes)}</span>
          </div>
          <span class="embed-chevron" aria-hidden="true"></span>
        </summary>
        <div class="embed-body">
          <div class="breakdown-grid">
            <div class="panel">
              <h3 style="margin-bottom: 14px;">Model Attribution</h3>
              <div class="source-meta-grid" style="padding-bottom: 0; border-bottom: 0;">
                <div>
                  <div class="source-meta-label">Provider</div>
                  <div class="source-meta-val">{attr.provider}</div>
                </div>
                <div>
                  <div class="source-meta-label">Model</div>
                  <div class="source-meta-val">{attr.modelName} (<code>{attr.modelId}</code>)</div>
                </div>
                {attr.effortLevel && (
                  <div>
                    <div class="source-meta-label">Effort Level</div>
                    <div class="source-meta-val">{attr.effortLevel}</div>
                  </div>
                )}
                {attr.harness && (
                  <div>
                    <div class="source-meta-label">Harness</div>
                    <div class="source-meta-val">{attr.harness}</div>
                  </div>
                )}
                {attr.deterministicEngine && (
                  <div>
                    <div class="source-meta-label">Engine &amp; Runtime</div>
                    <div class="source-meta-val">
                      <code>{attr.deterministicEngine.program}</code> · {attr.deterministicEngine.runtime}
                    </div>
                  </div>
                )}
                <div>
                  <div class="source-meta-label">Compiled At</div>
                  <div class="source-meta-val">{createdDate || m.compilation.createdAt}</div>
                </div>
              </div>
            </div>

            <div class="panel">
              <h3 style="margin-bottom: 14px;">Corpus Totals</h3>
              <div class="source-meta-grid" style="padding-bottom: 0; border-bottom: 0;">
                <div>
                  <div class="source-meta-label">Books Compiled</div>
                  <div class="source-meta-val">{formatNum(m.books.length)}</div>
                </div>
                <div>
                  <div class="source-meta-label">Numbered Lines</div>
                  <div class="source-meta-val">{formatNum(m.totals.lines)}</div>
                </div>
                <div>
                  <div class="source-meta-label">Compiled Words</div>
                  <div class="source-meta-val">{formatNum(m.totals.words)}</div>
                </div>
                <div>
                  <div class="source-meta-label">Disagreements</div>
                  <div class="source-meta-val">{formatNum(m.totals.variantPlaces)}</div>
                </div>
                <div>
                  <div class="source-meta-label">Total Artifact Size</div>
                  <div class="source-meta-val">{formatBytes(m.totals.totalBytes)}</div>
                </div>
                <div>
                  <div class="source-meta-label">Output Format</div>
                  <div class="source-meta-val">{m.compilation.outputFormat}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </details>

      <details class="embed-accordion" id="method">
        <summary>
          <div class="embed-summary-left">
            <span class="embed-summary-title">Statistical Method &amp; Scenario Accounting</span>
            <span class="embed-summary-sub">Step-by-step pipeline, how specific manuscript scenarios are treated, evidence usage, and known limitations</span>
          </div>
          <span class="embed-chevron" aria-hidden="true"></span>
        </summary>
        <div class="embed-body">
          {m.method.steps?.length ? (
            <div class="method-steps-grid">
              {m.method.steps.map((step) => (
                <div class="panel" style="padding: 18px 20px;">
                  <h3 style="margin-bottom: 8px;">{step.title}</h3>
                  <p style="margin: 0; font-size: 0.9rem; color: var(--ink-secondary); line-height: 1.65;">{step.body}</p>
                </div>
              ))}
            </div>
          ) : (
            <div class="panel prose" style="max-width: none;">
              {m.method.description.split("\n\n").map((p) => <p>{p}</p>)}
            </div>
          )}

          {m.method.scenarios?.length ? (
            <div style="margin-top: 28px;">
              <h3 style="margin-bottom: 12px;">How Specific Scenarios Are Treated</h3>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th style="width: 28%;">Scenario</th>
                      <th>How This Model Treats It</th>
                    </tr>
                  </thead>
                  <tbody>
                    {m.method.scenarios.map((row) => (
                      <tr>
                        <td><strong>{row.scenario}</strong></td>
                        <td style="color: var(--ink-secondary);">{row.treatment}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : null}

          {evidenceUsage.length > 0 && (
            <div style="margin-top: 28px;">
              <h3 style="margin-bottom: 12px;">Evidence Usage</h3>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th style="width: 24%;">Evidence Category</th>
                      <th>How Used in This Transcription</th>
                    </tr>
                  </thead>
                  <tbody>
                    {evidenceUsage.map(([k, v]) => (
                      <tr>
                        <td><strong>{k.replace(/[_-]+/g, " ")}</strong></td>
                        <td style="color: var(--ink-secondary);">{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {m.method.unknownsAndLimitations?.length ? (
            <div class="panel" style="margin-top: 24px; padding: 18px 22px;">
              <h3 style="margin-bottom: 10px;">Known Unknowns &amp; Limitations</h3>
              <ul style="margin: 0; padding-left: 20px; color: var(--ink-secondary); font-size: 0.9rem; display: grid; gap: 6px;">
                {m.method.unknownsAndLimitations.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ) : null}
        </div>
      </details>

      {(reportCats.length > 0 || m.method.differenceCategories?.length || reportSevs.length > 0) && (
        <details class="embed-accordion" id="difference-categories">
          <summary>
            <div class="embed-summary-left">
              <span class="embed-summary-title">Disagreement Categories &amp; Severity Scale</span>
              <span class="embed-summary-sub">How differences between manuscripts are classified and how each type affects confidence</span>
            </div>
            <span class="embed-chevron" aria-hidden="true"></span>
          </summary>
          <div class="embed-body">
            {reportCats.length > 0 ? (
              <div>
                <h3 style="margin-bottom: 8px;">Disagreement Categories</h3>
                <p class="section-sub" style="margin-bottom: 14px;">
                  Categories classifying all {formatNum(totalCategorized)} disagreements across this transcription.
                </p>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th style="width: 24%;">Category</th>
                        <th>Definition</th>
                        <th class="num" style="width: 14%;">Count</th>
                        <th class="num" style="width: 12%;">Share</th>
                      </tr>
                    </thead>
                    <tbody>
                      {reportCats.map((cat) => {
                        const share = totalCategorized ? (cat.count / totalCategorized) * 100 : 0;
                        return (
                          <tr>
                            <td><strong>{cat.label}</strong></td>
                            <td style="color: var(--ink-secondary);">{cat.description}</td>
                            <td class="num"><strong>{formatNum(cat.count)}</strong></td>
                            <td class="num">{share.toFixed(1)}%</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            ) : m.method.differenceCategories?.length ? (
              <div>
                <h3 style="margin-bottom: 12px;">Difference Categories</h3>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th style="width: 28%;">Category</th>
                        <th>Definition</th>
                      </tr>
                    </thead>
                    <tbody>
                      {m.method.differenceCategories.map((cat) => (
                        <tr>
                          <td><strong>{cat.label}</strong></td>
                          <td style="color: var(--ink-secondary);">{cat.meaning}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ) : null}

            {reportSevs.length > 0 && (
              <div id="disagreement-severities" style="margin-top: 28px; scroll-margin-top: 88px;">
                <h3 style="margin-bottom: 8px;">Disagreement Severity &amp; Subcategories</h3>
                <p class="section-sub" style="margin-bottom: 14px;">
                  {reportScale?.description
                    ? `${reportScale.description} (Scale: ${reportScale.min}–${reportScale.max}.)`
                    : "Severity subcategories and their effects on local confidence and corpus authenticity."}
                </p>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th style="width: 24%;">Severity &amp; Subcategory</th>
                        <th>Description &amp; Confidence Effects</th>
                        <th class="num" style="width: 14%;">Readings</th>
                        <th class="num" style="width: 11%;">Share</th>
                      </tr>
                    </thead>
                    <tbody>
                      {reportSevs.map((s) => {
                        const cnt = s.count ?? s.variant_readings_count ?? 0;
                        const share = totalSevReadings ? (cnt / totalSevReadings) * 100 : 0;
                        const bucket = normalizeSeverityBucket(s.level, reportScale);
                        const badgeTxt =
                          s.level_label ??
                          s.short_label ??
                          (reportScale ? `${s.level}/${reportScale.max}` : `Level ${s.level}`);
                        return (
                          <tr>
                            <td>
                              <span class={`sev-badge sev-badge-${bucket}`}>{badgeTxt}</span>
                              <div style="font-weight: 600; margin-top: 4px; font-size: 0.88rem;">{s.label}</div>
                            </td>
                            <td style="color: var(--ink-secondary); font-size: 0.88rem;">
                              <div>{s.description}</div>
                              {s.local_confidence_effect && (
                                <div class="ms-sub" style="margin-top: 5px;"><strong>Local confidence:</strong> {s.local_confidence_effect}</div>
                              )}
                              {s.corpus_authenticity_effect && (
                                <div class="ms-sub" style="margin-top: 3px;"><strong>Witness / corpus authenticity:</strong> {s.corpus_authenticity_effect}</div>
                              )}
                              {!s.local_confidence_effect && s.confidence_effect && (
                                <div class="ms-sub" style="margin-top: 5px;"><strong>Confidence effect:</strong> {s.confidence_effect}</div>
                              )}
                            </td>
                            <td class="num"><strong>{formatNum(cnt)}</strong></td>
                            <td class="num">{share.toFixed(1)}%</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>

                {authenticitySignal && (
                  <div class="callout" style="margin-top: 16px;">
                    <div>
                      <h3 style="font-size: 0.96rem; margin-bottom: 4px;">Corpus Authenticity Signal</h3>
                      <p style="margin: 0; font-size: 0.88rem; color: var(--ink-secondary);">{authenticitySignal}</p>
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>
        </details>
      )}
    </div>
  </section>

  <script>
    // Auto-open expandable detail sections when linked via hash (e.g., #method, #difference-categories, #disagreement-severities)
    function openHashTarget() {
      const id = location.hash.replace(/^#/, "");
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      const details = target.tagName === "DETAILS" ? (target as HTMLDetailsElement) : target.closest("details");
      if (details) details.open = true;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    openHashTarget();
    window.addEventListener("hashchange", openHashTarget);

    // Dynamic book filter
    const grid = document.getElementById("compiled-books-grid");
    const cards = grid ? [...grid.querySelectorAll<HTMLElement>(".book-tile-card")] : [];
    const searchInput = document.getElementById("book-search") as HTMLInputElement | null;
    const countEl = document.getElementById("book-filter-count");
    const resetBtn = document.getElementById("book-filter-reset") as HTMLButtonElement | null;
    const facetBtns = [...document.querySelectorAll<HTMLButtonElement>("#book-filter-bar [data-attr-key]")];

    const selected = new Map<string, string>();
    let query = "";

    function applyBookFilters() {
      let shown = 0;
      const q = query.trim().toLowerCase();

      for (const card of cards) {
        const attrs = JSON.parse(card.dataset.bookAttrs || "{}") as Record<string, string[]>;
        const hay = card.dataset.bookSearch || "";
        let ok = true;
        if (q && !hay.includes(q)) ok = false;
        if (ok) {
          for (const [k, v] of selected) {
            if (!v) continue;
            if (!(attrs[k] || []).includes(v)) {
              ok = false;
              break;
            }
          }
        }
        card.hidden = !ok;
        if (ok) shown++;
      }

      const activePairs = [...selected.entries()].filter(([, v]) => Boolean(v));
      if (countEl) {
        const suffix = activePairs.length
          ? ` matching ${activePairs.map(([k, v]) => `${k}: ${v}`).join(", ")}`
          : "";
        countEl.textContent = `Showing ${shown.toLocaleString("en-US")} of ${cards.length.toLocaleString("en-US")} ${cards.length === 1 ? "book" : "books"}${suffix}`;
      }
      if (resetBtn) {
        resetBtn.hidden = !(q || activePairs.length);
      }

      for (const btn of facetBtns) {
        const k = btn.dataset.attrKey || "";
        const v = btn.dataset.attrVal || "";
        const cur = selected.get(k) || "";
        btn.classList.toggle("active", cur === v);
      }
      grid?.querySelectorAll<HTMLButtonElement>(".book-attr-pill").forEach((pill) => {
        const k = pill.dataset.attrKey || "";
        const v = pill.dataset.attrVal || "";
        pill.classList.toggle("active", (selected.get(k) || "") === v);
      });
    }

    function setFacet(key: string, val: string) {
      if (!val || selected.get(key) === val) {
        selected.delete(key);
      } else {
        selected.set(key, val);
      }
      applyBookFilters();
    }

    facetBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const k = btn.dataset.attrKey || "";
        const v = btn.dataset.attrVal || "";
        if (!v) selected.delete(k);
        else setFacet(k, v);
        applyBookFilters();
      });
    });

    grid?.addEventListener("click", (e) => {
      const pill = (e.target as HTMLElement).closest<HTMLButtonElement>(".book-attr-pill");
      if (!pill) return;
      setFacet(pill.dataset.attrKey || "", pill.dataset.attrVal || "");
    });

    searchInput?.addEventListener("input", () => {
      query = searchInput.value;
      applyBookFilters();
    });

    resetBtn?.addEventListener("click", () => {
      selected.clear();
      query = "";
      if (searchInput) searchInput.value = "";
      applyBookFilters();
    });
  </script>
</Layout>
