---
import Layout from "../../layouts/Layout.astro";
import TranscriptionCard from "../../components/TranscriptionCard.astro";
import TranscriptionsSpecFilter from "../../components/TranscriptionsSpecFilter.astro";
import { getCompilations, getSpecifications } from "../../lib/corpus";

const compilations = getCompilations();
const specs = getSpecifications();
const specsById = new Map(specs.map((s) => [s.id, s]));
---
<Layout
  title="Transcriptions"
  active="transcriptions"
  description="Read original-language transcriptions assembled directly from primary ancient manuscripts."
>
  <section class="page-header">
    <div class="container">
      <h1>Transcriptions</h1>
      <p class="lead">
        Complete original-language texts assembled directly from primary ancient manuscripts. Each transcription reflects one model's full statistical assessment under a published specification, with every witness and probability preserved beside the text.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {compilations.length === 0 ? (
        <div class="callout">
          <div>
            <h3>No Transcriptions Yet</h3>
            <p>
              Run <code>bun run compile</code> to assemble all target books under the active specification and rebuild this site automatically.
            </p>
          </div>
          <a href="/specifications/" class="btn btn-secondary">Read specification →</a>
        </div>
      ) : (
        <>
          <TranscriptionsSpecFilter specs={specs} />
          <div class="spec-cards" data-transcription-list>
            {compilations.map((c) => (
              <TranscriptionCard compilation={c} license={specsById.get(c.specId)?.license} />
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>
