---
import Layout from "../../layouts/Layout.astro";
import {
  compUrl,
  formatAuthor,
  formatBytes,
  formatNum,
  getCompilations,
  shortUlid,
  specUrl,
} from "../../lib/corpus";

const compilations = getCompilations();
---
<Layout
  title="Transcriptions"
  active="transcriptions"
  description="Read original-language transcriptions assembled directly from primary ancient manuscripts."
>
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Transcriptions</div>
      <h1>Transcriptions</h1>
      <p class="lead">
        Complete original-language texts assembled directly from primary ancient manuscripts. Each transcription reflects one model's full statistical assessment under a published specification, with every witness and probability preserved beside the text.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {compilations.length === 0 ? (
        <div class="callout">
          <div>
            <h3>No Transcriptions Yet</h3>
            <p>
              Run <code>bun run compile</code> to assemble all target books under the active specification and rebuild this site automatically.
            </p>
          </div>
          <a href="/specifications/" class="btn btn-secondary">Read specification →</a>
        </div>
      ) : (
        <div class="item-list">
          {compilations.map((c) => {
            const m = c.manifest;
            const dateStr = m.compilation.createdAt
              ? new Date(m.compilation.createdAt).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              : "";
            const title = m.compilation.title || (dateStr ? `${m.modelAttribution.modelName} · ${dateStr}` : m.modelAttribution.modelName);
            const subtitle = m.compilation.subtitle || `${m.modelAttribution.modelName} (${m.modelAttribution.provider})`;
            const summary = m.compilation.summary || m.method.summary;
            const authorStr = formatAuthor(m.compilation.author);
            return (
              <div class="panel">
                <div class="panel-head">
                  <div>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 4px;">
                      <a href={compUrl(c.compilationId)} style="font-size: 1.15rem; font-weight: 700; color: var(--ink);">
                        {title}
                      </a>
                      <code title={c.compilationId}>{shortUlid(c.compilationId)}</code>
                      <span class="badge badge-indigo">{m.modelAttribution.modelName}</span>
                      {m.modelAttribution.effortLevel && (
                        <span class="badge">{m.modelAttribution.effortLevel} effort</span>
                      )}
                    </div>
                    <p class="panel-sub" style="margin-top: 2px;">
                      {subtitle}{authorStr ? ` · ${authorStr}` : ""}{dateStr ? ` · ${dateStr}` : ""} · <a href={specUrl(c.specId)}>Specification <code title={c.specId}>{shortUlid(c.specId)}</code></a>
                    </p>
                  </div>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href={compUrl(c.compilationId)} class="btn btn-primary">Read transcription →</a>
                  </div>
                </div>

                <p style="margin: 0 0 14px; color: var(--ink-secondary); font-size: 0.92rem;">
                  {summary}
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.88rem; color: var(--ink-muted); padding-top: 12px; border-top: 1px solid var(--border);">
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.books)}</strong> books</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.lines)}</strong> lines</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.words)}</strong> words</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.variantPlaces)}</strong> points of disagreement</span>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>
