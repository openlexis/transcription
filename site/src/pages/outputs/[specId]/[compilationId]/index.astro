---
import Layout from "../../../../layouts/Layout.astro";
import {
  formatBytes,
  formatNum,
  formatPct,
  getCompilations,
  githubBlob,
  githubTree,
  type CompilationRecord,
} from "../../../../lib/corpus";

export function getStaticPaths() {
  return getCompilations().map((c) => ({
    params: { specId: c.specId, compilationId: c.compilationId },
    props: { compilation: c },
  }));
}

interface Props {
  compilation: CompilationRecord;
}

const { compilation: c } = Astro.props;
const m = c.manifest;
const otBooks = m.books.filter((b) => b.section === "Old Testament");
const ntBooks = m.books.filter((b) => b.section === "New Testament");
const attr = m.modelAttribution;
---
<Layout
  title={`Compilation ${c.compilationId}`}
  active="outputs"
  description={`TEI P5 XML compilation ${c.compilationId} under specification ${c.specId}.`}
>
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">TEI P5 XML Compilation</div>
      <h1><code>{c.compilationId}</code></h1>
      <p class="lead">
        {m.specification.statement}
      </p>
      <div class="ulid-bar">
        <a href="/outputs/" class="btn btn-secondary">← All outputs</a>
        <a href="/specifications/" class="btn btn-secondary">Spec <code>{c.specId}</code></a>
        <a href={githubTree(c.relDir)} target="_blank" rel="noopener" class="btn btn-primary">Browse TEI XML on GitHub ↗</a>
        <a href={githubBlob(`${c.relDir}/manifest.json`)} target="_blank" rel="noopener" class="btn btn-secondary"><code>manifest.json</code> ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="breakdown-grid">
        <div class="panel">
          <div class="panel-head">
            <div>
              <h3>Model Attribution &amp; Provenance</h3>
              <p class="panel-sub">System responsible for statistical modeling and reading selection.</p>
            </div>
          </div>
          <div class="source-meta-grid">
            <div>
              <div class="source-meta-label">Provider</div>
              <div class="source-meta-val">{attr.provider}</div>
            </div>
            <div>
              <div class="source-meta-label">Model</div>
              <div class="source-meta-val">{attr.modelName} (<code>{attr.modelId}</code>)</div>
            </div>
            {attr.effortLevel && (
              <div>
                <div class="source-meta-label">Effort Level</div>
                <div class="source-meta-val">{attr.effortLevel}</div>
              </div>
            )}
            {attr.harness && (
              <div>
                <div class="source-meta-label">Harness</div>
                <div class="source-meta-val">{attr.harness}</div>
              </div>
            )}
            {attr.deterministicEngine && (
              <div>
                <div class="source-meta-label">Engine &amp; Runtime</div>
                <div class="source-meta-val">
                  <code>{attr.deterministicEngine.program}</code> · {attr.deterministicEngine.runtime}
                </div>
              </div>
            )}
            <div>
              <div class="source-meta-label">Compiled At</div>
              <div class="source-meta-val"><code>{m.compilation.createdAt}</code></div>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-head">
            <div>
              <h3>Compilation Summary</h3>
              <p class="panel-sub">{m.method.summary}</p>
            </div>
          </div>
          <div class="source-meta-grid">
            <div>
              <div class="source-meta-label">Books Compiled</div>
              <div class="source-meta-val">{formatNum(m.totals.books)} ({otBooks.length} OT · {ntBooks.length} NT)</div>
            </div>
            <div>
              <div class="source-meta-label">Numbered Lines</div>
              <div class="source-meta-val">{formatNum(m.totals.lines)}</div>
            </div>
            <div>
              <div class="source-meta-label">Compiled Words</div>
              <div class="source-meta-val">{formatNum(m.totals.words)}</div>
            </div>
            <div>
              <div class="source-meta-label">Variant Places (<code>&lt;app&gt;</code>)</div>
              <div class="source-meta-val">{formatNum(m.totals.variantPlaces)}</div>
            </div>
            <div>
              <div class="source-meta-label">Total Artifact Size</div>
              <div class="source-meta-val">{formatBytes(m.totals.totalBytes)}</div>
            </div>
            <div>
              <div class="source-meta-label">Output Format</div>
              <div class="source-meta-val">{m.compilation.outputFormat}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="method">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Statistical Method &amp; Scenario Accounting</h2>
          <p class="section-sub">{m.method.summary}</p>
        </div>
      </div>

      {m.method.steps?.length ? (
        <div class="method-steps-grid">
          {m.method.steps.map((step) => (
            <div class="panel" style="padding: 20px 22px;">
              <h3 style="margin-bottom: 8px;">{step.title}</h3>
              <p style="margin: 0; font-size: 0.9rem; color: var(--ink-secondary); line-height: 1.65;">{step.body}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="panel prose" style="max-width: none;">
          {m.method.description.split("\n\n").map((p) => <p>{p}</p>)}
        </div>
      )}

      {m.method.scenarios?.length ? (
        <div style="margin-top: 32px;">
          <h3 style="margin-bottom: 12px;">How Specific Scenarios Are Treated</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th style="width: 28%;">Scenario</th>
                  <th>How This Model Treats It</th>
                </tr>
              </thead>
              <tbody>
                {m.method.scenarios.map((row) => (
                  <tr>
                    <td><strong>{row.scenario}</strong></td>
                    <td style="color: var(--ink-secondary);">{row.treatment}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}

      {m.method.differenceCategories?.length ? (
        <div id="difference-categories" style="margin-top: 32px; scroll-margin-top: 88px;">
          <h3 style="margin-bottom: 12px;">Variant Difference Categorization</h3>
          <p class="section-sub" style="margin-bottom: 14px;">
            Every non-selected variant reading in the book reader carries one of these explicit difference labels comparing it against the selected reading.
          </p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th style="width: 28%;">Category Label</th>
                  <th>Explicit Definition</th>
                </tr>
              </thead>
              <tbody>
                {m.method.differenceCategories.map((cat) => (
                  <tr>
                    <td><span class="badge badge-indigo">{cat.label}</span></td>
                    <td style="color: var(--ink-secondary);">{cat.meaning}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}

      {m.method.unknownsAndLimitations?.length ? (
        <div class="panel" style="margin-top: 28px; padding: 20px 24px;">
          <h3 style="margin-bottom: 10px;">Known Unknowns &amp; Limitations</h3>
          <ul style="margin: 0; padding-left: 20px; color: var(--ink-secondary); font-size: 0.9rem; display: grid; gap: 6px;">
            {m.method.unknownsAndLimitations.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ) : null}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Old Testament ({otBooks.length} books)</h2>
          <p class="section-sub">Biblical Hebrew &amp; Biblical Aramaic — click any book to read its compiled text, word-level coverage, and variant apparatus.</p>
        </div>
      </div>
      <div class="books-grid">
        {otBooks.map((b) => (
          <a href={`/outputs/${c.specId}/${c.compilationId}/${b.id}/`} class="book-tile book-tile-link">
            <div class="book-top">
              <span class="book-name">{b.name}</span>
              <span class="book-code">{b.id}</span>
            </div>
            <div class="book-meta">
              <span class="book-sources">{formatNum(b.stats.manuscripts)} mss · {formatNum(b.stats.places)} apps</span>
              <span class="badge badge-amber">{formatPct(b.stats.meanWordConfidence)}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="section-head" style="margin-top: 40px;">
        <div>
          <h2>New Testament ({ntBooks.length} books)</h2>
          <p class="section-sub">Koine Greek — click any book to read its compiled text, word-level coverage, and variant apparatus.</p>
        </div>
      </div>
      <div class="books-grid">
        {ntBooks.map((b) => (
          <a href={`/outputs/${c.specId}/${c.compilationId}/${b.id}/`} class="book-tile book-tile-link">
            <div class="book-top">
              <span class="book-name">{b.name}</span>
              <span class="book-code">{b.id}</span>
            </div>
            <div class="book-meta">
              <span class="book-sources">{formatNum(b.stats.manuscripts)} mss · {formatNum(b.stats.places)} apps</span>
              <span class="badge badge-sky">{formatPct(b.stats.meanWordConfidence)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
