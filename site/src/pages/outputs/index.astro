---
import Layout from "../../layouts/Layout.astro";
import {
  formatAuthor,
  formatBytes,
  formatNum,
  getCompilations,
  shortUlid,
} from "../../lib/corpus";

const compilations = getCompilations();
---
<Layout
  title="Compiled Outputs"
  active="outputs"
  description="Compiled TEI P5 XML biblical texts produced under Open Lexis specifications."
>
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Compiled Outputs ({compilations.length})</div>
      <h1>Compiled Outputs</h1>
      <p class="lead">
        Original-language compilations generated under the YAML specifications in <code>specifications/</code> and stored as TEI P5 XML under <code>outputs/&lt;specification-id&gt;/&lt;compilation-id&gt;/</code>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {compilations.length === 0 ? (
        <div class="callout">
          <div>
            <h3>No Compiled Outputs Yet</h3>
            <p>
              Run <code>bun run compile</code> to compile all target books under the active specification and rebuild this site automatically.
            </p>
          </div>
          <a href="/specifications/" class="btn btn-secondary">Read specification →</a>
        </div>
      ) : (
        <div class="item-list">
          {compilations.map((c) => {
            const m = c.manifest;
            const dateStr = m.compilation.createdAt
              ? new Date(m.compilation.createdAt).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              : "—";
            const title = m.compilation.title || `${m.modelAttribution.modelName} · ${dateStr}`;
            const subtitle = m.compilation.subtitle || `${m.modelAttribution.modelName} (${m.modelAttribution.provider})`;
            const summary = m.compilation.summary || m.method.summary;
            const authorStr = formatAuthor(m.compilation.author);
            return (
              <div class="panel">
                <div class="panel-head">
                  <div>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 4px;">
                      <a href={`/outputs/${c.specId}/${c.compilationId}/`} style="font-size: 1.15rem; font-weight: 700; color: var(--ink);">
                        {title}
                      </a>
                      <code title={c.compilationId}>{shortUlid(c.compilationId)}</code>
                      <span class="badge badge-emerald">{m.totals.books} books</span>
                      <span class="badge badge-indigo">{m.modelAttribution.modelName}</span>
                      {m.modelAttribution.effortLevel && (
                        <span class="badge">{m.modelAttribution.effortLevel} effort</span>
                      )}
                    </div>
                    <p class="panel-sub" style="margin-top: 2px;">
                      {subtitle}{authorStr ? ` · ${authorStr}` : ""}{dateStr !== "—" ? ` · ${dateStr}` : ""} · <a href={`/specifications/${c.specId}/`}>Specification <code title={c.specId}>{shortUlid(c.specId)}</code></a>
                    </p>
                  </div>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href={`/outputs/${c.specId}/${c.compilationId}/`} class="btn btn-primary">Read books →</a>
                  </div>
                </div>

                <p style="margin: 0 0 14px; color: var(--ink-secondary); font-size: 0.92rem;">
                  {summary}
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.88rem; color: var(--ink-muted); padding-top: 12px; border-top: 1px solid var(--border);">
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.books)}</strong> books</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.lines)}</strong> lines</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.words)}</strong> words</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.variantPlaces)}</strong> points of disagreement</span>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>
