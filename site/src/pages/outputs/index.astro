---
import Layout from "../../layouts/Layout.astro";
import {
  formatBytes,
  formatNum,
  getCompilations,
  githubBlob,
  githubTree,
} from "../../lib/corpus";

const compilations = getCompilations();
---
<Layout
  title="Compiled Outputs"
  active="outputs"
  description="Compiled TEI P5 XML biblical texts produced under Open Lexis specifications."
>
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Compiled Outputs ({compilations.length})</div>
      <h1>Compiled Outputs</h1>
      <p class="lead">
        Original-language compilations generated under the YAML specifications in <code>specifications/</code> and stored as TEI P5 XML under <code>outputs/&lt;specification-id&gt;/&lt;compilation-id&gt;/</code>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {compilations.length === 0 ? (
        <div class="callout">
          <div>
            <h3>No Compiled Outputs Yet</h3>
            <p>
              Run <code>bun run compile</code> to compile all target books under the active specification and rebuild this site automatically.
            </p>
          </div>
          <a href="/specifications/" class="btn btn-secondary">Read specification →</a>
        </div>
      ) : (
        <div class="item-list">
          {compilations.map((c) => {
            const m = c.manifest;
            const dateStr = m.compilation.createdAt ? m.compilation.createdAt.slice(0, 10) : "—";
            return (
              <div class="panel">
                <div class="panel-head">
                  <div>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 6px;">
                      <a href={`/outputs/${c.specId}/${c.compilationId}/`} style="font-size: 1.12rem; font-weight: 700;">
                        <code>{c.compilationId}</code>
                      </a>
                      <span class="badge badge-emerald">{m.totals.books} books</span>
                      <span class="badge badge-indigo">{m.modelAttribution.provider} · {m.modelAttribution.modelName}</span>
                      {m.modelAttribution.effortLevel && (
                        <span class="badge">effort: {m.modelAttribution.effortLevel}</span>
                      )}
                    </div>
                    <p class="panel-sub">
                      Specification <a href="/specifications/"><code>{c.specId}</code></a> · Created {dateStr} · {m.compilation.outputFormat} · {formatBytes(m.totals.totalBytes)}
                    </p>
                  </div>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href={`/outputs/${c.specId}/${c.compilationId}/`} class="btn btn-primary">Explore books →</a>
                    <a href={githubTree(c.relDir)} target="_blank" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
                  </div>
                </div>

                <p style="margin: 0 0 14px; color: var(--ink-secondary); font-size: 0.92rem;">
                  {m.method.summary}
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.88rem; color: var(--ink-muted); padding-top: 12px; border-top: 1px solid var(--border);">
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.books)}</strong> books</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.lines)}</strong> lines</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.words)}</strong> words</span>
                  <span><strong style="color: var(--ink);">{formatNum(m.totals.variantPlaces)}</strong> variant <code>&lt;app&gt;</code> places</span>
                  <a href={githubBlob(`${c.relDir}/manifest.json`)} target="_blank" rel="noopener"><code>manifest.json</code> ↗</a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>
