---
import Base from "../layouts/Base.astro";
import { artifacts, base, num, shortHash } from "../lib/data";
const list = artifacts();
---
<Base title="Outputs" tab="outputs" description="Every output artifact: one compilation, filed by the specification it was produced under and the compiler that made it.">
  <h1>Outputs</h1>
  <p class="lede">Each compilation is one output: a bundle holding the text, the evidence for every reading and the method the compiler chose. New outputs are filed by the specification's ULID and the compilation's own ULID, in <code>outputs/&lt;specification ULID&gt;/&lt;compilation ULID&gt;/</code>. Any number can sit side by side; the site shows each one.</p>
  <div class="scroll"><table>
    <thead><tr><th>Output</th><th>Specification</th><th>Compiler</th><th>Books</th><th>Method</th></tr></thead>
    <tbody>{list.map((a) => (
      <tr>
        <td><a href={`${base(a)}/`}>{a.compiler}</a>{a.isDefault && <><br /><span class="meta">shown by default</span></>}</td>
        <td><code>{shortHash(a.manifest.specification.sha256)}…</code><br /><span class="meta">{a.current ? "the current file" : "an earlier version"}</span></td>
        <td>{String(a.manifest.compiler.program ?? a.manifest.compiler.model ?? "not reported")}{typeof a.manifest.compiler.commit === "string" && <><br /><span class="meta">commit {shortHash(a.manifest.compiler.commit)}{a.manifest.compiler.codeMatchesCommit === false ? ", code changed since" : ""}</span></>}</td>
        <td class="num">{num(a.manifest.books.length)}</td>
        <td><a href={`${base(a)}/method/`}>its method</a></td>
      </tr>
    ))}</tbody>
  </table></div>
  <p class="meta">Files: <a href="https://github.com/openlexis/transcription/tree/main/outputs">outputs/ on GitHub</a>. Each holds <code>compilation.json</code> (the specification's hash, the compiler's record of itself, its method and the list of books with their hashes) and <code>books/&lt;book&gt;.json</code>.</p>
</Base>
