---
import Places from "../../../../../views/Places.astro";
import { artifactBySlug, artifacts } from "../../../../../lib/data";
export function getStaticPaths() { return artifacts().filter((a) => !a.isDefault).flatMap((a) => a.manifest.books.map((b) => ({ params: { art: a.slug, id: b.id } }))); }
---
<Places art={artifactBySlug(Astro.params.art)} id={Astro.params.id} />
