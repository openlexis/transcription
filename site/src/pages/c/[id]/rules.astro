---
import Base from "../../../layouts/Base.astro";
import { blob, compilations, md, ruleParts } from "../../../lib/data";
export function getStaticPaths() { return compilations().map((c) => ({ params: { id: c.id } })); }
const { id } = Astro.params;
const c = compilations().find((x) => x.id === id)!;
const R = ruleParts(c.rules);
const LABEL: Record<string, string> = { "Origin year": "Origin year (− is BC)", "Half-life": "Half-life (years)", "Late after": "Late copy after (years)", "Undated year": "Undated taken as" };
---
<Base title={`${c.stats.name}: rules`} current={id} tab="rules" description={`The rule file that made the compiled transcription of ${c.stats.name}: the model, the numbered rules and every input.`}>
  <h1>{c.stats.name}: the rules</h1>
  <p class="lede">This compiled transcription was made in one pass by following the rule file below, and nothing else. The same rule file and inputs always give the same text. It is shown here in full; the original is <a href={blob(`compilations/${id}/RULES.md`)}>RULES.md on GitHub</a>.</p>
  <dl class="front">{R.front.map(([k, v]) => <><dt>{LABEL[k] ?? k}</dt><dd>{v}</dd></>)}<dt>Inputs</dt><dd><a href="#inputs">{R.inputs.length} transcriptions</a></dd></dl>
  <div class="rules" set:html={md(R.rules)} />
  <div class="rules" set:html={md(R.how)} />
  <h2 id="inputs">Inputs</h2>
  <details class="inputs" open={R.inputs.length <= 40}>
    <summary>{R.inputs.length} transcriptions read (tap to {R.inputs.length <= 40 ? "hide" : "show"})</summary>
    <ul>{R.inputs.map((f) => <li><a href={blob(f)}><code>{f.replace(/^transcriptions\//, "")}</code></a></li>)}</ul>
  </details>
  <p class="meta">Dates, holders and page-image links for each manuscript are on the <a href={`/c/${id}/inputs/`}>manuscripts page</a>. The same rules apply to every book in its section: see <a href="/rules/">all rules</a>.</p>
</Base>
