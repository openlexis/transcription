---
import Base from "../../../layouts/Base.astro";
import ProducedBy from "../../../components/ProducedBy.astro";
import { compilations, full, pct, num } from "../../../lib/data";
export function getStaticPaths() { return compilations().map((c) => ({ params: { id: c.id } })); }
const { id } = Astro.params;
const c = compilations().find((x) => x.id === id)!;
const s = c.stats, t = full(id);
const early = t.witnesses.filter((w) => w.early).sort((a, b) => a.year - b.year);
const sev = ["high", "medium", "low", "settled"];
const lateYear = s.origin + s.lateAfter;
const era = (y: number) => (y < 0 ? `${-y} BC` : y === 0 ? "the year 0" : `${y}`);
---
<Base title={s.name} current={id} tab="overview">
  <h1>{s.name}</h1>
  <p class="lede">The compiled transcription of {s.name}, from {num(s.manuscripts)} {s.language ?? "Greek"} manuscripts. Produced under <a href="/specification/">the specification</a>.</p>
  <div class="rulebox"><p><strong>How this text was made:</strong> one pass under the specification: {s.manuscripts} manuscripts lined up word by word, older copies counting more, the strongest reading printed. The output records what did the work, as that compiler reported itself when it ran:</p><ProducedBy under={s.producedUnder} by={s.producedBy} /><a class="go" href="/specification/">Read the specification →</a></div>
  <div class="kpis">
    <div class="kpi"><b>{num(s.manuscripts)}</b><span>manuscripts ({s.early} copied by {era(lateYear)})</span></div>
    <div class="kpi"><b>{num(s.lines - s.uncoveredLines)}</b><span>lines covered of {num(s.lines)}</span></div>
    <div class="kpi"><b>{num(s.words)}</b><span>words printed</span></div>
    <div class="kpi"><b>{num(s.places)}</b><span>places of disagreement</span></div>
    <div class="kpi"><b>{pct(s.meanWordConfidence)}</b><span>mean word confidence</span></div>
    <div class="kpi"><b>{s.meanManuscriptsPerLine}</b><span>manuscripts per line, on average</span></div>
    {s.aramaicWords !== undefined && s.aramaicWords > 0 && <div class="kpi"><b>{num(s.aramaicWords)}</b><span>words in Aramaic ({num(s.aramaicLines ?? 0)} lines)</span></div>}
    {s.translationWords !== undefined && <div class="kpi"><b>{num(s.translationWords)}</b><span>words from the Greek translation ({num(s.translationLines ?? 0)} lines)</span></div>}
  </div>
  <h2>Read</h2>
  <div class="chapters">{c.chapters.map((ch) => <a href={`/c/${id}/${ch}/`}>{ch}</a>)}</div>
  <h2>Disagreements</h2>
  <div class="kpis">
    {sev.map((k) => <a class="kpi card" href={`/c/${id}/disagreements/?severity=${k}`}><b>{num(s.bySeverity[k] ?? 0)}</b><span><span class={`pill ${k}`}>{k}</span></span></a>)}
    {Object.entries(s.byType).sort((a, b) => b[1] - a[1]).map(([k, v]) => <a class="kpi card" href={`/c/${id}/disagreements/?type=${encodeURIComponent(k)}`}><b>{num(v)}</b><span>{k}</span></a>)}
  </div>
  <p class="meta">{num(s.singularReadingsWithoutVote)} singular readings and {num(s.eyeSkipsWithoutVote)} eye-skips were set aside without a vote, as the specification says.</p>
  {early.length > 0 && (<>
    <h2>The earliest witnesses</h2>
    <div class="chips">{early.map((w) => <a class="chip early" href={`/c/${id}/inputs/#ms-${w.siglum}`} title={w.name ?? ""}>{w.siglum} · {w.century}</a>)}</div>
  </>)}
  <h2>Output files</h2>
  <p class="meta">Output: <a href={`https://github.com/openlexis/transcription/tree/main/compilations/${id}`}>compilations/{id}</a>. Hash of this output: <code>{s.sha256.slice(0, 16)}…</code></p>
</Base>
