---
import Base from "../layouts/Base.astro";
import { md, SPEC, SPEC_SHA, shortHash } from "../lib/data";
const body = SPEC.replace(/^# .*\n/, "");
---
<Base title="Specification" tab="spec" description="The one specification that every compiled transcription is produced under, in full.">
  <h1>The specification</h1>
  <p class="lede">This repository has one specification, <code>SPECIFICATION.md</code>. It states the goal and what every output must contain. It does not prescribe a method and names no model or program: whatever does the work chooses its own method, writes it into its output, and identifies itself there.</p>
  <div class="rulebox">
    <p class="meta">This file: SHA-256 <code>{shortHash(SPEC_SHA)}…</code> · <a href="https://github.com/openlexis/transcription/blob/main/SPECIFICATION.md">SPECIFICATION.md on GitHub</a> · <a href="/outputs/">the outputs produced under it</a></p>
  </div>
  <div class="rules" set:html={md(body)} />
</Base>
