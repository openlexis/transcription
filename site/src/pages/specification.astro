---
import Base from "../layouts/Base.astro";
import { md, SPEC, SPEC_ULID } from "../lib/data";
const body = SPEC.replace(/^# .*\n/, "");
---
<Base title="Specification" tab="spec" description="The one specification that every compiled transcription is produced under, in full.">
  <h1>The specification</h1>
  <p class="lede">This repository has one specification, <code>SPECIFICATION.md</code>. It states the goal and what every output must contain. It does not prescribe a statistical model: the output must use one, describe it, and name the model that made the judgments.</p>
  <div class="rulebox">
    <p>Identifier: ULID <code>{SPEC_ULID}</code> · <a href="https://github.com/openlexis/transcription/blob/main/SPECIFICATION.md">SPECIFICATION.md on GitHub</a> · <a href="/outputs/">the outputs produced under it</a></p>
    <p class="meta" style="margin-bottom:0">The manuscripts this specification uses are listed in <code>source/manuscripts.json</code>. <a href="/specification/manuscripts/">See them as a table</a>, or read the <a href="https://github.com/openlexis/transcription/blob/main/source/manuscripts.json">raw file</a>.</p>
  </div>
  <div class="rules" set:html={md(body)} />
</Base>
