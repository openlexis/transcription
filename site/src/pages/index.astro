    earlyCutoff: 100,
    earlyZoneLabel: "Dead Sea Scrolls (2nd–1st c. BC)",
    tickYears: [-300, 0, 300, 600, 900, 1200],
    eraSummaries: [
      "Dead Sea Scrolls: 1Qisaa, 1Q8, 4Q58 (c. 90 BC)",
      "Leningrad Codex (L · AD 1009)",
    ],
    discountLateInBeat3: true,
    stepScripts: [
      [
        {
          runs: [{ t: "3 manuscripts", b: true }, { t: " include the word “light” (“see light and be satisfied”)," }],
          cueTone: "lane-0",
          action: "reveal-lane-0",
          actionMs: 1700,
        },
        {
          runs: [{ t: " while " }, { t: "1", b: true }, { t: " (the medieval Leningrad Codex) omits it." }],
          cueTone: "lane-1",
          action: "reveal-lane-1",
          actionMs: 1600,
          holdMs: 2800,
        },
      ],
      [
        {
          runs: [{ t: "Sorted by date," }],
          cueTone: "accent",
          action: "timeline",
          actionMs: 2350,
        },
        {
          runs: [{ t: " those 3 manuscripts are " }, { t: "Dead Sea Scrolls (c. 90 BC)", b: true }, { t: "," }],
          cueTone: "accent",
          action: "spot-early",
          actionMs: 1650,
        },
        {
          runs: [{ t: " predating the Leningrad Codex (AD 1009) by more than a millennium." }],
          cueTone: "accent",
          action: "spot-late",
          actionMs: 1650,
          holdMs: 2800,
        },
      ],
      [
        {
          runs: [{ t: "Under the specification, this model weights three ancient scrolls over a single copy a millennium later," }],
          cueTone: "emerald",
          action: "decide",
          actionMs: 2250,
        },
        {
          runs: [{ t: " selecting “light” at " }, { t: ">99.9% original-text likelihood", b: true }, { t: "." }],
          cueTone: "emerald",
          holdMs: 850,
        },
        { action: "readings-open", actionMs: 700 },
        { action: "readings-circle", actionMs: 1600 },
        { action: "readings-note", actionMs: 6000 },
      ],
    ],
    extraNote: "All 4 surviving witnesses at Isaiah 53:11 are intact at this phrase.",
    laneLabels: ["Includes “light” (3)", "Omits “light” (1)"],
    wordGlossOverrides: {
      "וישבע": "and be satisfied",
    },
    readingGlossOverrides: ["light, and be satisfied", "be satisfied (omits “light”)"],
  }),
  buildShowcaseCase({
    id: "heb-12-28",
    bookId: "Heb",
    chIdx: 11,
    ref: "12:28",
    refLabel: "Hebrews 12:28",
    tabHook: "“Let us have” or “we have”?",
    headline: "“Let us have” or “we have” gratitude: a one-letter sound-alike where the oldest copy does not win.",
    isHebrew: false,
    focalMatch: "εχωμεν",
    wordRange: [0, 6],
    minYear: 150,
    maxYear: 1400,
    earlyCutoff: 500,
    earlyZoneLabel: "Early witnesses (AD 200–450)",
    tickYears: [200, 500, 800, 1100, 1400],
    eraSummaries: [
      "02, 04 (c. AD 450; 04 has 96.8% reliability), plus 81 (AD 1044)",
      "P46 (c. AD 213; 91.9% reliability), 01 (c. AD 350), plus 6 (AD 1250)",
    ],
    discountLateInBeat3: false,
    stepScripts: [
      [
        { runs: [{ t: "“Let us have” (εχωμεν) and “we have” (εχομεν) sounded identical and differ by a single vowel (ω vs ο). Witnesses split evenly: " }] },
        {
          runs: [{ t: "3", b: true }, { t: " write “let us have”" }],
          cueTone: "lane-0",
          action: "reveal-lane-0",
          actionMs: 1650,
        },
        { runs: [{ t: " and " }] },
        {
          runs: [{ t: "3", b: true }, { t: " write “we have.”" }],
          cueTone: "lane-1",
          action: "reveal-lane-1",
          actionMs: 1650,
          holdMs: 2800,
        },
      ],
      [
        {
          runs: [{ t: "Sorted by date," }],
          cueTone: "accent",
          action: "timeline",
          actionMs: 2350,
        },
        {
          runs: [{ t: " the two oldest copies (P46, c. AD 213 & 01, c. AD 350) read “we have,”" }],
          cueTone: "accent",
          action: "spot-early-b",
          actionMs: 1750,
        },
        {
          runs: [{ t: " while “let us have” starts later (02 & 04, c. AD 450)." }],
          cueTone: "accent",
          action: "spot-early-a",
          actionMs: 1700,
        },
        {
          runs: [{ t: " Neither headcount nor date settles a sound-alike slip." }],
          holdMs: 2900,
        },
      ],
      [
        {
          runs: [{ t: "Weighing whole-book manuscript reliability (where 04 scores higher across Hebrews than P46) alongside witness independence," }],
          cueTone: "emerald",
          action: "decide",
          actionMs: 2200,
        },
        {
          runs: [{ t: " this model selects “let us have” at " }, { t: "66.1%", b: true }, { t: " while preserving " }, { t: "33.9%", b: true }, { t: " for “we have.”" }],
          cueTone: "emerald",
          holdMs: 900,
        },
        { action: "readings-open", actionMs: 700 },
        { action: "readings-circle", actionMs: 1600 },
        { action: "readings-note", actionMs: 6000 },
      ],
    ],
    extraNote: "All 6 surviving manuscripts at Hebrews 12:28 are intact here. Specifications can also model phonetic confusion and surrounding exhortation context directly.",
    laneLabels: ["“let us have” (3)", "“we have” (3)"],
    wordGlossOverrides: {
      "διο": "therefore",
      "βασιλειαν": "a kingdom",
      "ασαλευτον": "unshakable",
      "παραλαμβανοντες": "receiving",
      "εχωμεν": "let us have",
      "εχομεν": "we have",
      "χαριν": "gratitude",
    },
    readingGlossOverrides: ["let us have", "we have"],
  }),
].filter((x): x is ShowcaseCase => x !== null);

const showcaseScriptsJson = JSON.stringify(
  showcaseCases.map<CaseStepScript>((sc) => ({
    id: sc.id,
    refLabel: sc.refLabel,
    hitRuns: sc.hitRuns,
    steps: sc.stepScripts,
  })),
);

const latestCompBase = latest ? compUrl(latest.compilationId).replace(/\/$/, "") : "/transcriptions";

const featuredBooks = [
  { id: "Gen", label: "Genesis" },
  { id: "Ps", label: "Psalms" },
  { id: "Isa", label: "Isaiah" },
  { id: "Matt", label: "Matthew" },
  { id: "Mark", label: "Mark" },
  { id: "John", label: "John" },
  { id: "Rom", label: "Romans" },
  { id: "Rev", label: "Revelation" },
];

const witnessTypes = [
  {
    key: "continuous",
    label: "Continuous-text manuscripts",
    desc: "Complete or fragmentary copies of biblical books written in normal reading order.",
    count: stats.types.continuous ?? 0,
    color: "indigo",
  },
  {
    key: "scroll",
    label: "Dead Sea Scrolls",
    desc: "Ancient parchment and papyrus scrolls discovered in the Judaean Desert (c. 3rd century BC – 1st century AD).",
    count: stats.types.scroll ?? 0,
    color: "amber",
  },
  {
    key: "lectionary",
    label: "Lectionaries",
    desc: "Church service books containing selected biblical passages arranged for liturgical readings.",
    count: stats.types.lectionary ?? 0,
    color: "emerald",
  },
  {
    key: "catena",
    label: "Catenae",
    desc: "Biblical passages preserved alongside running commentary compiled from early Christian writers.",
    count: stats.types.catena ?? 0,
    color: "violet",
  },
];

const greekCount = stats.languages.Greek ?? 0;
const hebrewCount = stats.languages.Hebrew ?? 0;
---
<Layout title="Open Lexis" active="home">
  <!-- Clean Editorial Hero + Auto-Playing Animated Evidence Carousel -->
  <section class="hero-editorial">
    <div class="container">
      <div class="hero-intro">
        <div class="home-kicker">Open Manuscript Project</div>
        <h1 class="hero-headline">
          Ancient texts, assembled <span class="hero-accent">directly from primary manuscripts</span>, word by word.
        </h1>
        <p class="hero-sub">
          The Bible survives across hundreds of ancient hand-copied manuscripts that do not always agree. Open Lexis™ applies statistical modeling directly to those primary manuscripts under published specifications, assembling the complete text word by word while keeping every witness, probability, and decision transparent.
        </p>
      </div>

      {showcaseCases.length > 0 && latest && (
        <div class="showcase-card" id="hero-showcase" data-playing="true" data-intro-loop="true">
          <div class="showcase-topbar">
            <div class="showcase-tabs" role="tablist" aria-label="Real manuscript disagreements">
              {showcaseCases.map((sc, idx) => (
                <button
                  type="button"
                  role="tab"
                  class={`showcase-tab${idx === 0 ? " active" : ""}`}
                  aria-selected={idx === 0 ? "true" : "false"}
                  data-case-tab={sc.id}
                >
                  <span class="showcase-tab-ref">{sc.refLabel}</span>
                  <span class="showcase-tab-hook">{sc.tabHook}</span>
                  <span class="showcase-tab-progress" aria-hidden="true"><span></span></span>
                </button>
              ))}
            </div>
            <button
              type="button"
              class="showcase-play-btn"
              id="showcase-play-toggle"
              aria-pressed="false"
              title="Pause or resume automatic walkthrough"
            >
              <svg class="icon-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
              <svg class="icon-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
              <span class="play-btn-label">Pause</span>
            </button>
          </div>

          {showcaseCases.map((sc, idx) => (
            <div
              class="showcase-pane"
              data-case-pane={sc.id}
              data-step="0"
              data-focus="verse"
              hidden={idx !== 0}
            >
              <div class="showcase-pane-head">
                <h2 class="showcase-title">{sc.headline}</h2>
              </div>

              <!-- Compact mobile-only reminder shown when the verse strip folds away during Steps 1-3 -->
              <button type="button" class="showcase-mini-bar showcase-verse-mini" data-expand-inspect>
                <span class="mini-bar-dot mini-dot-disputed" aria-hidden="true"></span>
                <span class="mini-bar-text">
                  <strong>{sc.refLabel}</strong> · <span class={sc.isHebrew ? "script-hebrew" : "script-greek"} dir={sc.isHebrew ? "rtl" : "ltr"}>{sc.focalWordText}</span> (“{sc.focalWordGloss}”)
                </span>
                <span class="mini-bar-action">Show verse</span>
              </button>

              <!-- Single-Line Verse Strip (full focus in Step 0; subdued on desktop / folded on mobile in Steps 1-3) -->
              <div class="showcase-verse-wrap">
                <div class="showcase-verse-inner">
                  <div class={`showcase-verse-box ${sc.isHebrew ? "verse-is-rtl" : "verse-is-ltr"}`}>
                    <div
                      class={`showcase-stage ${sc.isHebrew ? "script-hebrew" : "script-greek"}`}
                      dir={sc.isHebrew ? "rtl" : "ltr"}
                    >
                      <span class="verse-scan-puck" aria-hidden="true"></span>
                      <span class="sw-verse-num" dir="ltr" title={`Start of ${sc.refLabel}`}>{sc.verseNum}</span>
                      {sc.words.map((w, wIdx) =>
                        w.isFocal ? (
                          <a
                            href={w.href}
                            class="showcase-word showcase-word-focal"
                            data-word-idx={wIdx}
                            data-focal="true"
                            style={`--bar:${w.barWidth.toFixed(2)}`}
                            title={`Inspect “${w.text}” (${w.gloss || w.rom}) in ${sc.refLabel}`}
                          >
                            <span class="sw-status-slot" dir="ltr" aria-hidden="true">
                              <span class="sw-dot-idle"></span>
                              <span class="sw-focal-tag">Disputed</span>
                            </span>
                            <span class="sw-orig">{w.text}</span>
                            <span class="sw-gloss" dir="ltr">{w.gloss || w.rom}</span>
                          </a>
                        ) : (
                          <span
                            class="showcase-word"
                            data-word-idx={wIdx}
                          >
                            <span class="sw-status-slot" dir="ltr" aria-hidden="true">
                              <span class="sw-dot-idle"></span>
                              <span class="sw-check-mark">✓</span>
                            </span>
                            <span class="sw-orig">{w.text}</span>
                            <span class="sw-gloss" dir="ltr">{w.gloss || w.rom}</span>
                          </span>
                        ),
                      )}
                      {sc.hasTrailingEllipsis && (
                        <span class="sw-ellipsis" aria-hidden="true">…</span>
                      )}
                    </div>
                  </div>
                </div>
                <span class="showcase-prompt-cursor" aria-hidden="true">
                  <span class="prompt-cursor-ripple"></span>
                  <svg class="prompt-cursor-icon prompt-cursor-arrow" width="56" height="56" viewBox="0 0 24 24" focusable="false">
                    <path fill="#ffffff" d="M1 1.1 1 19.6 6.3 14.6 9.9 23.2 13.2 21.8 9.6 13.3 17.2 13.3Z"/>
                    <path fill="#171717" d="M2.2 2.6 2.2 16.9 6.6 12.7 10 21.1 11.8 20.3 8.4 11.9 14.8 11.9Z"/>
                  </svg>
                </span>
              </div>

              <!-- 3-Beat Animated Evidence Storyboard -->
              <div class="story-board">
                <div class="story-steps-bar" role="group" aria-label="Walkthrough steps">
                  <button type="button" class="story-step-btn" data-step-btn="1">
                    <span class="step-fill" aria-hidden="true"></span>
                    <span class="step-num">1</span>
                    <span>The disagreement</span>
                  </button>
                  <span class="step-arrow" aria-hidden="true">→</span>
                  <button type="button" class="story-step-btn" data-step-btn="2">
                    <span class="step-fill" aria-hidden="true"></span>
                    <span class="step-num">2</span>
                    <span>Across the timeline</span>
                  </button>
                  <span class="step-arrow" aria-hidden="true">→</span>
                  <button type="button" class="story-step-btn" data-step-btn="3">
                    <span class="step-fill" aria-hidden="true"></span>
                    <span class="step-num">3</span>
                    <span>The model’s decision</span>
                  </button>
                </div>

                <!-- Guided Narration Box (typed out phrase by phrase; pauses typing whenever a chart cue animates) -->
                <div class="story-caption-wrap" aria-live="polite">
                  <p class="story-caption" data-live-caption>
                    Checking <strong>{sc.refLabel}</strong> word by word across surviving manuscripts…
                  </p>
                  <noscript>
                    <p class="story-caption">{sc.fallbackSummary}</p>
                  </noscript>
                </div>

                <!-- Visual connector pointing from active summary phrase down to the chart below -->
                <div class="story-cue-bridge" aria-hidden="true">
                  <span class="cue-bridge-stem"></span>
                  <svg class="cue-bridge-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
                    <path d="M1.5 1.5L6 6.2L10.5 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>

                <!-- Collapsible Chart Stage: unfolds in Step 1; subdues on desktop / folds on mobile when Step 3 readings expand -->
                <div class="story-canvas-wrap">
                  <div class="story-canvas-inner">
                    <div class={`story-canvas canvas-${sc.canvasSize}`}>
                      <!-- Emerald focus band (fades in ONLY on Step 3 decision where early witnesses anchor the choice) -->
                      {sc.showEarlyFocus && (
                        <div
                          class="story-early-zone"
                          style={`width: ${sc.earlyZoneWidthPct}%`}
                          aria-hidden="true"
                        >
                          <span class="story-early-label">{sc.earlyZoneLabel}</span>
                        </div>
                      )}

                      <!-- Clean left-aligned reading lane headers (stay anchored on the left across all steps) -->
                      <div class="story-lane-guide lane-guide-0" aria-hidden="true">
                        <span class="lane-tag lane-tag-a">
                          <span class="lane-swatch swatch-a"></span>
                          <span>{sc.laneLabels[0]}</span>
                        </span>
                      </div>
                      <div class="story-lane-guide lane-guide-1" aria-hidden="true">
                        <span class="lane-tag lane-tag-b">
                          <span class="lane-swatch swatch-b"></span>
                          <span>{sc.laneLabels[1]}</span>
                        </span>
                      </div>

                      <!-- Every real manuscript dot, revealed lane-by-lane on Step 1 -> gliding to date in Step 2 -> weighted in Step 3 -->
                      {sc.dots.map((dot) => (
                        <span
                          class={`story-dot dot-lane-${dot.lane}${dot.early ? " dot-early" : ""}${dot.discounted ? " dot-discounted" : ""}${dot.label ? " dot-has-label" : ""}`}
                          style={`--x1:${dot.x1}%; --y1:${dot.y1}%; --x2:${dot.x2}%; --y2:${dot.y2}%; --fill-delay:${dot.fillDelayMs}ms; --q-scale:${dot.qScale}; --q-alpha:${dot.qAlpha};`}
                          title={dot.title}
                        >
                          {dot.label && (
                            <span class="dot-label">
                              <span class="dot-label-s1">{dot.label}</span>
                              <span class="dot-label-s2">{dot.labelTimeline ?? dot.label}</span>
                            </span>
                          )}
                        </span>
                      ))}

                      <!-- Historical timeline axis (fades in on Step 2 & 3) -->
                      <div class="story-axis" aria-hidden="true">
                        <div class="story-axis-line"></div>
                        {sc.ticks.map((tk) => (
                          <span class="story-tick" style={`left:${tk.pct}%`}>
                            <span>{tk.label}</span>
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Compact mobile-only toggle shown when the chart folds away during Step 3 readings spotlight -->
                <button type="button" class="showcase-mini-bar showcase-chart-mini" data-expand-inspect>
                  <span class="mini-bar-dot mini-dot-emerald" aria-hidden="true"></span>
                  <span class="mini-bar-text">
                    <strong>Witness timeline</strong> · {formatNum(sc.totalSurviving)} intact {sc.totalSurviving === 1 ? "manuscript" : "manuscripts"} weighed
                  </span>
                  <span class="mini-bar-action">Show chart</span>
                </button>

                <!-- Collapsible Readings Breakdown: folded during Steps 0-2, expands into spotlight at Step 3 finale -->
                <div class="story-readings-wrap">
                  <div class="story-readings-inner">
                    {sc.readings.length > 0 && (
                      <div class="story-readings">
                        <div class="story-rdg-header" aria-hidden="true">
                          <span>Reading</span>
                          <span>Surviving manuscripts</span>
                          <span class="col-right">This model’s likelihood</span>
                        </div>

                        {sc.readings.map((r, rIdx) => (
                          <div class={`story-rdg-row${r.chosen ? " is-chosen" : ""}`}>
                            <div class="story-rdg-word-col">
                              <span class={`lane-swatch ${rIdx === 0 ? "swatch-a" : "swatch-b"}`} aria-hidden="true"></span>
                              <span class={`story-rdg-ring-wrap${r.chosen ? " has-chosen-ring" : ""}`}>
                                <a href={sc.focalHref} class="story-rdg-word-link">
                                  <span class={`story-rdg-orig ${sc.isHebrew ? "script-hebrew" : "script-greek"}`} dir={sc.isHebrew ? "rtl" : "ltr"}>
                                    {r.text}
                                  </span>
                                  <span class="story-rdg-gloss">“{r.gloss}”</span>
                                </a>
                                {r.chosen && (
                                  <svg class="chosen-circle-svg" viewBox="0 0 220 52" preserveAspectRatio="none" aria-hidden="true">
                                    <path d="M 12,26 C 10,8 64,3 112,4 C 166,5 210,11 208,27 C 206,43 162,48 110,48 C 56,48 12,42 14,24" />
                                  </svg>
                                )}
                              </span>
                              {r.chosen && <span class="story-chosen-pill">Chosen</span>}
                            </div>

                            <div class="story-rdg-copies-col">
                              <div class="copies-primary">
                                <strong>{formatNum(r.witCount)}</strong> {r.witCount === 1 ? "manuscript" : "manuscripts"}
                                {sc.totalSurviving > 2 && (
                                  <span class="copies-share">({r.copySharePct}% of intact copies)</span>
                                )}
                              </div>
                              <div class="copies-detail">
                                {r.eraSummary}
                                {r.notableWits.length > 0 && (
                                  <span class="copies-links">
                                    {" · "}
                                    {r.notableWits.map((sig, wIdx) => (
                                      <>
                                        <a
                                          href={`/archive/?id=${encodeURIComponent(sig)}`}
                                          class="sc-wit-text"
                                          title={witTooltip(sig)}
                                        >
                                          {sig}
                                        </a>
                                        {wIdx < r.notableWits.length - 1 ? ", " : ""}
                                      </>
                                    ))}
                                  </span>
                                )}
                              </div>
                            </div>

                            <div class="story-rdg-prob-col">
                              <div class="prob-revealed-wrap">
                                <ConfidenceBadge
                                  value={r.degree}
                                  kind="reading"
                                  interval={r.uncertainty}
                                  context={r.contextForHover}
                                  showLabel={true}
                                />
                              </div>
                            </div>
                          </div>
                        ))}

                        {sc.extraNote && (
                          <div class="story-extra-note">{sc.extraNote}</div>
                        )}
                      </div>
                    )}

                    <div class="story-open-wrap">
                      <div class="story-open-inner">
                        <p class="story-open-question">
                          <strong>More than a timeline.</strong> Under a published <a href="/specifications/">specification</a>, a model can weigh many signals together: manuscript age, whole-book reliability, lineage independence, spelling and sound-alike slips, and surrounding context. Each transcription reflects how its model applied those factors across all 66 books.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Subtle, low-profile source footer -->
              <div class="showcase-footer">
                <span>
                  Computed by{" "}
                  <a href={compUrl(latest.compilationId)}>
                    {latest.manifest.compilation.title || latest.manifest.modelAttribution.modelName}
                  </a>{" "}
                  ({shortUlid(latest.compilationId)})
                </span>
                <a href={sc.focalHref} class="showcase-footer-action">
                  Open {sc.refLabel} in reader →
                </a>
              </div>
            </div>
          ))}
          <script type="application/json" id="showcase-scripts-data" set:html={showcaseScriptsJson} />
        </div>
      )}
    </div>
  </section>

  <!-- Editorial Thesis: The Gutenberg Parallel (with custom editorial SVG visuals) -->
  <section class="section gutenberg-section">
    <div class="container">
      <div class="gutenberg-intro">
        <div class="home-kicker">Why the Bible · Why Now</div>
        <h2 class="gutenberg-headline">
          What the Gutenberg press did for printing, Open Lexis™ does for recovering the text.
        </h2>
        <p class="gutenberg-lead">
          When Gutenberg built the printing press, the first major book he printed was the Bible, making exact copies possible at massive scale. Open Lexis™ brings that same leap to the words themselves: weighing hundreds of thousands of words in seconds with total consistency, so newly discovered manuscripts can be included right away instead of waiting decades for a manual revision.
        </p>
      </div>

      <div class="era-strip" aria-label="Three eras of preserving the Bible">
        <div class="era-col">
          <div class="era-visual" aria-hidden="true">
            <svg viewBox="0 0 260 108" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Three cascading hand-copied manuscripts with tiny branching drift marks -->
              <rect x="14" y="14" width="66" height="80" rx="6" fill="#fffbeb" stroke="#d97706" stroke-width="1.5"/>
