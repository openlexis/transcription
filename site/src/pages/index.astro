---
import Layout from "../layouts/Layout.astro";
import ConfidenceBadge from "../components/ConfidenceBadge.astro";
import {
  bookUrl,
  buildClientSourceIndex,
  compUrl,
  formatAuthor,
  formatEra,
  formatNum,
  formatUlidDate,
  getCompilations,
  getCompilationsForSpec,
  getCorpusStats,
  getPrimarySpec,
  getSpecifications,
  parseCompiledBookTei,
  shortUlid,
  specUrl,
  ulidTimestamp,
  withTrademark,
  type ParsedVerseToken,
} from "../lib/corpus";
import { lookupWordGloss } from "../lib/gloss";
import { transliterateText } from "../lib/transliterate";

const specs = [...getSpecifications()].sort(
  (a, b) => (ulidTimestamp(b.id) ?? 0) - (ulidTimestamp(a.id) ?? 0) || (a.id < b.id ? 1 : -1),
);
const spec = getPrimarySpec();
const stats = getCorpusStats(spec);
const compilations = getCompilations();
const latest = compilations[0];

const sourceById = new Map(
  spec.sources.map((s) => [s.id.toLowerCase(), s]),
);
const sourceMetaById = new Map(
  buildClientSourceIndex(spec).map((s) => [
    s.id.toLowerCase(),
    {
      id: s.id,
      name: s.name || s.id,
      date: s.ds || "",
    },
  ]),
);

function witTooltip(sig: string): string {
  const m = sourceMetaById.get(sig.toLowerCase());
  if (!m) return `Inspect manuscript ${sig}`;
  const parts = [m.name !== m.id ? `${m.id} (${m.name})` : m.id, m.date].filter(Boolean);
  return `${parts.join(" · ")}: click to inspect manuscript record`;
}

function witnessMidYear(sig: string, fallbackDating?: string): number | null {
  const src = sourceById.get(sig.toLowerCase());
  if (src?.yearFrom !== undefined && src?.yearTo !== undefined) {
    return Math.round((src.yearFrom + src.yearTo) / 2);
  }
  if (src?.year !== undefined) return src.year;
  if (fallbackDating) {
    const m = fallbackDating.match(/Range:\s*(-?\d+)\s+to\s+(-?\d+)/i);
    if (m) return Math.round((Number(m[1]) + Number(m[2])) / 2);
  }
  return null;
}

interface ShowcaseWord {
  text: string;
  gloss: string;
  rom: string;
  barWidth: number;
  isFocal: boolean;
  href: string;
}

interface StoryDot {
  sig: string;
  lane: 0 | 1 | 2; // 0 = chosen/reading A, 1 = variant/reading B, 2 = lacuna
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  fillDelayMs: number;
  qScale: number;
  qAlpha: number;
  relPct: number | null;
  early: boolean;
  discounted: boolean;
  label?: string;
  labelTimeline?: string;
  title: string;
}

interface TimelineTick {
  label: string;
  pct: number;
}

interface ShowcaseReading {
  text: string;
  gloss: string;
  degree: string;
  uncertainty: string;
  pctNum: number;
  witCount: number;
  copySharePct: number;
  notableWits: string[];
  chosen: boolean;
  eraSummary: string;
  contextForHover: string;
}

interface CaptionRun {
  t: string;
  b?: boolean;
}

type StoryAction =
  | "reveal-lane-0"
  | "reveal-lane-1"
  | "reveal-lane-2"
  | "timeline"
  | "spot-early"
  | "spot-late"
  | "spot-early-a"
  | "spot-early-b"
  | "spot-lacuna"
  | "decide"
  | "readings-open"
  | "readings-circle"
  | "readings-note";

interface StoryCue {
  runs?: CaptionRun[];
  cueTone?: "lane-0" | "lane-1" | "lane-2" | "accent" | "emerald";
  action?: StoryAction;
  actionMs?: number;
  holdMs?: number;
}

interface CaseStepScript {
  id: string;
  refLabel: string;
  hitRuns: CaptionRun[];
  steps: [StoryCue[], StoryCue[], StoryCue[]];
}

interface ShowcaseCase {
  id: string;
  refLabel: string;
  verseNum: string;
  langLabel: string;
  tabHook: string;
  headline: string;
  isHebrew: boolean;
  canvasSize: "dense" | "medium" | "sparse";
  totalSurviving: number;
  extraNote: string;
  laneLabels: [string, string];
  verseHref: string;
  focalHref: string;
  focalWordText: string;
  focalWordGloss: string;
  hasTrailingEllipsis: boolean;
  words: ShowcaseWord[];
  readings: ShowcaseReading[];
  dots: StoryDot[];
  ticks: TimelineTick[];
  earlyZoneWidthPct: number;
  earlyZoneLabel: string;
  showEarlyFocus: boolean;
  stepScripts: [StoryCue[], StoryCue[], StoryCue[]];
  hitRuns: CaptionRun[];
  fallbackSummary: string;
}

function buildShowcaseCase(opts: {
  id: string;
  bookId: string;
  chIdx: number;
  ref: string;
  refLabel: string;
  tabHook: string;
  headline: string;
  isHebrew: boolean;
  focalMatch: string;
  wordRange: [number, number];
  minYear: number;
  maxYear: number;
  earlyCutoff: number;
  earlyZoneLabel: string;
  tickYears: number[];
  eraSummaries: [string, string];
  discountLateInBeat3: boolean;
  stepScripts: [StoryCue[], StoryCue[], StoryCue[]];
  extraNote: string;
  laneLabels: [string, string];
  wordGlossOverrides?: Record<string, string>;
  wordGlossByIdx?: Record<number, string>;
  readingGlossOverrides?: [string, string];
}): ShowcaseCase | null {
  if (!latest) return null;
  const bookEntry = latest.manifest.books.find((b) => b.id === opts.bookId);
  if (!bookEntry) return null;
  const parsed = parseCompiledBookTei(`${latest.dir}/${bookEntry.file}`);
  const witMap = new Map(parsed.witnesses.map((w) => [w.siglum, w]));
  const verse = parsed.chapters[opts.chIdx]?.verses.find((v) => v.ref === opts.ref);
  if (!verse) return null;
  const baseBookUrl = bookUrl(latest.compilationId, opts.bookId);
  const verseId = `v-${opts.ref.replace(":", "-")}`;

  const allWords: ShowcaseWord[] = [];
  let focalTok: ParsedVerseToken | undefined;
  let focalTokIdx = 0;

  for (let tokIdx = 0; tokIdx < verse.tokens.length; tokIdx++) {
    const tok = verse.tokens[tokIdx];
    if (!tok.text) continue;
    const isFocal = tok.kind === "app" && tok.text.includes(opts.focalMatch);
    if (isFocal && !focalTok) {
      focalTok = tok;
      focalTokIdx = tokIdx;
    }

    let barWidth = 0;
    if (isFocal && tok.kind === "app") {
      const sel = (tok.readings ?? []).find((r) => r.type === "selected");
      const selP = Number(sel?.degree ?? 1);
      const conf = Number.isNaN(selP) ? 1 : selP;
      barWidth = Math.max(0.28, Math.min(1, (0.99 - conf) / (0.99 - 0.51)));
    }

    const tokHref = `${baseBookUrl}#${verseId}-w${tokIdx + 1}`;
    for (const w of tok.text.trim().split(/\s+/).filter(Boolean)) {
      const isFocalWord = isFocal && w.includes(opts.focalMatch);
      const wordIdx = allWords.length;
      allWords.push({
        text: w,
        gloss:
          opts.wordGlossByIdx?.[wordIdx] ??
          opts.wordGlossOverrides?.[w] ??
          lookupWordGloss(w, opts.isHebrew),
        rom: transliterateText(w, opts.isHebrew, "romanized"),
        barWidth: isFocalWord ? barWidth : 0,
        isFocal: isFocalWord,
        href: tokHref,
      });
    }
  }

  const words = allWords.slice(opts.wordRange[0], opts.wordRange[1]);
  const hasTrailingEllipsis = opts.wordRange[1] < allWords.length;

  const allRealReadings = (focalTok?.readings ?? []).filter(
    (r) => r.type === "selected" || r.type === "variant",
  );
  const totalIntact = allRealReadings.reduce((sum, r) => sum + r.witCount, 0);
  const topTwo = allRealReadings.slice(0, 2);

  const readings: ShowcaseReading[] = topTwo.map((r, idx) => {
    const gloss =
      opts.readingGlossOverrides?.[idx] ??
      (r.text === "(omission)"
        ? "(omitted)"
        : r.text
            .trim()
            .split(/\s+/)
            .map(
              (w) =>
                opts.wordGlossOverrides?.[w] ??
                lookupWordGloss(w, opts.isHebrew) ??
                transliterateText(w, opts.isHebrew, "romanized"),
            )
            .join(" "));
    const n = Number(r.degree ?? 0);
    const copySharePct = totalIntact > 0 ? Math.round((r.witCount / totalIntact) * 100) : 0;
    return {
      text: r.text,
      gloss,
      degree: r.degree,
      uncertainty: r.uncertainty,
      pctNum: Number.isNaN(n) ? 0 : Math.round(n * 1000) / 10,
      witCount: r.witCount,
      copySharePct,
      notableWits: r.wits.slice(0, 4),
      chosen: r.type === "selected",
      eraSummary: opts.eraSummaries[idx] ?? "",
      contextForHover: `Attested by ${formatNum(r.witCount)} of ${formatNum(totalIntact)} intact manuscripts (${copySharePct}% of copies).`,
    };
  });

  // Compute Beat 1 (raw count) & Beat 2 (real catalog date timeline) dot coordinates
  const totalMainDots = topTwo.reduce((sum, r) => sum + r.witCount, 0);
  const canvasSize: "dense" | "medium" | "sparse" =
    totalMainDots > 20 ? "dense" : totalMainDots >= 6 ? "medium" : "sparse";
  const denseDots = canvasSize === "dense";
  const isClustered = canvasSize !== "sparse";
  const yearToPct = (y: number) => {
    const clamped = Math.max(opts.minYear, Math.min(opts.maxYear, y));
    return 4 + ((clamped - opts.minYear) / Math.max(1, opts.maxYear - opts.minYear)) * 90;
  };

  const dots: StoryDot[] = [];

  topTwo.forEach((r, laneIdx) => {
    const lane = laneIdx as 0 | 1;
    const glossWord = readings[laneIdx]?.gloss || r.text;

    // Sort witnesses chronologically for clean deterministic placement
    const witEntries = r.wits.map((sig) => {
      const pw = witMap.get(sig);
      const meta = sourceMetaById.get(sig.toLowerCase());
      const mid = witnessMidYear(sig, pw?.dating) ?? opts.maxYear;
      const relMatch = pw?.agreement?.match(/Posterior reliability:\s*([0-9.]+)/i);
      const rel = relMatch ? Number(relMatch[1]) : null;
      return {
        sig,
        mid,
        rel,
        name: meta?.name && meta.name !== sig ? meta.name : "",
        dateStr: meta?.date || formatEra(mid),
      };
    });
    witEntries.sort((a, b) => a.mid - b.mid || a.sig.localeCompare(b.sig));

    // Group by century for Beat 2 beeswarm
    const byCentury = new Map<number, typeof witEntries>();
    for (const entry of witEntries) {
      const bucket = Math.floor(entry.mid / 100) * 100;
      const arr = byCentury.get(bucket) ?? [];
      arr.push(entry);
      byCentury.set(bucket, arr);
    }

    const timelinePos = new Map<string, { x2: number; y2: number }>();
    for (const [bucket, group] of byCentury) {
      if (isClustered) {
        const count = group.length;
        const maxRows = lane === 0 ? 2 : denseDots ? 6 : 3;
        const rows = Math.min(maxRows, Math.max(1, count <= 2 ? count : Math.ceil(count / (denseDots ? 6 : 2))));
        const cols = Math.ceil(count / rows);
        const yMin = lane === 0 ? 22 : count <= 2 ? 64 : 61;
        const yMax = lane === 0 ? 34 : count <= 2 ? 73 : 81;

        group.forEach((entry, idx) => {
          const col = Math.floor(idx / rows);
          const row = idx % rows;
          let yearVal = entry.mid;
          if (count > 2) {
            const frac = cols > 1 ? col / (cols - 1) : 0.5;
            yearVal = bucket + 12 + frac * 76;
          }
          const x2 = yearToPct(yearVal);
          const y2 =
            rows === 1
              ? (yMin + yMax) / 2
              : yMin + (row / (rows - 1)) * (yMax - yMin);
          timelinePos.set(entry.sig, { x2, y2 });
        });
      } else {
        const count = group.length;
        const baseY = lane === 0 ? 30 : 69;
        group.forEach((entry, idx) => {
          const x2 = yearToPct(entry.mid);
          const y2 =
            count === 1
              ? baseY
              : 23 + (idx / Math.max(1, count - 1)) * 22;
          timelinePos.set(entry.sig, { x2, y2 });
        });
      }
    }

    // Beat 1 raw count cluster placement + Step 1 cascade delay + Step 2 quality encoding
    witEntries.forEach((entry, idx) => {
      let x1: number;
      let y1: number;
      if (denseDots) {
        const cols = 39;
        const col = idx % cols;
        const row = Math.floor(idx / cols);
        x1 = 4 + col * 2.32;
        y1 = lane === 0 ? 28 : 63 + row * 6.2;
      } else if (canvasSize === "medium") {
        x1 = 8 + idx * 5.6;
        y1 = lane === 0 ? 28 : 68;
      } else {
        x1 = 10 + idx * 11;
        y1 = lane === 0 ? (witEntries.length > 1 ? 22 + idx * 9 : 28) : 68;
      }
      const tp = timelinePos.get(entry.sig) ?? { x2: yearToPct(entry.mid), y2: y1 };
      const early = entry.mid <= opts.earlyCutoff;
      const discounted = opts.discountLateInBeat3 && !early && lane === 1;
      const fillDelayMs = denseDots
        ? Math.round((idx / Math.max(1, witEntries.length - 1)) * 720)
        : canvasSize === "medium"
          ? idx * 95
          : idx * 140;
      const relNorm = entry.rel !== null ? Math.max(0, Math.min(1, (entry.rel - 0.72) / 0.25)) : 0.75;
      const qScale = Number((0.76 + relNorm * 0.42).toFixed(2));
      const qAlpha = Number((0.42 + relNorm * 0.58).toFixed(2));
      const relPct = entry.rel !== null ? Math.round(entry.rel * 100) : null;
      const shortDate = entry.dateStr.replace(/\s*±\s*\d+/, "");
      dots.push({
        sig: entry.sig,
        lane,
        x1: Number(x1.toFixed(2)),
        y1: Number(y1.toFixed(2)),
        x2: Number(tp.x2.toFixed(2)),
        y2: Number(tp.y2.toFixed(2)),
        fillDelayMs,
        qScale,
        qAlpha,
        relPct,
        early,
        discounted,
        label: isClustered ? undefined : `${entry.sig} (${shortDate})`,
        labelTimeline: isClustered
          ? undefined
          : `${entry.sig} · ${shortDate}${relPct !== null ? ` · ${relPct}% rel.` : ""}`,
        title: `${entry.sig}${entry.name ? ` · ${entry.name}` : ""} (${entry.dateStr}${relPct !== null ? `, ${relPct}% reliability` : ""}): reads ${r.text} (“${glossWord}”)`,
      });
    });
  });

  // Include notable lacunose early scroll (e.g., 4Q10 in Gen 2:2) in sparse mode
  if (!isClustered && (focalTok?.lacunaWits?.length ?? 0) > 0) {
    for (const sig of focalTok?.lacunaWits ?? []) {
      const pw = witMap.get(sig);
      const meta = sourceMetaById.get(sig.toLowerCase());
      const mid = witnessMidYear(sig, pw?.dating) ?? opts.minYear;
      dots.push({
        sig,
        lane: 2,
        x1: 58,
        y1: 48,
        x2: Number(yearToPct(mid).toFixed(2)),
        y2: 48,
        fillDelayMs: 60,
        qScale: 1,
        qAlpha: 1,
        relPct: null,
        early: mid <= opts.earlyCutoff,
        discounted: false,
        label: `${sig} (damaged here)`,
        labelTimeline: `${sig} (damaged here)`,
        title: `${sig}${meta?.name ? ` · ${meta.name}` : ""} (${meta?.date || formatEra(mid)}): physically damaged / missing this word`,
      });
    }
  }

  const ticks: TimelineTick[] = opts.tickYears.map((y) => ({
    label: formatEra(y),
    pct: Number(yearToPct(y).toFixed(2)),
  }));

  const earlyZoneWidthPct = Number(
    Math.max(12, Math.min(45, yearToPct(opts.earlyCutoff) - 2)).toFixed(2),
  );

  const focalWord = words.find((w) => w.isFocal);
  const focalWordText = focalWord?.text ?? readings[0]?.text ?? "";
  const focalWordGloss = readings[0]?.gloss ?? focalWord?.gloss ?? "";

  const hitRuns: CaptionRun[] = [
    { t: "Disagreement spotted at " },
    { t: `“${focalWordGloss}”`, b: true },
    { t: " in " },
    { t: opts.refLabel, b: true },
    { t: ": manuscripts split here." },
  ];

  const fallbackSummary = opts.stepScripts[2]
    .flatMap((c) => c.runs ?? [])
    .map((r) => r.t)
    .join("");

  return {
    id: opts.id,
    refLabel: opts.refLabel,
    verseNum: opts.ref.split(":")[1] ?? "",
    langLabel: opts.isHebrew ? "Biblical Hebrew" : "Koine Greek",
    tabHook: opts.tabHook,
    headline: opts.headline,
    isHebrew: opts.isHebrew,
    canvasSize,
    totalSurviving: totalIntact,
    extraNote: opts.extraNote,
    laneLabels: opts.laneLabels,
    verseHref: `${baseBookUrl}#${verseId}`,
    focalHref: `${baseBookUrl}#${verseId}-w${focalTokIdx + 1}`,
    focalWordText,
    focalWordGloss,
    hasTrailingEllipsis,
    words,
    readings,
    dots,
    ticks,
    earlyZoneWidthPct,
    earlyZoneLabel: opts.earlyZoneLabel,
    showEarlyFocus: opts.discountLateInBeat3,
    stepScripts: opts.stepScripts,
    hitRuns,
    fallbackSummary,
  };
}

