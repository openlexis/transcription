---
import Base from "../layouts/Base.astro";
import { compilations, SECTIONS, sectionOf, pct, num } from "../lib/data";
const list = compilations();
const tot = list.reduce((a, c) => ({ words: a.words + c.stats.words, places: a.places + c.stats.places }), { words: 0, places: 0 });
const allMs = new Set<string>();
---
<Base title="Compiled transcriptions" tab="home">
  <h1>One text, from the oldest hands</h1>
  <p class="lede">Each compilation below joins every ancient manuscript we hold in the original language into a single transcription, word by word, under one specification. Every word is cited: tap it to see which manuscripts read it and where they disagree.</p>
  <div class="kpis">
    <div class="kpi"><b>{list.length}</b><span>compilations</span></div>
    <div class="kpi"><b>{num(tot.words)}</b><span>words compiled</span></div>
    <div class="kpi"><b>{num(tot.places)}</b><span>places where manuscripts disagree</span></div>
  </div>
  {Object.entries(SECTIONS).map(([k, name]) => (
    <section>
      <h2>{name}</h2>
      <div class="grid">
        {list.filter((c) => sectionOf(c.id) === k).map((c) => {
          const s = c.stats, b = s.bySeverity, t = Math.max(1, s.places);
          return (
            <a class="card" href={`/c/${c.id}/`}>
              <h3>{s.name}</h3>
              <div class="meta">{num(s.manuscripts)} manuscripts · {num(s.words)} words</div>
              <div class="meta">{num(s.places)} disagreements · word confidence {pct(s.meanWordConfidence)}</div>
              <div class="bar" title="Disagreements by severity: high, medium, low, settled">
                <i style={`width:${(100 * (b.high ?? 0)) / t}%;background:var(--high)`}></i>
                <i style={`width:${(100 * (b.medium ?? 0)) / t}%;background:var(--medium)`}></i>
                <i style={`width:${(100 * (b.low ?? 0)) / t}%;background:var(--low)`}></i>
                <i style={`width:${(100 * (b.settled ?? 0)) / t}%;background:var(--settled)`}></i>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</Base>
