  <script>
    import { renderConfidenceBadgeHtml } from "../lib/confidence";

    // Guided video-style animated evidence showcase:
    // - Never animates the chart while the viewer is reading text
    // - Types narration phrase by phrase, pauses at each animation cue to run that exact chart action, then resumes typing
    // - Subdues finished sections on desktop (and smoothly collapses them on mobile) so the viewer never loses their spot
    interface ClientRun {
      t: string;
      b?: boolean;
    }

    type ClientAction =
      | "reveal-lane-0"
      | "reveal-lane-1"
      | "reveal-lane-2"
      | "timeline"
      | "spot-early"
      | "spot-late"
      | "spot-early-a"
      | "spot-early-b"
      | "spot-lacuna"
      | "decide"
      | "readings-open"
      | "readings-circle"
      | "readings-note";

    interface ClientCue {
      runs?: ClientRun[];
      cueTone?: "lane-0" | "lane-1" | "lane-2" | "accent" | "emerald";
      action?: ClientAction;
      actionMs?: number;
      holdMs?: number;
    }

    interface ClientCaseScript {
      id: string;
      refLabel: string;
      hitRuns: ClientRun[];
      steps: [ClientCue[], ClientCue[], ClientCue[]];
    }

    interface StepPhase {
      startMs: number;
      endMs: number;
      kind: "intro" | "type" | "action" | "hold";
      cueIdx: number;
      charStart: number;
      charEnd: number;
      action?: ClientAction;
      focus: "caption" | "chart" | "readings";
    }

    interface CompiledStep {
      cues: ClientCue[];
      phases: StepPhase[];
      actionWindows: Array<{ startMs: number; endMs: number; action: ClientAction }>;
      totalChars: number;
      totalMs: number;
    }

    interface WordSlot {
      el: HTMLSpanElement;
      text: string;
      start: number;
      end: number;
      state: "hidden" | "partial" | "shown";
      shownLen: number;
    }

    class CaptionTypewriter {
      private host: HTMLElement;
      private key = "";
      private words: WordSlot[] = [];
      private segEls = new Map<number, HTMLElement>();
      private caret: HTMLSpanElement;
      private lastRevealed = -1;
      private lastShowCaret = false;
      private lastActiveCue = -2;

      constructor(host: HTMLElement) {
        this.host = host;
        this.caret = document.createElement("span");
        this.caret.className = "type-caret";
        this.caret.setAttribute("aria-hidden", "true");
      }

      mountStatic(key: string, refLabel: string) {
        if (this.key === key) return;
        this.key = key;
        this.words = [];
        this.segEls.clear();
        this.lastRevealed = -1;
        this.lastShowCaret = false;
        this.lastActiveCue = -2;
        this.host.innerHTML = "";
        this.host.append("Checking ");
        const strong = document.createElement("strong");
        strong.textContent = refLabel;
        this.host.append(strong, " word by word across surviving manuscripts…");
      }

      mountCues(key: string, cues: ClientCue[]) {
        if (this.key === key) return;
        this.key = key;
        this.words = [];
        this.segEls.clear();
        this.lastRevealed = -1;
        this.lastShowCaret = false;
        this.lastActiveCue = -2;
        this.host.innerHTML = "";

        let offset = 0;
        cues.forEach((cue, cueIdx) => {
          const runs = cue.runs ?? [];
          if (!runs.length) return;
          const seg = document.createElement("span");
          seg.className = `cue-seg${cue.cueTone ? ` cue-tone-${cue.cueTone}` : ""}`;
          seg.dataset.cueIdx = String(cueIdx);
          this.segEls.set(cueIdx, seg);

          for (const run of runs) {
            const container: HTMLElement = run.b ? document.createElement("strong") : seg;
            const pieces = run.t.split(/(\s+)/);
            for (const piece of pieces) {
              if (!piece) continue;
              if (/^\s+$/.test(piece)) {
                container.append(document.createTextNode(piece));
                offset += piece.length;
              } else {
                const span = document.createElement("span");
                span.className = "tw tw-hidden";
                span.textContent = piece;
                container.append(span);
                this.words.push({
                  el: span,
                  text: piece,
                  start: offset,
                  end: offset + piece.length,
                  state: "hidden",
                  shownLen: 0,
                });
                offset += piece.length;
              }
            }
            if (run.b) seg.append(container);
          }

          this.host.append(seg);
        });
      }

      render(revealedChars: number, showCaret: boolean, activeCueIdx: number) {
        if (
          revealedChars === this.lastRevealed &&
          showCaret === this.lastShowCaret &&
          activeCueIdx === this.lastActiveCue
        ) {
          return;
        }
        this.lastRevealed = revealedChars;
        this.lastShowCaret = showCaret;

        if (activeCueIdx !== this.lastActiveCue) {
          this.lastActiveCue = activeCueIdx;
          this.segEls.forEach((el, idx) => {
            el.classList.toggle("cue-active", idx === activeCueIdx);
          });
        }

        if (this.caret.parentNode) this.caret.remove();
        let caretPlaced = false;
        let lastShownWord: WordSlot | null = null;

        for (const w of this.words) {
          if (revealedChars >= w.end) {
            if (w.state !== "shown") {
              w.el.classList.remove("tw-hidden");
              w.el.textContent = w.text;
              w.state = "shown";
              w.shownLen = w.text.length;
            }
            lastShownWord = w;
          } else if (revealedChars <= w.start) {
            if (w.state !== "hidden") {
              w.el.classList.add("tw-hidden");
              w.el.textContent = w.text;
              w.state = "hidden";
              w.shownLen = 0;
            }
          } else {
            const shownLen = Math.max(0, Math.min(w.text.length, revealedChars - w.start));
            w.el.classList.remove("tw-hidden");
            w.el.textContent = "";
            const shownText = w.text.slice(0, shownLen);
            const restText = w.text.slice(shownLen);
            if (shownText) w.el.append(document.createTextNode(shownText));
            if (showCaret) {
              w.el.append(this.caret);
              caretPlaced = true;
            }
            if (restText) {
              const hiddenSpan = document.createElement("span");
              hiddenSpan.className = "tw-hidden";
              hiddenSpan.textContent = restText;
              w.el.append(hiddenSpan);
            }
            w.state = "partial";
            w.shownLen = shownLen;
          }
        }

        if (showCaret && !caretPlaced) {
          if (lastShownWord && lastShownWord.el.parentNode) {
            lastShownWord.el.after(this.caret);
          } else if (this.words.length > 0 && this.words[0].el.parentNode) {
            this.words[0].el.before(this.caret);
          }
        }
      }
    }

    const showcase = document.getElementById("hero-showcase");
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-case-tab]")];
    const panes = [...document.querySelectorAll<HTMLElement>("[data-case-pane]")];
    const playToggle = document.getElementById("showcase-play-toggle") as HTMLButtonElement | null;
    const scriptsEl = document.getElementById("showcase-scripts-data");
    const caseScripts: ClientCaseScript[] = scriptsEl?.textContent
      ? JSON.parse(scriptsEl.textContent)
      : [];
    const scriptById = new Map(caseScripts.map((s) => [s.id, s]));

    const reducedMotion = Boolean(
      window.matchMedia?.("(prefers-reduced-motion: reduce)").matches,
    );

    const WORD_SCAN_MS = 680;
    const DISPUTED_PULSE_MS = 950;
    const INTRO_CURSOR_HOLD_MS = reducedMotion ? 900 : 3000;
    const CHAR_MS = reducedMotion ? 0 : 32;
    const DISPUTED_READ_HOLD_MS = 2100;
    const DRAWER_OPEN_MS = reducedMotion ? 120 : 580;
    const STEP_INTRO_PAUSE_MS = reducedMotion ? 120 : 380;

    function countRunsChars(runs: ClientRun[] | undefined): number {
      if (!runs) return 0;
      let total = 0;
      for (const r of runs) total += r.t.length;
      return total;
    }

    function compileStep(step: number, cues: ClientCue[]): CompiledStep {
      const phases: StepPhase[] = [];
      const actionWindows: Array<{ startMs: number; endMs: number; action: ClientAction }> = [];
      let cursor = 0;
      let charCursor = 0;
      let lastTextCueIdx = -1;

      const introMs = step === 1 ? DRAWER_OPEN_MS : STEP_INTRO_PAUSE_MS;
      phases.push({
        startMs: cursor,
        endMs: cursor + introMs,
        kind: "intro",
        cueIdx: -1,
        charStart: 0,
        charEnd: 0,
        focus: "caption",
      });
      cursor += introMs;

      cues.forEach((cue, cueIdx) => {
        const len = countRunsChars(cue.runs);
        const cStart = charCursor;
        const cEnd = charCursor + len;
        if (len > 0) {
          lastTextCueIdx = cueIdx;
          const typeMs = reducedMotion ? 450 : Math.max(240, len * CHAR_MS);
          phases.push({
            startMs: cursor,
            endMs: cursor + typeMs,
            kind: "type",
            cueIdx,
            charStart: cStart,
            charEnd: cEnd,
            focus: "caption",
          });
          cursor += typeMs;
          charCursor = cEnd;
        }

        if (cue.action) {
          const actionMs = reducedMotion
            ? Math.min(cue.actionMs ?? 1500, 1200)
            : cue.actionMs ?? 1600;
          const isReadings = cue.action.startsWith("readings");
          phases.push({
            startMs: cursor,
            endMs: cursor + actionMs,
            kind: "action",
            cueIdx: cue.action === "readings-note" ? -1 : isReadings ? lastTextCueIdx : cueIdx,
            charStart: charCursor,
            charEnd: charCursor,
            action: cue.action,
            focus: isReadings ? "readings" : "chart",
          });
          actionWindows.push({
            startMs: cursor,
            endMs: cursor + actionMs,
            action: cue.action,
          });
          cursor += actionMs;
        }

        if (cue.holdMs && cue.holdMs > 0) {
          const isReadings = Boolean(cue.action?.startsWith("readings"));
          phases.push({
            startMs: cursor,
            endMs: cursor + cue.holdMs,
            kind: "hold",
            cueIdx: -1,
            charStart: charCursor,
            charEnd: charCursor,
            focus: isReadings ? "readings" : "caption",
          });
          cursor += cue.holdMs;
        }
      });

      return {
        cues,
        phases,
        actionWindows,
        totalChars: charCursor,
        totalMs: cursor,
      };
    }

    const compiledByCase = new Map<string, [CompiledStep, CompiledStep, CompiledStep]>();
    caseScripts.forEach((cs) => {
      compiledByCase.set(cs.id, [
        compileStep(1, cs.steps[0]),
        compileStep(2, cs.steps[1]),
        compileStep(3, cs.steps[2]),
      ]);
    });

    const typewriters = new Map<HTMLElement, CaptionTypewriter>();
    panes.forEach((pane) => {
      const capEl = pane.querySelector<HTMLElement>("[data-live-caption]");
      if (capEl) typewriters.set(pane, new CaptionTypewriter(capEl));
    });

    function getFocalWordIndex(pane: HTMLElement | undefined): number {
      if (!pane) return 0;
      const words = [...pane.querySelectorAll<HTMLElement>(".showcase-word")];
      const idx = words.findIndex((w) => w.dataset.focal === "true");
      return idx >= 0 ? idx : 0;
    }

    function getStep0Timing(caseIdx: number) {
      const pane = panes[caseIdx];
      const caseId = pane?.dataset.casePane ?? "";
      const cs = scriptById.get(caseId);
      const focalIdx = getFocalWordIndex(pane);
      const scanEndMs = focalIdx * WORD_SCAN_MS;
      const hitPulseEndMs = scanEndMs + DISPUTED_PULSE_MS;
      const hitChars = countRunsChars(cs?.hitRuns);
      const hitTypeMs = reducedMotion ? 450 : Math.max(400, hitChars * CHAR_MS);
      const hitTypeEndMs = hitPulseEndMs + hitTypeMs;
      const totalMs = hitTypeEndMs + DISPUTED_READ_HOLD_MS;
      return { focalIdx, scanEndMs, hitPulseEndMs, hitChars, hitTypeMs, hitTypeEndMs, totalMs };
    }

    function getStepDuration(caseIdx: number, step: number): number {
      if (step === 0) return getStep0Timing(caseIdx).totalMs;
      const caseId = panes[caseIdx]?.dataset.casePane ?? "";
      return compiledByCase.get(caseId)?.[step - 1]?.totalMs ?? 10000;
    }

    function getTotalCaseMs(caseIdx: number): number {
      return (
        getStepDuration(caseIdx, 0) +
        getStepDuration(caseIdx, 1) +
        getStepDuration(caseIdx, 2) +
        getStepDuration(caseIdx, 3)
      );
    }

    let currentCaseIdx = 0;
    let currentStep = 0;
    let inspectMode = false;
    let lastScanWordIdx = -1;
    let lastPuckMode: "scan" | "disputed-pulse" | "settled" | "" = "";
    let userPaused = false;
    let holdUntil = 0;
    let readingTooltip = false;
    let showcaseInView = true;
    let showcaseVisible = true;
    let introLooping = true;
    let cachedExpandedHeight = 0;
    let cachedExpandedWidth = 0;
    let playbackGen = 0;
    let stepElapsed = 0;
    let lastTick = performance.now();

    function syncChosenCircles() {
      panes.forEach((pane) => {
        if (pane.hidden) return;
        pane.querySelectorAll<HTMLElement>(".story-rdg-ring-wrap.has-chosen-ring").forEach((wrap) => {
          const svg = wrap.querySelector<SVGSVGElement>(".chosen-circle-svg");
          const path = svg?.querySelector<SVGPathElement>("path");
          if (!svg || !path) return;
          const rw = wrap.offsetWidth;
          const rh = wrap.offsetHeight;
          if (!rw || !rh) return;

          const padX = 10;
          const padY = 6;
          const w = rw + padX * 2;
          const h = rh + padY * 2;

          svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
          svg.removeAttribute("preserveAspectRatio");

          const xL = 3;
          const xR = w - 3;
          const yT = 3;
          const yB = h - 3;
          const cx = w * 0.5;
          const cy = h * 0.5;
          const d = [
            `M ${(xL + 2).toFixed(1)},${(cy + 1).toFixed(1)}`,
            `C ${xL.toFixed(1)},${(yT + 2).toFixed(1)} ${(w * 0.24).toFixed(1)},${yT.toFixed(1)} ${cx.toFixed(1)},${(yT + 0.6).toFixed(1)}`,
            `C ${(w * 0.78).toFixed(1)},${(yT + 1.2).toFixed(1)} ${xR.toFixed(1)},${(yT + 3.5).toFixed(1)} ${(xR - 0.5).toFixed(1)},${cy.toFixed(1)}`,
            `C ${(xR - 1).toFixed(1)},${(yB - 2.5).toFixed(1)} ${(w * 0.76).toFixed(1)},${yB.toFixed(1)} ${cx.toFixed(1)},${(yB - 0.5).toFixed(1)}`,
            `C ${(w * 0.22).toFixed(1)},${(yB - 1).toFixed(1)} ${(xL + 0.5).toFixed(1)},${(yB - 3).toFixed(1)} ${(xL + 2.6).toFixed(1)},${(cy - 1.8).toFixed(1)}`,
          ].join(" ");
          path.setAttribute("d", d);

          const len = Math.ceil(path.getTotalLength()) + 6;
          path.style.setProperty("--circ-len", String(len));
        });
      });
    }

    function positionPuckOnWord(
      pane: HTMLElement,
      wordEl: HTMLElement | undefined,
      mode: "scan" | "disputed-pulse" | "settled",
      instant = false,
    ) {
      const stage = pane.querySelector<HTMLElement>(".showcase-stage");
      const puck = pane.querySelector<HTMLElement>(".verse-scan-puck");
      if (!stage || !puck || !wordEl) return;
      if (wordEl.offsetWidth === 0) return;

      if (instant) puck.classList.add("puck-instant");
      puck.style.left = `${wordEl.offsetLeft}px`;
      puck.style.top = `${wordEl.offsetTop}px`;
      puck.style.width = `${wordEl.offsetWidth}px`;
      puck.style.height = `${wordEl.offsetHeight}px`;
      puck.classList.add("puck-visible");
      puck.classList.toggle("puck-scanning", mode === "scan");
      puck.classList.toggle("puck-disputed", mode === "disputed-pulse");
      puck.classList.toggle("puck-settled", mode === "settled");
      if (instant) {
        void puck.offsetWidth;
        puck.classList.remove("puck-instant");
      }
    }

    function setFlag(pane: HTMLElement, key: string, on: boolean, val = "on") {
      if (on) {
        if (pane.dataset[key] !== val) pane.dataset[key] = val;
      } else if (pane.dataset[key] !== undefined) {
        delete pane.dataset[key];
      }
    }

    function renderCurrentFrame(instantPuck = false) {
      const pane = panes[currentCaseIdx];
      if (!pane || pane.hidden) return;
      const caseId = pane.dataset.casePane ?? "";
      const cs = scriptById.get(caseId);
      const tw = typewriters.get(pane);
      const words = [...pane.querySelectorAll<HTMLElement>(".showcase-word")];
      const focalIdx = getFocalWordIndex(pane);

      if (currentStep === 0) {
        const t0 = getStep0Timing(currentCaseIdx);
        const activeIdx = Math.min(focalIdx, Math.floor(stepElapsed / WORD_SCAN_MS));
        const hitDisputed = activeIdx >= focalIdx;
        const typingHit = !introLooping && stepElapsed >= t0.hitPulseEndMs;

        words.forEach((w, i) => {
          w.classList.toggle("word-checked", i < focalIdx && i <= activeIdx);
          w.classList.toggle("word-disputed-hit", i === focalIdx && hitDisputed);
        });

        setFlag(pane, "hit", hitDisputed, "true");
        setFlag(pane, "chartOpen", false);
        setFlag(pane, "lane0", false);
        setFlag(pane, "lane1", false);
        setFlag(pane, "lane2", false);
        setFlag(pane, "timeline", false);
        setFlag(pane, "decide", false);
        setFlag(pane, "readings", false);
        setFlag(pane, "circle", false);
        setFlag(pane, "note", false);
        setFlag(pane, "spot", false);
        setFlag(pane, "activeLane", false);
        setFlag(pane, "wordPulse", false);
        setFlag(pane, "chartPulse", false);

        const puckMode: "scan" | "disputed-pulse" | "settled" = !hitDisputed
          ? "scan"
          : typingHit
            ? "settled"
            : "disputed-pulse";

        if (instantPuck || activeIdx !== lastScanWordIdx || puckMode !== lastPuckMode) {
          lastScanWordIdx = activeIdx;
          lastPuckMode = puckMode;
          positionPuckOnWord(pane, words[activeIdx], puckMode, instantPuck);
        }

        if (inspectMode) {
          pane.dataset.focus = "inspect";
        } else {
          pane.dataset.focus = typingHit ? "caption" : "verse";
        }

        if (tw && cs) {
          if (!typingHit) {
            tw.mountStatic(`${caseId}-0-scan-${playbackGen}`, cs.refLabel);
          } else {
            tw.mountCues(`${caseId}-0-hit-${playbackGen}`, [{ runs: cs.hitRuns }]);
            const frac = Math.min(1, Math.max(0, (stepElapsed - t0.hitPulseEndMs) / Math.max(1, t0.hitTypeMs)));
            const chars = reducedMotion || inspectMode ? t0.hitChars : Math.floor(frac * t0.hitChars);
            const showCaret = !reducedMotion && !inspectMode && stepElapsed < t0.hitTypeEndMs;
            tw.render(chars, showCaret, -1);
          }
        }
        syncPromptCursor(pane, introLooping && hitDisputed);
        return;
      }

      // Steps 1, 2, 3
      syncPromptCursor(pane, false);
      words.forEach((w, i) => {
        w.classList.toggle("word-checked", i < focalIdx);
        w.classList.toggle("word-disputed-hit", i === focalIdx);
      });

      const compiled = compiledByCase.get(caseId)?.[currentStep - 1];
      if (!compiled) return;

      const t = inspectMode ? compiled.totalMs : Math.min(stepElapsed, compiled.totalMs);
      let activePhase = compiled.phases[compiled.phases.length - 1];
      for (const p of compiled.phases) {
        if (t >= p.startMs && t < p.endMs) {
          activePhase = p;
          break;
        }
      }

      const chartAction = Boolean(
        activePhase.kind === "action" && activePhase.action && !activePhase.action.startsWith("readings"),
      );
      const wordPulse = !inspectMode && !reducedMotion && t < DISPUTED_PULSE_MS;
      const chartPulse = !inspectMode && !reducedMotion && !wordPulse && chartAction;
      const puckMode: "scan" | "disputed-pulse" | "settled" = wordPulse ? "disputed-pulse" : "settled";
      if (instantPuck || lastScanWordIdx !== focalIdx || lastPuckMode !== puckMode) {
        lastScanWordIdx = focalIdx;
        lastPuckMode = puckMode;
        positionPuckOnWord(pane, words[focalIdx], puckMode, instantPuck);
      }

      // Cumulative flags from prior steps + fired actions in current step
      let lane0 = currentStep >= 2 || inspectMode;
      let lane1 = currentStep >= 2 || inspectMode;
      let lane2 = currentStep >= 2 || inspectMode;
      let timeline = currentStep >= 3 || (inspectMode && currentStep >= 2);
      let decide = inspectMode && currentStep >= 3;
      let readings = inspectMode && currentStep >= 3;
      let circle = inspectMode && currentStep >= 3;
      let note = inspectMode && currentStep >= 3;
      let spot = "";
      let activeLane = "";

      for (const aw of compiled.actionWindows) {
        const started = t >= aw.startMs;
        const activeNow = !inspectMode && t >= aw.startMs && t < aw.endMs;
        if (!started) continue;
        switch (aw.action) {
          case "reveal-lane-0":
            lane0 = true;
            if (activeNow) activeLane = "0";
            break;
          case "reveal-lane-1":
            lane1 = true;
            if (activeNow) activeLane = "1";
            break;
          case "reveal-lane-2":
            lane2 = true;
            if (activeNow) activeLane = "2";
            break;
          case "timeline":
            timeline = true;
            break;
          case "spot-early":
            if (activeNow) spot = "early";
            break;
          case "spot-late":
            if (activeNow) spot = "late";
            break;
          case "spot-early-a":
            if (activeNow) spot = "early-a";
            break;
          case "spot-early-b":
            if (activeNow) spot = "early-b";
            break;
          case "spot-lacuna":
            if (activeNow) spot = "lacuna";
            break;
          case "decide":
            decide = true;
            break;
          case "readings-open":
            readings = true;
            break;
          case "readings-circle":
            readings = true;
            circle = true;
            break;
          case "readings-note":
            readings = true;
            circle = true;
            note = true;
            break;
        }
      }

      const wasReadingsOn = pane.dataset.readings === "on";
      const wasCircleOn = pane.dataset.circle === "on";

      setFlag(pane, "hit", true, "true");
      setFlag(pane, "chartOpen", true);
      setFlag(pane, "lane0", lane0);
      setFlag(pane, "lane1", lane1);
      setFlag(pane, "lane2", lane2);
      setFlag(pane, "timeline", timeline);
      setFlag(pane, "decide", decide);
      setFlag(pane, "readings", readings);
      setFlag(pane, "note", note);
      setFlag(pane, "spot", Boolean(spot), spot);
      setFlag(pane, "activeLane", Boolean(activeLane), activeLane);
      setFlag(pane, "wordPulse", wordPulse);
      setFlag(pane, "chartPulse", chartPulse);

      if ((readings && !wasReadingsOn) || (circle && !wasCircleOn)) {
        syncChosenCircles();
        if (circle && !wasCircleOn) void pane.offsetWidth;
      }
      setFlag(pane, "circle", circle);

      pane.dataset.focus = inspectMode ? "inspect" : activePhase.focus;

      if (tw) {
        tw.mountCues(`${caseId}-s${currentStep}-${playbackGen}`, compiled.cues);
        let revealedChars = compiled.totalChars;
        let showCaret = false;
        let activeCueIdx = -1;

        if (!inspectMode) {
          if (activePhase.kind === "type") {
            const span = Math.max(1, activePhase.endMs - activePhase.startMs);
            const frac = Math.min(1, Math.max(0, (t - activePhase.startMs) / span));
            revealedChars = reducedMotion
              ? activePhase.charEnd
              : activePhase.charStart + Math.floor(frac * (activePhase.charEnd - activePhase.charStart));
            showCaret = !reducedMotion;
          } else {
            revealedChars = activePhase.charEnd;
            showCaret = false;
            if (activePhase.kind === "action" && !wordPulse) {
              activeCueIdx = activePhase.cueIdx;
            }
          }
        }
        tw.render(revealedChars, showCaret, activeCueIdx);
      }
    }

    function applyCaseAndStep(caseIdx: number, step: number, openInspect = false) {
      const caseChanged = caseIdx !== currentCaseIdx;
      currentCaseIdx = ((caseIdx % panes.length) + panes.length) % panes.length;
      currentStep = step;
      inspectMode = openInspect;
      lastScanWordIdx = -1;
      lastPuckMode = "";
      playbackGen += 1;

      stepElapsed = openInspect ? getStepDuration(currentCaseIdx, currentStep) : 0;

      tabs.forEach((t, i) => {
        const active = i === currentCaseIdx;
        t.classList.toggle("active", active);
        t.setAttribute("aria-selected", String(active));
        const fill = t.querySelector<HTMLElement>(".showcase-tab-progress > span");
        if (fill && !active) fill.style.width = "0%";
      });

      panes.forEach((p, i) => {
        const active = i === currentCaseIdx;
        p.hidden = !active;
        if (active) {
          p.dataset.step = String(currentStep);
          p.querySelectorAll<HTMLButtonElement>("[data-step-btn]").forEach((b) => {
            const s = Number(b.dataset.stepBtn);
            b.classList.toggle("active", s === currentStep);
            b.classList.toggle("done", s < currentStep);
            const sf = b.querySelector<HTMLElement>(".step-fill");
            if (sf) sf.style.width = s < currentStep || (openInspect && s === currentStep) ? "100%" : "0%";
          });
        }
      });

      renderCurrentFrame(caseChanged || currentStep === 0 || openInspect);
      requestAnimationFrame(() => {
        renderCurrentFrame(true);
        syncChosenCircles();
      });
    }

    function updateProgressBar() {
      const tab = tabs[currentCaseIdx];
      const fill = tab?.querySelector<HTMLElement>(".showcase-tab-progress > span");
      if (fill) {
        let priorMs = 0;
        for (let s = 0; s < currentStep; s++) priorMs += getStepDuration(currentCaseIdx, s);
        const total = getTotalCaseMs(currentCaseIdx);
        const pct = Math.min(100, ((priorMs + stepElapsed) / Math.max(1, total)) * 100);
        fill.style.width = `${pct.toFixed(1)}%`;
      }
      if (currentStep >= 1) {
        const pane = panes[currentCaseIdx];
        const stepBtn = pane?.querySelector<HTMLElement>(`[data-step-btn="${currentStep}"] .step-fill`);
        if (stepBtn) {
          const limit = getStepDuration(currentCaseIdx, currentStep);
          const stepPct = Math.min(100, (stepElapsed / Math.max(1, limit)) * 100);
          stepBtn.style.width = `${stepPct.toFixed(1)}%`;
        }
      }
    }

    function getIntroLoopDuration(caseIdx: number): number {
      const t0 = getStep0Timing(caseIdx);
      return t0.hitPulseEndMs + INTRO_CURSOR_HOLD_MS;
    }

    function syncPromptCursor(pane: HTMLElement, show: boolean) {
      const cursor = pane.querySelector<HTMLElement>(".showcase-prompt-cursor");
      const wrap = pane.querySelector<HTMLElement>(".showcase-verse-wrap");
      const word = pane.querySelector<HTMLElement>(".showcase-word-focal");
      const orig = word?.querySelector<HTMLElement>(".sw-orig") ?? word;
      if (!cursor) return;
      if (!show || !wrap || !orig) {
        cursor.classList.remove("is-active");
        return;
      }
      const wr = wrap.getBoundingClientRect();
      const or = orig.getBoundingClientRect();
      cursor.style.left = `${or.left - wr.left + or.width * 0.4}px`;
      cursor.style.top = `${or.top - wr.top + or.height * 0.28}px`;
      if (!cursor.classList.contains("is-active")) {
        cursor.classList.add("is-active");
      }
    }

    function syncIntroLoopAttr() {
      if (!showcase) return;
      if (introLooping) showcase.dataset.introLoop = "true";
      else delete showcase.dataset.introLoop;
    }

    function getStickyHeaderOffset(): number {
      const header = document.querySelector(".site-header") as HTMLElement | null;
      return (header?.getBoundingClientRect().height ?? 64) + 12;
    }

    function measureExpandedShowcaseHeight(): number {
      if (!showcase) return 0;
      const width = showcase.offsetWidth;
      if (cachedExpandedHeight > 0 && cachedExpandedWidth === width) {
        return cachedExpandedHeight;
      }
      const pane = panes[currentCaseIdx] ?? panes[0];
      if (!pane) return showcase.offsetHeight;

      const flagKeys = [
        "step",
        "focus",
        "hit",
        "chartOpen",
        "lane0",
        "lane1",
        "lane2",
        "timeline",
        "decide",
        "readings",
        "circle",
        "note",
        "spot",
        "activeLane",
      ] as const;
      const prevHidden = pane.hidden;
      const prev: Record<string, string | undefined> = {};
      for (const key of flagKeys) prev[key] = pane.dataset[key];

      showcase.classList.add("is-measuring");
      let height = showcase.offsetHeight;
      try {
        pane.hidden = false;
        pane.dataset.step = "3";
        pane.dataset.focus = "inspect";
        pane.dataset.hit = "true";
        pane.dataset.chartOpen = "on";
        pane.dataset.lane0 = "on";
        pane.dataset.lane1 = "on";
        pane.dataset.lane2 = "on";
        pane.dataset.timeline = "on";
        pane.dataset.decide = "on";
        pane.dataset.readings = "on";
        pane.dataset.circle = "on";
        pane.dataset.note = "on";
        height = showcase.offsetHeight;
      } finally {
        pane.hidden = prevHidden;
        for (const key of flagKeys) {
          const val = prev[key];
          if (val === undefined) delete pane.dataset[key];
          else pane.dataset[key] = val;
        }
        showcase.classList.remove("is-measuring");
      }

      cachedExpandedHeight = height;
      cachedExpandedWidth = width;
      return height;
    }

    function expandedAreaFitsInViewport(): boolean {
      if (!showcase) return false;
      const rect = showcase.getBoundingClientRect();
      const headerOffset = getStickyHeaderOffset();
      const expandedH = measureExpandedShowcaseHeight();
      if (rect.bottom <= headerOffset || rect.top >= window.innerHeight) return false;
      const topClear = rect.top >= headerOffset - 4;
      const bottomFits = rect.top + expandedH <= window.innerHeight + 4;
      return topClear && bottomFits;
    }

    function getScrollYToFitExpanded(): number | null {
      if (!showcase) return null;
      const headerOffset = getStickyHeaderOffset();
      const viewportH = window.innerHeight;
      const pageTop = showcase.getBoundingClientRect().top + window.scrollY;
      const board = showcase.querySelector(".story-board");
      // Read the storyboard position before measuring, so a temporary inspect
      // layout (and any transition it would start) cannot throw the target off.
      const boardTop = board
        ? board.getBoundingClientRect().top + window.scrollY
        : pageTop;
      const expandedH = measureExpandedShowcaseHeight();
      const available = viewportH - headerOffset;
      let targetY: number;
      const maxScroll = pageTop - headerOffset;
      const minScroll = pageTop + expandedH - viewportH;
      if (expandedH <= available) {
        if (window.scrollY <= maxScroll + 4 && window.scrollY >= minScroll - 4) {
          return null;
        }
        if (window.scrollY < minScroll) targetY = minScroll;
        else targetY = maxScroll;
      } else {
        // The expanded card is taller than the viewport. Line the storyboard up
        // under the header so the disagreement opens on screen.
        targetY = Math.max(0, boardTop - headerOffset);
        if (Math.abs(window.scrollY - targetY) <= 4) return null;
      }
      return Math.max(0, targetY);
    }

    function considerUnlockingFullPlayback() {
      if (!introLooping || userPaused) return;
      if (!expandedAreaFitsInViewport()) return;
      introLooping = false;
      lastTick = performance.now();
      applyCaseAndStep(currentCaseIdx, 0, false);
      updateProgressBar();
      syncIntroLoopAttr();
    }

    function startFullAnimationFromClick() {
      introLooping = false;
      userPaused = false;
      holdUntil = 0;
      lastTick = performance.now();
      // The disputed word is already found, so skip the opening sweep and
      // start at the disagreement. A later click restarts from the same point.
      showcase?.classList.add("is-measuring");
      applyCaseAndStep(currentCaseIdx, 1, false);
      syncIntroLoopAttr();
      syncPlayButton();
      updateProgressBar();
      // Measure with transitions off so a folding verse is already in its
      // final place before we choose a scroll target.
      const targetY = getScrollYToFitExpanded();
      showcase?.classList.remove("is-measuring");
      if (targetY != null) {
        window.scrollTo({ top: targetY, behavior: reducedMotion ? "auto" : "smooth" });
      }
    }

    function syncPlayButton() {
      if (!showcase || !playToggle) return;
      const playing = !userPaused;
      showcase.dataset.playing = String(playing);
      playToggle.setAttribute("aria-pressed", String(!playing));
      const lbl = playToggle.querySelector(".play-btn-label");
      if (lbl) lbl.textContent = playing ? "Pause" : "Resume";
    }

    function pauseByUser() {
      userPaused = true;
      holdUntil = 0;
      syncPlayButton();
    }

    function holdBriefly(ms = 10000) {
      if (userPaused) return;
      holdUntil = Math.max(holdUntil, performance.now() + ms);
    }

    if (panes.length > 0) {
      applyCaseAndStep(0, 0, false);
      syncPlayButton();
      syncIntroLoopAttr();
      requestAnimationFrame(() => {
        considerUnlockingFullPlayback();
      });

      document.fonts?.ready.then(() => {
        cachedExpandedHeight = 0;
        renderCurrentFrame(true);
        syncChosenCircles();
        considerUnlockingFullPlayback();
      });
      window.addEventListener("resize", () => {
        cachedExpandedHeight = 0;
        renderCurrentFrame(true);
        syncChosenCircles();
        considerUnlockingFullPlayback();
      });
      window.addEventListener(
        "scroll",
        () => {
          if (introLooping) considerUnlockingFullPlayback();
        },
        { passive: true },
      );

      tabs.forEach((tab, idx) => {
        tab.addEventListener("click", () => {
          holdUntil = 0;
          lastTick = performance.now();
          if (userPaused) {
            introLooping = false;
            syncIntroLoopAttr();
            applyCaseAndStep(idx, 1, true);
          } else {
            applyCaseAndStep(idx, 0, false);
          }
          updateProgressBar();
        });
      });

      panes.forEach((pane, pIdx) => {
        pane.querySelectorAll<HTMLButtonElement>("[data-step-btn]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const s = Number(btn.dataset.stepBtn || 1);
            lastTick = performance.now();
            introLooping = false;
            userPaused = false;
            holdUntil = 0;
            syncIntroLoopAttr();
            applyCaseAndStep(pIdx, s, false);
            updateProgressBar();
            syncPlayButton();
          });
        });

        // Mobile "Show verse" / "Show chart" chips expand all stages cleanly in inspect mode
        pane.querySelectorAll<HTMLButtonElement>("[data-expand-inspect]").forEach((btn) => {
          btn.addEventListener("click", () => {
            inspectMode = true;
            introLooping = false;
            syncIntroLoopAttr();
            pane.dataset.focus = "inspect";
            pauseByUser();
            renderCurrentFrame(true);
            setTimeout(() => {
              renderCurrentFrame(true);
              syncChosenCircles();
            }, 340);
          });
        });

        // Re-measure circles once the readings drawer completes its height transition
        pane.querySelector(".story-readings-wrap")?.addEventListener("transitionend", () => {
          syncChosenCircles();
        });
        pane.querySelector(".showcase-verse-wrap")?.addEventListener("transitionend", () => {
          renderCurrentFrame(true);
        });

        // Clicking inside the canvas or readings holds auto-advance calmly for inspection
        pane.querySelector(".story-canvas")?.addEventListener("click", () => holdBriefly(10000));
        pane.querySelector(".story-readings")?.addEventListener("click", () => holdBriefly(10000));

        pane.querySelectorAll<HTMLAnchorElement>(".showcase-word-focal").forEach((link) => {
          link.addEventListener("click", (e) => {
            if (e.defaultPrevented) return;
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            startFullAnimationFromClick();
          });
        });
      });

      playToggle?.addEventListener("click", () => {
        userPaused = !userPaused;
        holdUntil = 0;
        lastTick = performance.now();
        if (!userPaused && inspectMode) {
          inspectMode = false;
          const limit = getStepDuration(currentCaseIdx, currentStep);
          if (stepElapsed >= limit - 50) {
            if (currentStep < 3) {
              applyCaseAndStep(currentCaseIdx, currentStep + 1, false);
            } else {
              applyCaseAndStep(currentCaseIdx + 1, 0, false);
            }
          } else {
            renderCurrentFrame(false);
          }
        }
        syncPlayButton();
      });

      // Hold auto-advance while reading a probability hover card
      showcase?.addEventListener("pointerover", (e) => {
        if ((e.target as Element | null)?.closest(".ol-conf-wrap")) {
          readingTooltip = true;
        }
      });
      showcase?.addEventListener("pointerout", (e) => {
        const fromConf = (e.target as Element | null)?.closest(".ol-conf-wrap");
        const toConf = (e.relatedTarget as Element | null)?.closest(".ol-conf-wrap");
        if (fromConf && !toConf) {
          readingTooltip = false;
          lastTick = performance.now();
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) lastTick = performance.now();
      });

      // Pause full playback if the reader scrolls past the showcase, so collapsing never shifts the page.
      // The opening loop may keep playing while only the top of the card is on screen.
      if (showcase && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            const ratio = entry?.intersectionRatio ?? 0;
            const any = Boolean(entry?.isIntersecting) && ratio > 0;
            const visible = Boolean(entry?.isIntersecting) && ratio >= 0.15;
            const wasActive = introLooping ? showcaseVisible : showcaseInView;
            const nowActive = introLooping ? any : visible;
            if (nowActive && !wasActive) lastTick = performance.now();
            showcaseVisible = any;
            showcaseInView = visible;
            if (introLooping) considerUnlockingFullPlayback();
          },
          { threshold: [0, 0.15, 0.6, 1] },
        );
        io.observe(showcase);
      }

      function tick(now: number) {
        const dt = Math.min(120, Math.max(0, now - lastTick));
        lastTick = now;

        const isHeld = holdUntil > 0 && now < holdUntil;
        const allowedInView = introLooping ? showcaseVisible : showcaseInView;
        if (!userPaused && !readingTooltip && !isHeld && allowedInView && !document.hidden) {
          stepElapsed += dt;
          if (introLooping && currentStep === 0) {
            const limit = getIntroLoopDuration(currentCaseIdx);
            if (stepElapsed >= limit) {
              stepElapsed = 0;
              lastScanWordIdx = -1;
              lastPuckMode = "";
              renderCurrentFrame(true);
            } else {
              renderCurrentFrame(false);
            }
          } else {
            const limit = getStepDuration(currentCaseIdx, currentStep);
            if (stepElapsed >= limit) {
              if (currentStep < 3) {
                applyCaseAndStep(currentCaseIdx, currentStep + 1, false);
              } else {
                applyCaseAndStep(currentCaseIdx + 1, 0, false);
              }
            } else {
              renderCurrentFrame(false);
            }
          }
          updateProgressBar();
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // Interactive two-slider simulator: Certainty -> Uncertainty AND Unanimous -> Severity 1-5
    const confSlider = document.getElementById("demo-conf-slider") as HTMLInputElement | null;
    const sevSlider = document.getElementById("demo-sev-slider") as HTMLInputElement | null;
    const slotEl = document.getElementById("demo-conf-slot");
    const liveWord = document.getElementById("demo-live-word");
    const liveStage = document.getElementById("demo-live-stage");
    const liveStatus = document.getElementById("demo-live-status");
    const sevPill = document.getElementById("demo-sev-pill");
    const sevLabel = document.getElementById("demo-sev-label");

    const SEV_META: Record<number, { pill: string; detail: string }> = {
      0: { pill: "Unanimous", detail: "All surviving manuscripts agree" },
      1: { pill: "1/5 Minor (spelling)", detail: "Level 1 minor spelling variation" },
      2: { pill: "2/5 Small (grammar)", detail: "Level 2 small grammatical nuance" },
      3: { pill: "3/5 Moderate (omission)", detail: "Level 3 missing or added word" },
      4: { pill: "4/5 Substantial (phrase)", detail: "Level 4 substantial phrase wording shift" },
      5: { pill: "5/5 Major (meaning)", detail: "Level 5 major meaning change" },
    };

    const syncSimulators = () => {
      if (!confSlider || !sevSlider || !slotEl || !liveWord) return;
      const uncertaintyStep = Number(confSlider.value); // 0 (100% certain) -> 49 (51% uncertain)
      const pct = Math.max(51, Math.min(100, 100 - uncertaintyStep));
      const conf = pct / 100;
      const bar = Math.max(0, Math.min(1, (0.99 - conf) / (0.99 - 0.51)));
      const sev = Math.max(0, Math.min(5, Number(sevSlider.value)));
      const meta = SEV_META[sev] ?? SEV_META[5];

      slotEl.innerHTML = renderConfidenceBadgeHtml({
        value: pct >= 100 ? 0.9999 : conf,
        kind: "reading",
        integer: pct < 100,
        context: "Simulated reading likelihood in the interactive preview",
      });
      liveWord.style.setProperty("--bar", bar.toFixed(2));
      liveWord.dataset.sev = String(sev);
      if (liveStage) liveStage.dataset.sev = String(sev);
      if (sevPill) sevPill.dataset.sev = String(sev);
      if (sevLabel) sevLabel.textContent = meta.pill;
      if (liveStatus) {
        const pctLabel = pct >= 100 ? ">99.9%" : `${pct}%`;
        const uncLabel =
          pct >= 99 ? "Little uncertainty" : pct >= 85 ? "Moderate uncertainty" : "High uncertainty";
        const detail =
          sev === 0
            ? pct >= 99
              ? "Unanimous across manuscripts"
              : "No manuscripts disagree, yet thin or late survival (such as a single medieval copy) leaves uncertainty"
            : meta.detail;
        liveStatus.innerHTML = `<strong>${uncLabel} (${pctLabel} likely original)</strong> · ${detail}`;
      }
    };

    confSlider?.addEventListener("input", syncSimulators);
    sevSlider?.addEventListener("input", syncSimulators);
    syncSimulators();
  </script>
</Layout>
