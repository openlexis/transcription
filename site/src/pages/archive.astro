---
import Layout from "../layouts/Layout.astro";
import ArchiveListSidebar from "../components/ArchiveListSidebar.astro";
import "../styles/cite.css";
import "../styles/archive.css";
import {
  REPO,
  buildClientSourceIndex,
  formatNum,
  getCorpusStats,
  getLatestSpec,
  githubBlob,
  specUrl,
} from "../lib/corpus";

const spec = getLatestSpec();
const stats = getCorpusStats(spec);
const index = buildClientSourceIndex(spec);
const meta = {
  repo: REPO,
  specId: spec.id,
  copyright: spec.license?.copyright ?? "",
  licenseName: spec.license?.name ?? "",
  licenseUrl: spec.license?.url ?? "",
};
---
<Layout
  title="Archive"
  active="archive"
  description="Historical archive of primary ancient manuscripts: Dead Sea Scrolls, early Greek papyri, and medieval codices."
>
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Historical Archive</div>
      <h1>Archive</h1>
      <p class="lead">
        Search and inspect all {formatNum(stats.sourceCount)} primary ancient manuscripts ({formatNum(stats.totalXmlFiles)} XML files across {stats.provenanceCount} archival institutions), spanning 3rd-century BC Dead Sea Scrolls, early Greek papyri, and medieval codices. Click any manuscript to see its date, the transcription files each source provides, their licenses, and links to images of the pages.
      </p>
      <div class="actions">
        <a href="/transcriptions/" class="btn btn-secondary">Browse transcriptions →</a>
        <a href={specUrl(spec.id)} class="btn btn-secondary">View specification</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container">
      <div class="archive-body" data-archive-body>
        <ArchiveListSidebar>
          <div slot="filters" class="ar-filters">
            <input
              type="search"
              id="src-search"
              class="search-input"
              placeholder="Search by ID, name, shelfmark, institution, or file (e.g., 01, Sinaiticus, P46, 4Q1, Leningrad)…"
              aria-label="Search manuscripts"
            />
            <select id="src-target" class="select-input" aria-label="Filter by book">
              <option value="">All books</option>
              {spec.targets.map((t) => (
                <option value={t.id}>{t.name}</option>
              ))}
            </select>
            <select id="src-prov" class="select-input" aria-label="Filter by archival institution">
              <option value="">All institutions</option>
              {stats.provenances.map((p) => (
                <option value={p.id}>{p.name}</option>
              ))}
            </select>
            <div class="pill-group" role="group" aria-label="Filter by ancient language">
              <span class="pill-label">Language</span>
              <button type="button" class="filter-pill active" data-lang="">All</button>
              <button type="button" class="filter-pill" data-lang="Greek">Koine Greek</button>
              <button type="button" class="filter-pill" data-lang="Hebrew">Biblical Hebrew and Aramaic</button>
            </div>
            <div class="pill-group" role="group" aria-label="Filter by manuscript type">
              <span class="pill-label">Type</span>
              <button type="button" class="filter-pill active" data-type="">All</button>
              <button type="button" class="filter-pill" data-type="continuous">Continuous</button>
              <button type="button" class="filter-pill" data-type="scroll">Scroll</button>
              <button type="button" class="filter-pill" data-type="lectionary">Lectionary</button>
              <button type="button" class="filter-pill" data-type="catena">Catena</button>
            </div>
          </div>
        </ArchiveListSidebar>
        <div class="archive-main">
          <div class="results-meta">
            <span id="src-count">Showing {formatNum(index.length)} manuscripts</span>
            <button type="button" id="src-reset" class="copy-btn" hidden>Reset filters</button>
          </div>

          <div class="source-list" id="src-list"></div>

        </div>
      </div>
    </div>
  </section>

  <script id="src-data" type="application/json" set:html={JSON.stringify(index)}></script>
  <script id="src-meta" type="application/json" set:html={JSON.stringify(meta)}></script>
  <script id="src-books" type="application/json" set:html={JSON.stringify(spec.targets.map((t) => [t.id, t.name]))}></script>
  <script>
    import "../lib/cite-ui";
    import { adaptedNote, citeBoxHtml, parseLicense } from "../lib/cite";
    import { archiveIcon } from "../lib/archive-icons";
    import { msAnchor } from "../lib/archive-list-sidebar";
    import { languageCodeBadgeHtml } from "../lib/languages";
    const META = JSON.parse(document.getElementById("src-meta")?.textContent || "{}");
    const REPO = META.repo;
    const BOOKS = JSON.parse(document.getElementById("src-books")?.textContent || "[]");
    const dataEl = document.getElementById("src-data");
    const ALL = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    const listEl = document.getElementById("src-list");
    const countEl = document.getElementById("src-count");
    const resetBtn = document.getElementById("src-reset");
    const searchInput = document.getElementById("src-search");
    const targetSelect = document.getElementById("src-target");
    const provSelect = document.getElementById("src-prov");
    const langBtns = [...document.querySelectorAll("[data-lang]")];
    const typeBtns = [...document.querySelectorAll("[data-type]")];

    let state = { q: "", exactId: "", lang: "", type: "", prov: "", target: "" };
    let filtered = ALL;

    const esc = (s: unknown) =>
      String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    const blob = (f) => `${REPO}/blob/main/${f.split("/").map(encodeURIComponent).join("/")}`;
    const num = (n) => Number(n).toLocaleString("en-US");

    function adaptedValue(f) {
      const a = adaptedNote(f.ps[0] || "", f.fmt);
      return a ? esc(a) : "";
    }

    function citeHtml(s) {
      const title = s.name && s.name !== s.id ? `Archive record: ${s.name} (${s.id})` : `Archive record: ${s.id}`;
      return citeBoxHtml(
        {
          heading: "Cite this record",
          ours: {
            key: `openlexis-archive-${String(s.id).toLowerCase().replace(/[^a-z0-9]+/g, "-")}`,
            title,
            path: `/archive/?id=${encodeURIComponent(s.id)}`,
            ids: [["Specification", META.specId]],
            copyright: META.copyright,
            licenseName: META.licenseName,
            licenseUrl: META.licenseUrl,
          },
          sources: [],
          oursStyle: "short",
        },
        location.origin,
        new Date(),
      );
    }

    const TYPE_INFO = {
      continuous: ["Continuous text", "the text runs on in order, like a normal Bible"],
      scroll: ["Scroll", "the text is on a scroll"],
      lectionary: ["Lectionary", "Bible readings arranged in the order of church services through the year"],
      catena: ["Catena", "Bible text set among a chain of quotations from commentators"],
    };
    const typeInfo = (t) => TYPE_INFO[t] || [t, ""];
    const BOOK_ORDER = new Map(BOOKS.map(([id], i) => [id, i]));
    const bookName = (id) => (BOOKS.find(([b]) => b === id) || [id, id])[1];
    const byBook = (a, b) => (BOOK_ORDER.get(a) ?? 999) - (BOOK_ORDER.get(b) ?? 999);
    const plural = (n, one, many) => `${num(n)} ${n === 1 ? one : many}`;
    const hostOf = (u) => {
      try {
        return new URL(u).host;
      } catch {
        return "";
      }
    };

    function field(icon, label, hint, valueHtml) {
      return `<div class="ar-field">${archiveIcon(icon)}<div class="ar-label">${label}${hint ? `<span class="ar-hint">${hint}</span>` : ""}</div><div class="ar-value">${valueHtml}</div></div>`;
    }

    // The archive records (docs/archive-records.md): facts about the manuscript and each transcription file, each with its
    // sources, loaded from /archive/records/<id>.json when a manuscript is opened.
    const REC_PREFIX = { "etcbc-dss": "dss", aleppo: "mt", uxlc: "mt", "dt-ucph-sp": "sp", "tal-florentin-sp": "sp" };
    const recId = (s) => `${REC_PREFIX[s.fl[0]?.pid] || "ga"}-${String(s.id).toLowerCase().replace(/[^a-z0-9]/g, "")}`;
    const recCache = new Map();
    const loadRec = (id) => {
      if (!recCache.has(id)) recCache.set(id, fetch(`/archive/records/${encodeURIComponent(id)}.json`).then((r) => (r.ok ? r.json() : { t: {} })).catch(() => ({ t: {} })));
      return recCache.get(id);
    };
    function srcLinks(ss) {
      const uniq = [];
      for (const x of ss || []) if (!uniq.some((y) => y.u === x.u && y.q === x.q)) uniq.push(x);
      if (!uniq.length) return "";
      const shown = uniq.slice(0, 3).map((x, i) => `<a href="${esc(x.u)}" target="_blank" rel="noopener" title="${esc(`${x.l}: "${x.q}"`)}">source${uniq.length > 1 ? ` ${i + 1}` : ""}</a>`);
      return ` <span class="ar-src">${shown.join(" ")}${uniq.length > 3 ? ` <span>and ${uniq.length - 3} more</span>` : ""}</span>`;
    }
    const subs = (it) => (it.sub || []).map((l) => `<div class="ms-sub">${esc(l)}</div>`).join("");
    const itemHtml = (it) => `<div class="ar-rec-item">${esc(it.t)}${it.link ? ` <a href="${esc(it.link)}" target="_blank" rel="noopener">${esc(hostOf(it.link))} ↗</a>` : ""}${srcLinks(it.s)}${subs(it)}</div>`;
    const NOT_STATED = `<span class="ms-sub">Not stated</span>`;
    function recordFieldsHtml(m) {
      if (!m) return "";
      const rows = [];
      const add = (icon, label, hint, items) => { if (items.length) rows.push(field(icon, label, hint, items.map(itemHtml).join(""))); };
      add("id", "Names and numbers", "names and catalog numbers, as each source gives them", [...m.names, ...m.ids]);
      add("format", "Form and material", "", m.physical);
      add("shelfmark", "Held at", "where the manuscript or a part of it is now", m.holdings);
      add("date", "Dates stated", "when it was written, as each source states it, with how it was dated where stated", m.dates);
      add("place", "Origin", "where it was written", m.origin);
      add("history", "History", "events such as discovery, sale or transfer", m.history);
      add("camera", "Image sets", "photographs, scans or copies of the pages that a transcription can be made from", m.repro);
      return rows.length
        ? `<div class="ar-rec-head">From the manuscript record <span class="ms-sub">(each fact with its source; hover a source link to see the exact words)</span></div><div class="ar-fields">${rows.join("")}</div>`
        : `<div class="ms-sub ar-rec-none">The manuscript record has no further facts stated by a source.</div>`;
    }
    function fileRecordRows(views) {
      const row = (icon, k, v) => `<div class="ar-file-row">${archiveIcon(icon, 14)}<span class="ar-k">${k}</span><span class="ar-v">${v}</span></div>`;
      const all = (k) => views.flatMap((v) => v[k]);
      const who = [], whoSrc = [];
      for (const it of all("who")) if (!who.some((x) => x.t.toLowerCase() === it.t.toLowerCase())) { who.push(it); whoSrc.push(...it.s); }
      const others = all("others"), usual = all("usual");
      let whoHtml = who.length ? `${who.map((it) => `<span title="${esc((it.sub || []).join("; "))}">${esc(it.t)}</span>`).join(", ")}${srcLinks(whoSrc)}` : NOT_STATED;
      if (others.length) whoHtml += `<div class="ms-sub">Support: ${others.map((it) => `${esc(it.t)}${it.sub ? ` (${esc(it.sub.join(", "))})` : ""}`).join("; ")}</div>`;
      if (usual.length) whoHtml += `<div class="ms-sub">The project's usual practice: ${usual.map((it) => esc(it.t)).join("; ")}${srcLinks(usual.flatMap((it) => it.s))}</div>`;
      const list = (k) => { const items = all(k), seen = new Set(); const u = items.filter((it) => !seen.has(it.t) && seen.add(it.t)); return u.length ? u.map(itemHtml).join("") : NOT_STATED; };
      return [row("who", "Who", whoHtml), row("clock", "When", list("when")), row("camera", "Made from", list("from")), row("check", "How checked", list("checked")), row("branch", "Based on", list("based"))].join("");
    }
    async function fillRecords(det) {
      if (!det || det.dataset.recFilled) return;
      det.dataset.recFilled = "1";
      const box = det.querySelector(".ar-rec-ms");
      const data = await loadRec(box?.getAttribute("data-ms") || "");
      if (box) box.innerHTML = recordFieldsHtml(data.m);
      det.querySelectorAll(".ar-rec-file").forEach((el) => {
        const views = (el.getAttribute("data-paths") || "").split("|").map((p) => data.t[p]).filter(Boolean);
        el.innerHTML = views.length ? fileRecordRows(views) : "";
      });
    }
    listEl?.addEventListener("toggle", (e) => { const d = e.target; if (d instanceof HTMLDetailsElement && d.open && d.classList.contains("source-item")) fillRecords(d); }, true);

    function fieldsHtml(s) {
      const [typeName, typeHint] = typeInfo(s.ty);
      const greek = s.lg === "Greek";
      const rows = [];
      rows.push(
        field(
          "id",
          "Manuscript ID",
          greek ? "the Gregory-Aland number, the standard number for Greek New Testament manuscripts" : "the short code scholars use to cite it",
          `<span style="font-family: var(--font-mono); font-weight: 600;">${esc(s.id)}</span>`,
        ),
      );
      const dateLines = [
        s.dr ? `Range: ${esc(s.dr)}` : "",
        s.db ? `How it was dated: ${esc(s.db)}` : "",
        s.dsrc ? `Source: ${esc(s.dsrc)}` : "",
      ].filter(Boolean);
      rows.push(field("date", "Date", "when it was written, as estimated", `${esc(s.ds)}${dateLines.map((l) => `<div class="ms-sub">${l}</div>`).join("")}`));
      if (s.sh) {
        const m = s.sh.match(/^(.*?)\s*\(with (.*)\)\s*$/);
        rows.push(
          field(
            "shelfmark",
            "Shelfmark",
            "the library's catalogue number",
            m ? `${esc(m[1])}<div class="ms-sub">Other parts: ${esc(m[2])}</div>` : esc(s.sh),
          ),
        );
      }
      rows.push(field("language", "Language", "", esc(s.ld)));
      rows.push(field(s.ty in TYPE_INFO ? s.ty : "continuous", "Layout", "how the text is arranged", `${esc(typeName)}${typeHint ? `<div class="ms-sub">${esc(typeHint)}</div>` : ""}`));
      const images = s.vw.length
        ? `<div class="ar-links">${s.vw
            .map((v) => `<div><a href="${esc(v.url)}" target="_blank" rel="noopener">${esc(v.name)} ↗</a><div class="ms-sub">opens on ${esc(hostOf(v.url))}</div></div>`)
            .join("")}</div>`
        : `<span class="ms-sub">No online images are linked yet.</span>`;
      rows.push(field("image", "Images", "photographs of the pages (a facsimile); separate from the transcriptions below", images));
      const totals = [
        s.tb ? `<span class="badge">${plural(s.tb, "book", "books")}</span>` : "",
        s.tl ? `<span class="badge">${plural(s.tl, "line", "lines")}</span>` : "",
        s.tw ? `<span class="badge">${plural(s.tw, "word", "words")}</span>` : "",
      ].join("");
      if (totals) {
        rows.push(
          field(
            "counts",
            "Contains",
            "",
            `<span class="ar-pills">${totals}</span><div class="ms-sub">Counts are the books, lines, and words attested in at least one transcription below: a book or line counts if any portion is present, a word is a whitespace-separated token of the transcribed text, and when transcriptions differ on the same line the highest word count is used.</div>`,
          ),
        );
      }
      return `<div class="ar-fields">${rows.join("")}</div>`;
    }

    function coversText(f) {
      const bk = [...f.bk].sort(byBook);
      if (!bk.length) return "";
      return bk.map(bookName).join(", ");
    }

    function pct(n, total) {
      if (!total || n < 0) return "";
      if (n === 0) return "0%";
      if (n >= total) return "100%";
      const p = (n / total) * 100;
      if (p < 1) return p < 0.1 ? "<0.1%" : `${p.toFixed(1)}%`;
      if (p > 99) {
        const d = Math.min(99.9, Math.round(p * 10) / 10);
        return `${d}%`.replace(/\.0%$/, "%");
      }
      return `${Math.round(p)}%`;
    }

    function countPill(n, one, many, total) {
      if (!n && !total) return "";
      const p = pct(n, total);
      return `<span class="badge">${plural(n, one, many)}${p ? ` (${p})` : ""}</span>`;
    }

    function overlapHtml(s, union) {
      if (s.fl.length < 2 || !union.length) return "";
      const counts = new Map();
      s.fl.forEach((f) => new Set(f.bk).forEach((b) => counts.set(b, (counts.get(b) || 0) + 1)));
      const maxN = Math.max(...counts.values());
      if (maxN === 1) {
        return `<p>No two files cover the same book, so these files are different parts of the same manuscript.</p>`;
      }
      const groups = new Map();
      for (const [b, n] of counts) (groups.get(n) || groups.set(n, []).get(n)).push(b);
      const parts = [...groups.entries()]
        .sort((a, b) => b[0] - a[0])
        .map(([n, bs]) => {
          bs.sort(byBook);
          return bs.length <= 6 && groups.size > 1 ? `${bs.map(bookName).join(", ")} ${bs.length === 1 ? "is" : "are"} in ${n} files` : `${plural(bs.length, "book is", "books are")} in ${n} files`;
        });
      return `<p>${esc(parts.join("; "))}.</p><p>Where files overlap, they are separate transcriptions of the same pages. They are not copies of each other and can differ in places.</p>`;
    }

    function fileHtml(f, s) {
      const links = f.ps.map((p) => `<a href="${blob(p)}" target="_blank" rel="noopener"><code>${esc(p)}</code></a>`).join(" ");
      const covers = coversText(f);
      const pills = [
        f.bk.length || s.tb ? countPill(f.bk.length, "book", "books", s.tb) : "",
        f.ln || s.tl ? countPill(f.ln, "line", "lines", s.tl) : "",
        f.wd || s.tw ? countPill(f.wd, "word", "words", s.tw) : "",
      ].join("");
      const row = (icon, k, v) => `<div class="ar-file-row">${archiveIcon(icon, 14)}<span class="ar-k">${k}</span><span class="ar-v">${v}</span></div>`;
      const adapted = adaptedValue(f);
      return `
        <div class="ar-file">
          <div class="ar-file-head">${archiveIcon("provider")}<a href="${esc(f.pu)}" target="_blank" rel="noopener">${esc(f.pn)} ↗</a></div>
          <div class="ar-file-rows">
            <div class="ar-rec-file" data-paths="${esc(f.ps.join("|"))}"></div>
            ${pills ? row("books", "Contains", `<span class="ar-pills">${pills}</span>${covers ? `<div class="ms-sub">Books: ${esc(covers)}</div>` : ""}`) : ""}
            ${row("file", "File", links)}
            ${row("format", "Format", `${esc(f.fmt)}${/^TEI/.test(f.fmt) ? `<div class="ms-sub">TEI is the standard file format for scholarly texts.</div>` : ""}`)}
            ${row("link", "Original", `<a href="${esc(f.url)}" target="_blank" rel="noopener">Original source ↗</a>${hostOf(f.url) ? ` <span class="ms-sub">on ${esc(hostOf(f.url))}</span>` : ""}`)}
            ${row("license", "License", licenseInline(f))}
            ${adapted ? row("adapted", "Adapted by", adapted) : ""}
          </div>
        </div>`;
    }

    function licenseInline(f) {
      const l = parseLicense(f.lic, f.url);
      return `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.name)} ↗</a>${l.where ? ` <span class="ms-sub">· terms found in ${esc(l.where)}</span>` : ""}`;
    }

    function renderItem(s, openByDefault = false) {
      const fileCount = s.fl.reduce((n, f) => n + f.ps.length, 0);
      const union = [...new Set(s.fl.flatMap((f) => f.bk))].sort(byBook);
      const files = [...s.fl].sort((a, b) => b.bk.length - a.bk.length || byBook(a.bk[0] || "", b.bk[0] || ""));
      const shared = new Set();
      let sameName = false;
      for (const f of files) for (const p of f.ps) { const n = p.split("/").pop(); if (shared.has(n)) sameName = true; shared.add(n); }
      const [typeName, typeHint] = typeInfo(s.ty);
      const typeTip = `${typeName}${typeHint ? `: ${typeHint}` : ""}`;

      const intro = `<div class="ar-section-intro"><p>Each block is a transcription (the manuscript's text typed out) published by one institution.${sameName ? ` Files are named by the manuscript ID (${esc(s.id)}), not by book, so the same file name repeats under different institutions.` : ""}</p>${overlapHtml(s, union)}</div>`;

      return `
        <details class="source-item" id="${msAnchor(s.id)}" data-archive-id="${esc(s.id)}"${openByDefault ? " open" : ""}>
          <summary>
            <span class="ms-siglum">${esc(s.id)}</span>
            <div>
              <span style="font-weight: 600; color: var(--ink);">${esc(s.name || s.id)}</span>
              <span style="color: var(--ink-muted); font-size: 0.82rem; margin-left: 8px;">${esc(s.ds)} · ${plural(fileCount, "transcription file", "transcription files")}</span>
            </div>
            <div class="ar-sum-right">
              ${languageCodeBadgeHtml(s.lg || s.ld)}
              <span class="ar-type" role="img" title="${esc(typeTip)}" aria-label="${esc(typeTip)}">${archiveIcon(s.ty in TYPE_INFO ? s.ty : "continuous", 16)}</span>
            </div>
          </summary>
          <div class="source-detail">
            <div>
              <div class="ar-section-head">${archiveIcon("shelfmark")}Manuscript</div>
              ${fieldsHtml(s)}
              <div class="ar-rec-ms" data-ms="${esc(recId(s))}"><span class="ms-sub">Loading the manuscript record…</span></div>
            </div>
            <div>
              <div class="ar-section-head">${archiveIcon("file")}Transcriptions</div>
              ${intro}
              ${files.map((f) => fileHtml(f, s)).join("")}
            </div>
            ${citeHtml(s)}
          </div>
        </details>
      `;
    }

    function applyFilters() {
      const q = state.q.trim().toLowerCase();
      const exactId = state.exactId.trim().toLowerCase();
      filtered = ALL.filter((s) => {
        if (exactId) return s.id.toLowerCase() === exactId;
        if (state.lang && s.lg !== state.lang) return false;
        if (state.type && s.ty !== state.type) return false;
        if (state.target && !(s.tg || []).includes(state.target)) return false;
        if (state.prov && !s.fl.some((f) => f.pid === state.prov)) return false;
        if (q) {
          const hay = `${s.id} ${s.name} ${s.sh} ${s.ld} ${s.ty} ${(s.tg || []).join(" ")} ${s.fl.map((f) => `${f.pid} ${f.pn} ${f.ps.join(" ")}`).join(" ")}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
      render();
    }

    function render() {
      const autoOpen = filtered.length === 1;
      if (listEl) {
        listEl.innerHTML = filtered.length
          ? filtered.map((s) => renderItem(s, autoOpen)).join("")
          : `<div style="padding: 36px; text-align: center; color: var(--ink-muted); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">No manuscripts match the current filters.</div>`;
      }
      if (countEl) {
        countEl.textContent = filtered.length === ALL.length
          ? `Showing ${num(ALL.length)} manuscripts`
          : `Showing ${num(filtered.length)} matching manuscripts (${num(ALL.length)} total)`;
      }
      if (resetBtn) {
        resetBtn.hidden = !(state.q || state.exactId || state.lang || state.type || state.prov || state.target);
      }
      listEl?.querySelectorAll("details.source-item[open]").forEach((d) => fillRecords(d));
      window.dispatchEvent(new CustomEvent("archive-list-updated"));
    }

    // Apply URL params (?id=, ?q=, ?type=, ?language=, ?provenance=, ?target=)
    const params = new URLSearchParams(location.search);
    if (params.get("id")) {
      state.exactId = params.get("id");
      if (searchInput) searchInput.value = state.exactId;
    } else if (params.get("q") && searchInput) {
      state.q = params.get("q");
      searchInput.value = state.q;
    }
    if (params.get("target") && targetSelect) {
      state.target = params.get("target");
      targetSelect.value = state.target;
    }
    if (params.get("type")) {
      state.type = params.get("type");
      typeBtns.forEach((b) => b.classList.toggle("active", b.getAttribute("data-type") === state.type));
    }
    if (params.get("language")) {
      state.lang = params.get("language");
      langBtns.forEach((b) => b.classList.toggle("active", b.getAttribute("data-lang") === state.lang));
    }
    if (params.get("provenance") && provSelect) {
      state.prov = params.get("provenance");
      provSelect.value = state.prov;
    }

    searchInput?.addEventListener("input", () => {
      state.exactId = "";
      state.q = searchInput.value;
      applyFilters();
    });
    targetSelect?.addEventListener("change", () => {
      state.exactId = "";
      state.target = targetSelect.value;
      applyFilters();
    });
    provSelect?.addEventListener("change", () => {
      state.exactId = "";
      state.prov = provSelect.value;
      applyFilters();
    });
    langBtns.forEach((b) =>
      b.addEventListener("click", () => {
        state.exactId = "";
        langBtns.forEach((x) => x.classList.remove("active"));
        b.classList.add("active");
        state.lang = b.getAttribute("data-lang") || "";
        applyFilters();
      })
    );
    typeBtns.forEach((b) =>
      b.addEventListener("click", () => {
        state.exactId = "";
        typeBtns.forEach((x) => x.classList.remove("active"));
        b.classList.add("active");
        state.type = b.getAttribute("data-type") || "";
        applyFilters();
      })
    );
    resetBtn?.addEventListener("click", () => {
      state = { q: "", exactId: "", lang: "", type: "", prov: "", target: "" };
      if (searchInput) searchInput.value = "";
      if (targetSelect) targetSelect.value = "";
      if (provSelect) provSelect.value = "";
      langBtns.forEach((x, i) => x.classList.toggle("active", i === 0));
      typeBtns.forEach((x, i) => x.classList.toggle("active", i === 0));
      applyFilters();
    });

    window.addEventListener("archive-reveal", (e) => {
      const id = e.detail?.id;
      if (!id) return;
      if (state.exactId) {
        state.exactId = "";
        if (searchInput) searchInput.value = "";
        if (location.search) history.replaceState(null, "", location.pathname);
      }
      let idx = filtered.findIndex((s) => s.id === id);
      if (idx < 0) {
        idx = ALL.findIndex((s) => s.id === id);
        if (idx < 0) return;
        state = { q: "", exactId: "", lang: "", type: "", prov: "", target: "" };
        if (searchInput) searchInput.value = "";
        if (targetSelect) targetSelect.value = "";
        if (provSelect) provSelect.value = "";
        langBtns.forEach((x, i) => x.classList.toggle("active", i === 0));
        typeBtns.forEach((x, i) => x.classList.toggle("active", i === 0));
        applyFilters();
        idx = filtered.findIndex((s) => s.id === id);
      }
      const jump = () => {
        const el = document.getElementById(msAnchor(id));
        if (!el) return false;
        const top = el.getBoundingClientRect().top + window.scrollY - 88;
        window.scrollTo(0, Math.max(0, top));
        return Math.abs(el.getBoundingClientRect().top - 88) < 6;
      };
      const list = document.getElementById("src-list");
      let lastHeight = -1;
      let stable = 0;
      let tries = 0;
      const tick = () => {
        const h = list?.scrollHeight ?? 0;
        if (h > 0 && h === lastHeight) stable += 1;
        else {
          stable = 0;
          lastHeight = h;
        }
        tries += 1;
        if (stable >= 2 || tries > 40) {
          jump();
          return;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });

    applyFilters();
  </script>
</Layout>
