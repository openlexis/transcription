---
import "../styles/site.css";
import { base, bookUrl, chapters, defaultArtifact, type Artifact } from "../lib/data";
interface Props { title: string; description?: string; art?: Artifact; current?: string; tab?: string }
const { title, description = "The books of the Bible compiled from the ancient manuscripts in their original languages, word by word, with the evidence for every word.", current, tab } = Astro.props;
const art = Astro.props.art ?? defaultArtifact();
const books = art.manifest.books;
const cur = current ? books.find((b) => b.id === current) : undefined;
const groups = Object.entries(art.manifest.sections).map(([k, s]) => ({ name: s.name, items: books.filter((b) => b.section === k) }));
const B = base(art);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Open Lexis</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f7f3ea" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Noto+Serif+Hebrew:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="wrap top-row">
      <a class="brand" href="/"><span class="mark">Λ</span><span>Open Lexis <em>compiled transcriptions</em></span></a>
      <nav class="nav">
        <a href={`${B}/`} class={tab === "home" ? "on" : ""}>Books</a>
        <a href={`${B}/method/`} class={tab === "method" ? "on" : ""}>Method</a>
        <a href="/specification/" class={tab === "spec" ? "on" : ""}>Specification</a>
        <a href="/outputs/" class={tab === "outputs" ? "on" : ""}>Outputs</a>
        <a href={`${B}/disagreements/`} class={tab === "dis" ? "on" : ""}>Disagreements</a>
        <a href="/about/" class={tab === "about" ? "on" : ""}>About</a>
      </nav>
    </div>
  </header>
  <div class="switchbar"><div class="wrap switch-row">
      <label class="switch">
        <span class="sr">Switch book</span>
        <select id="switch" aria-label="Switch book" data-base={B}>
          <option value="">{cur ? cur.name : "Choose a book…"}</option>
          {groups.map((g) => (
            <optgroup label={g.name}>
              {g.items.map((b) => <option value={b.id} selected={b.id === current}>{b.name}</option>)}
            </optgroup>
          ))}
        </select>
      </label>
      {!art.isDefault && <a class="rules-btn" href={`${B}/`} title="You are viewing an output other than the default one">Output {art.compiler}</a>}
      {cur && (
        <nav class="subnav" aria-label="This book">
          <a href={bookUrl(art, cur.id)} class={tab === "overview" ? "on" : ""}>Overview</a>
          <a href={bookUrl(art, cur.id, `${chapters(art, cur.id)[0]}/`)} class={tab === "read" ? "on" : ""}>Read</a>
          <a href={bookUrl(art, cur.id, "disagreements/")} class={tab === "cdis" ? "on" : ""}>Disagreements</a>
          <a href={bookUrl(art, cur.id, "inputs/")} class={tab === "inputs" ? "on" : ""}>Manuscripts</a>
        </nav>
      )}
    </div></div>
  <main class="wrap"><slot /></main>
  <footer class="foot wrap">
    <p>Built only from ancient manuscripts in the original languages. No printed edition, translation or image is used. Page images stay with their holders; we link to them.</p>
    <p><a href="https://github.com/openlexis/transcription">Source and data on GitHub</a></p>
  </footer>
  <script>
    const s = document.getElementById("switch") as HTMLSelectElement | null;
    s?.addEventListener("change", () => {
      if (!s.value) return;
      const m = location.pathname.match(/\/c\/[^/]+\/(inputs|disagreements)\//);
      location.href = `${s.dataset.base}/c/${s.value}/${m ? m[1] + "/" : ""}`;
    });
  </script>
</body>
</html>
