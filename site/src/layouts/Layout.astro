---
import "../styles/site.css";
import { REPO } from "../lib/corpus";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "transcriptions" | "archive" | "specs";
}

const {
  title,
  description = "Open-source transcriptions assembled directly from primary ancient manuscripts, word by word, with immutable specifications, statistical probabilities, and full auditability.",
  active,
} = Astro.props;
const pageTitle = title === "Open Lexis" ? "Open Lexis · Transcriptions Assembled from Ancient Manuscripts" : `${title} · Open Lexis`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Open Lexis" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gentium+Plus:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Serif+Hebrew:wght@400;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 5.5C4.8 4.8 8.4 5.3 12 7.5c3.6-2.2 7.2-2.7 10-2v13c-2.8-.7-6.4-.2-10 2-3.6-2.2-7.2-2.7-10-2v-13z"/>
            <path d="M12 7.5v13"/>
          </svg>
        </span>
        <span>Open Lexis <span class="brand-sub">Transcriptions</span></span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href="/" class={active === "home" ? "active" : ""}>Overview</a>
        <a href="/transcriptions/" class={active === "transcriptions" ? "active" : ""}>Transcriptions</a>
        <a href="/archive/" class={active === "archive" ? "active" : ""}>Archive</a>
        <a href="/specifications/" class={active === "specs" ? "active" : ""}>Specifications</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <strong style="color: var(--ink);">Open Lexis</strong> · Open-Source Manuscript Reconstruction
        <div style="margin-top: 4px;">
          Assembling ancient texts word by word from immutable primary manuscripts.
        </div>
      </div>
      <div class="footer-links">
        <a href="/transcriptions/">Transcriptions</a>
        <a href="/archive/">Archive</a>
        <a href="/specifications/">Specifications</a>
        <a href={REPO} target="_blank" rel="noopener">Repository ↗</a>
      </div>
    </div>
  </footer>
  <script is:inline>
    (function () {
      function positionConfCard(wrap) {
        var card = wrap.querySelector(".ol-conf-card");
        if (!card) return;
        wrap.classList.remove("ol-conf-below");
        card.style.setProperty("--conf-shift-x", "0px");
        var rect = card.getBoundingClientRect();
        var margin = 12;
        if (rect.top < 72) {
          wrap.classList.add("ol-conf-below");
        }
        rect = card.getBoundingClientRect();
        var shift = 0;
        if (rect.left < margin) {
          shift = margin - rect.left;
        } else if (rect.right > window.innerWidth - margin) {
          shift = window.innerWidth - margin - rect.right;
        }
        if (shift !== 0) {
          card.style.setProperty("--conf-shift-x", Math.round(shift) + "px");
        }
      }
      document.addEventListener("pointerenter", function (e) {
        var t = e.target;
        if (!(t instanceof Element)) return;
        var wrap = t.closest(".ol-conf-wrap");
        if (wrap) positionConfCard(wrap);
      }, true);
      document.addEventListener("focusin", function (e) {
        var t = e.target;
        if (!(t instanceof Element)) return;
        var wrap = t.closest(".ol-conf-wrap");
        if (wrap) positionConfCard(wrap);
      });
    })();
  </script>
</body>
</html>
